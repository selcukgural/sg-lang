{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SG",
  "scopeName": "source.sg",
  "fileTypes": [
    "sg"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#char"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.sg",
      "match": "//.*$"
    },
    "escape": {
      "name": "constant.character.escape.sg",
      "match": "\\\\(?:[ntr0\\\\\"']|u\\{[0-9A-Fa-f]{1,6}\\})"
    },
    "hole": {
      "comment": "A value inside `$\"...\"`, with an optional format after a colon: `{n:x8}`.",
      "begin": "\\{(?!\\{)",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.sg"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.sg"
        }
      },
      "contentName": "meta.embedded.expression.sg",
      "patterns": [
        {
          "match": ":[A-Za-z][0-9]*(?=\\})",
          "name": "constant.other.format-spec.sg"
        },
        {
          "include": "$self"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.interpolated.sg",
          "begin": "\\$\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "match": "\\{\\{|\\}\\}",
              "name": "constant.character.escape.sg"
            },
            {
              "include": "#hole"
            }
          ]
        },
        {
          "name": "string.quoted.triple.sg",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.interpolated.sg",
          "begin": "\\$\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "match": "\\{\\{|\\}\\}",
              "name": "constant.character.escape.sg"
            },
            {
              "include": "#hole"
            }
          ]
        },
        {
          "name": "string.quoted.double.sg",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.sg",
      "match": "'(?:\\\\(?:[ntr0\\\\\"']|u\\{[0-9A-Fa-f]{1,6}\\})|[^'\\\\])'",
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sg",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.sg",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.sg",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.sg",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sg",
          "match": "\\b(?:if|else|while|for|in|return|break|continue|match|try|await|lock|when|with|is|not|or|as|unsafe)\\b"
        },
        {
          "name": "storage.type.sg",
          "match": "\\b(?:var|const|static|struct|enum|union|using|use|extern|export|async|test|assert|interface|embed|packed|align)\\b"
        },
        {
          "name": "storage.modifier.sg",
          "match": "\\b(?:public|readonly|read|ref|shared|weak|checked|locked|atomic|raw|share|new)\\b"
        },
        {
          "name": "constant.language.sg",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.language.this.sg",
          "match": "\\bthis\\b"
        },
        {
          "name": "storage.type.primitive.sg",
          "match": "\\b(?:void|bool|char|string|sbyte|byte|short|ushort|int|uint|long|ulong|nint|nuint|float|double)\\b"
        }
      ]
    },
    "types": {
      "comment": "Types, variants and consts are written in PascalCase.",
      "name": "entity.name.type.sg",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "functions": {
      "name": "entity.name.function.sg",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sg",
          "match": "=>"
        },
        {
          "name": "keyword.operator.null.sg",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.ternary.sg",
          "match": "(?<=\\s)[?:](?=\\s)"
        },
        {
          "name": "keyword.operator.range.sg",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.logical.sg",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.comparison.sg",
          "match": "==|!=|<=|>=|<(?![<=])|>(?![>=])"
        },
        {
          "name": "keyword.operator.assignment.sg",
          "match": "(?:<<|>>|[-+*/%&|^])?="
        },
        {
          "name": "keyword.operator.sg",
          "match": "<<|>>|[-+*/%&|^~]"
        }
      ]
    }
  }
}