// zlib behind a safe interface: the functions of C stay inside this module, and the code that
// uses it writes no `unsafe`. Each call compresses or decompresses a whole buffer at once.

extern "z" {
    nuint compressBound(nuint sourceLen)
    int compress2(raw byte dest, ref nuint destLen, raw byte source, nuint sourceLen, int level)
    int uncompress(raw byte dest, ref nuint destLen, raw byte source, nuint sourceLen)
    ulong crc32(ulong crc, raw byte buf, uint len)
}

// What zlib says went wrong.
public enum ZlibError : Formattable, Equatable {
    NoMemory          // Z_MEM_ERROR
    BufferTooSmall    // Z_BUF_ERROR: the data is longer than it was said to be
    BadData           // Z_DATA_ERROR: not what zlib makes
    TooLarge          // more bytes than zlib counts in one call
    BadLevel          // a level of compression outside 0 to 9
}

ZlibError errorOf(int code) {
    return match code {
        -4 => ZlibError.NoMemory
        -5 => ZlibError.BufferTooSmall
        _ => ZlibError.BadData
    }
}

List<byte> zeros(nint count) {
    var list = List<byte>()
    for _ in 0..count {
        list.add(0)
    }
    return list
}

// Compresses at level 6, zlib's own default.
public Result<List<byte>, ZlibError> compress(read byte[] data) {
    if data.length() > (nint)uint.MaxValue {
        return Error(ZlibError.TooLarge)
    }
    nuint room = unsafe compressBound((nuint)data.length())
    var packed = zeros((nint)room)
    var code = unsafe compress2(packed.pointer(), ref room, data.pointer(), (nuint)data.length(), 6)
    if code != 0 {
        return Error(errorOf(code))
    }
    var result = List<byte>()
    result.addAll(packed[..(nint)room])
    return Ok(result)
}

// Decompresses what `compress` made, which was `size` bytes long.
public Result<List<byte>, ZlibError> decompress(read byte[] packed, nint size) {
    if packed.length() > (nint)uint.MaxValue || size > (nint)uint.MaxValue {
        return Error(ZlibError.TooLarge)
    }
    var data = zeros(size)
    nuint length = (nuint)size
    var code = unsafe uncompress(data.pointer(), ref length, packed.pointer(), (nuint)packed.length())
    if code != 0 {
        return Error(errorOf(code))
    }
    var result = List<byte>()
    result.addAll(data[..(nint)length])
    return Ok(result)
}

// The CRC-32 of the bytes, as zlib, gzip and PNG compute it.
public uint checksum(read byte[] data) {
    ulong crc = 0
    nint at = 0
    while at < data.length() {
        var piece = data[at..(at + 1 << 30).min(data.length())]
        crc = unsafe crc32(crc, piece.pointer(), (uint)piece.length())
        at += piece.length()
    }
    return (uint)crc
}
