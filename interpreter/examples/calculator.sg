// The calculator from the examples: lexer, parser and evaluator pass errors up with
// `try`, and `main` ends with the error it could not handle.
enum Token {
    Number(int value)
    Name(string text)                    // a copy; borrowing from the input waits for `from`
    Plus
    Minus
    Star
    Slash
    LeftParen
    RightParen
    End
}

enum SyntaxError : Formattable {
    BadCharacter(int position)
    NumberTooLarge(int position)
    Unexpected(int position)
}

bool isDigit(byte c) {
    return c >= '0' && c <= '9'
}

bool isLetter(byte c) {
    return c >= 'a' && c <= 'z'
}

struct Lexer {
    string input
    int pos

    Lexer create(read string input) {
        return Lexer { input = input.clone(), pos = 0 }
    }

    Result<Token, SyntaxError> next(ref this) {
        this.skipSpaces()
        if this.pos >= this.input.length() {
            return Ok(Token.End)
        }

        int start = this.pos
        byte c = this.input[start]

        if isDigit(c) {
            return this.number(start)
        }
        if isLetter(c) {
            return Ok(this.name(start))
        }

        this.pos += 1
        return match c {
            '+' => Ok(Token.Plus)
            '-' => Ok(Token.Minus)
            '*' => Ok(Token.Star)
            '/' => Ok(Token.Slash)
            '(' => Ok(Token.LeftParen)
            ')' => Ok(Token.RightParen)
            _ => Error(SyntaxError.BadCharacter(start))
        }
    }

    void skipSpaces(ref this) {
        while this.pos < this.input.length() && this.input[this.pos] == ' ' {
            this.pos += 1
        }
    }

    Result<Token, SyntaxError> number(ref this, int start) {
        int value = 0
        while this.pos < this.input.length() && isDigit(this.input[this.pos]) {
            int digit = this.input[this.pos] - '0'
            value = value.tryMultiply(10) ?? return Error(SyntaxError.NumberTooLarge(start))
            value = value.tryAdd(digit) ?? return Error(SyntaxError.NumberTooLarge(start))
            this.pos += 1
        }
        return Ok(Token.Number(value))
    }

    Token name(ref this, int start) {
        while this.pos < this.input.length() && isLetter(this.input[this.pos]) {
            this.pos += 1
        }
        return Token.Name(this.input[start..this.pos].clone())
    }
}

enum Operator : Copyable {
    Add
    Subtract
    Multiply
    Divide
}

enum Expr {
    Number(int value)
    Variable(string name)
    Negate(Expr* operand)
    Binary(Operator op, Expr* left, Expr* right)
}

struct Parser {
    Lexer lexer
    Token current
    int start                            // where the current token begins

    Result<Parser, SyntaxError> create(read string input) {
        var lexer = Lexer(input)
        var first = try lexer.next()
        return Ok(Parser { lexer = lexer, current = first, start = 0 })
    }

    // Gives the current token and reads the next one.
    Result<Token, SyntaxError> advance(ref this) {
        this.start = this.lexer.pos
        var next = try this.lexer.next()
        return Ok(this.current.replace(next))
    }

    Result<Expr*, SyntaxError> expression(ref this) {
        var left = try this.term()
        while true {
            Operator op = match read this.current {
                Plus => Operator.Add
                Minus => Operator.Subtract
                _ => return Ok(left)
            }
            try this.advance()
            var right = try this.term()
            left = new Expr.Binary(op, left, right)
        }
    }

    Result<Expr*, SyntaxError> term(ref this) {
        var left = try this.factor()
        while true {
            Operator op = match read this.current {
                Star => Operator.Multiply
                Slash => Operator.Divide
                _ => return Ok(left)
            }
            try this.advance()
            var right = try this.factor()
            left = new Expr.Binary(op, left, right)
        }
    }

    Result<Expr*, SyntaxError> factor(ref this) {
        int position = this.start
        return match try this.advance() {
            Number(v) => Ok(new Expr.Number(v))
            Name(text) => Ok(new Expr.Variable(text))
            Minus => Ok(new Expr.Negate(try this.factor()))
            LeftParen => {
                var inner = try this.expression()
                if this.current is not RightParen {
                    return Error(SyntaxError.Unexpected(this.start))
                }
                try this.advance()
                Ok(inner)
            }
            _ => Error(SyntaxError.Unexpected(position))
        }
    }
}

Result<Expr*, SyntaxError> parse(read string input) {
    var parser = try Parser(input)
    var tree = try parser.expression()
    if parser.current is not End {
        return Error(SyntaxError.Unexpected(parser.start))
    }
    return Ok(tree)
}

enum EvalError : Formattable {
    UnknownName(string name)             // owned: the error can outlive the tree
    DivideByZero
    Overflow
}

struct Binding {
    string name
    int value
    Binding*? next
}

int? find(read Binding*? vars, read string name) {
    var cur = vars
    while cur is not null {
        if cur.name == name {
            return cur.value
        }
        cur = read cur.next
    }
    return null
}

Result<int, EvalError> apply(Operator op, int a, int b) {
    return match op {
        Add => Ok(a.tryAdd(b) ?? return Error(EvalError.Overflow))
        Subtract => Ok(a.trySubtract(b) ?? return Error(EvalError.Overflow))
        Multiply => Ok(a.tryMultiply(b) ?? return Error(EvalError.Overflow))
        Divide when b == 0 => Error(EvalError.DivideByZero)
        Divide => Ok(a.tryDivide(b) ?? return Error(EvalError.Overflow))
    }
}

Result<int, EvalError> eval(read Expr e, read Binding*? vars) {
    return match e {                     // e is read, so the names in the arms are read too
        Number(v) => Ok(v)
        Variable(name) => Ok(find(vars, name) ?? return Error(EvalError.UnknownName(name.clone())))
        Negate(operand) => Ok(0.trySubtract(try eval(operand, vars)) ?? return Error(EvalError.Overflow))
        Binary(op, left, right) => {
            var a = try eval(left, vars)
            var b = try eval(right, vars)
            apply(op, a, b)
        }
    }
}

enum AppError : Formattable {
    Syntax(SyntaxError cause)
    Eval(EvalError cause)
}

Result<int, AppError> run(read string source, read Binding*? vars) {
    var tree = try parse(source)         // SyntaxError becomes AppError.Syntax
    return Ok(try eval(read tree, vars)) // EvalError becomes AppError.Eval
}

Result<void, AppError> main() {
    var vars = new Binding { name = "x", value = 10, next = null }

    print(try run("1 + 2 * (x - 4)", read vars))
    print(try run("-x * -(3 + 4) / 2", read vars))
    print(run("x * (1 / 0)", read vars) ?? -1)

    match run("x * (7 ) 4)", read vars) {
        Ok(value) => print(value)
        Error(_) => print("that one does not parse")
    }
    match run("2 $ 3", read vars) {
        Ok(value) => print(value)
        Error(_) => print("that one has a character the calculator does not know")
    }

    print(try run("99999999999", read vars))
    return Ok()
}                                        // on an error it is printed, exit code 1
