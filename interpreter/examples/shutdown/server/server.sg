// An echo server that ends cleanly on a signal, as a server is asked to by Ctrl-C or by `kill`:
// the first signal stops it taking connections, and it waits for those that are open to end; a
// second cuts them. Nothing is lost halfway: what was received is sent back, the listener and
// every connection are closed, and `serve` gives how many connections it served.

// A line of what the server does, written out at once: whoever watches it (a terminal, a test, a
// log) sees the line when it happens, even through a pipe.
public void say(string line) {
    print(line)
    _ = Stdout.flush()
}

// Echoes what comes until the client closes its end, or until `cut` is cancelled.
async Result<void, IoError> echo(TcpStream conn, CancellationToken cut) {
    var buffer = byte[1024](0)
    while true {
        var n = try await conn.receiveAsync(ref buffer, read cut)
        if n == 0 {
            return Ok()
        }
        try await conn.sendAsync(buffer[0..n], read cut)
    }
}

// Waits for the signals: the first cancels `stop`, the second `cut`. It ends early when `done`
// is cancelled, which `serve` does once it has nothing more to wait for.
async void watch(SignalListener signals, CancellationSource stop, CancellationSource cut, CancellationToken done) {
    if await signals.nextAsync(read done) is Ok(first) {
        say($"{first}: no new connections, waiting for the open ones".toString())
        stop.cancel()
        if await signals.nextAsync(read done) is Ok(second) {
            say($"{second} again: cutting the open connections".toString())
            cut.cancel()
        }
    }
}

// Serves until a signal of `signals` comes, then as the top of this file says; gives how many
// connections it served. An error of a connection ends that connection alone, and is printed.
public async Result<int, IoError> serve(TcpListener listener, SignalListener signals) {
    var stop = CancellationSource()
    var cut = CancellationSource()
    var done = CancellationSource()
    var accepting = stop.token()
    var cutting = cut.token()
    var watching = watch(signals, stop, cut, done.token())
    var open = List<Task<Result<void, IoError>>>()
    var served = 0
    IoError? failed = null
    while true {
        match await listener.acceptAsync(read accepting) {
            Ok(conn) => {
                open.add(echo(conn, cutting.clone()))
                served += 1
            }
            Error(Cancelled(_)) => break
            Error(cause) => {
                failed = cause
                break
            }
        }
    }
    while open.length() > 0 {
        match await Task.whenAny(ref open) {
            Ok => {}
            Error(Cancelled(_)) => say("a connection was cut")
            Error(cause) => say($"a connection ended: {cause}".toString())
        }
    }
    done.cancel()
    await watching
    if failed is not null {
        return Error(failed)
    }
    return Ok(served)
}
