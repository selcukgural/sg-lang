// What can go wrong, as one enum. C sees a number for each kind (`code`) and the message
// `format` writes.

public enum CalcError : Formattable {
    BadCharacter(nint position)
    BadNumber(nint position)
    Unexpected(nint position)
    UnknownVariable(string name)
    UnknownFunction(string name)
    DivisionByZero
    NotText

    // The number C gets: 1 for what cannot be read, 2 for a name nobody knows, 3 for a
    // division by zero, 4 for bytes that are not UTF-8.
    public int code(read this) {
        return match this {
            BadCharacter(_) or BadNumber(_) or Unexpected(_) => 1
            UnknownVariable(_) or UnknownFunction(_) => 2
            DivisionByZero => 3
            NotText => 4
        }
    }

    void format(read this, ref Formatter f) {
        match this {
            BadCharacter(at) => f.write($"a character that starts nothing at {at}")
            BadNumber(at) => f.write($"a number that cannot be read at {at}")
            Unexpected(at) => f.write($"something unexpected at {at}")
            UnknownVariable(name) => f.write($"no variable is named `{name}`")
            UnknownFunction(name) => f.write($"no function is named `{name}`")
            DivisionByZero => f.write("a division by zero")
            NotText => f.write("the text is not UTF-8")
        }
    }
}
