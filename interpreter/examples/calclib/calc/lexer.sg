// The tokens of an expression. A name is a piece of the text it was read from, not a copy:
// the token borrows the text (`from source`), and the checker sees that it does not outlive it.

enum Token<from source> {
    Number(double value)
    Name(read string text)
    Plus
    Minus
    Star
    Slash
    Caret
    LeftParen
    RightParen
    Equals
    End
}

bool isDigit(byte c) {
    return c >= '0' && c <= '9'
}

bool isLetter(byte c) {
    return match c {
        'a'..='z' or 'A'..='Z' or '_' => true
        _ => false
    }
}

struct Lexer<from source> {
    read string input
    nint pos

    Lexer create(read string input) from input {
        return Lexer { input = input, pos = 0 }
    }

    // The next token; the position of a character that starts none is the error.
    Result<Token, CalcError> next(ref this) from source {
        while this.pos < this.input.length() && (this.input[this.pos] == ' ' || this.input[this.pos] == '\t') {
            this.pos += 1
        }
        if this.pos >= this.input.length() {
            return Ok(Token.End)
        }
        nint start = this.pos
        byte c = this.input[start]
        if isDigit(c) || c == '.' {
            return this.number(start)
        }
        if isLetter(c) {
            while this.pos < this.input.length() && (isLetter(this.input[this.pos]) || isDigit(this.input[this.pos])) {
                this.pos += 1
            }
            return Ok(Token.Name(this.input[start..this.pos]))
        }
        this.pos += 1
        return match c {
            '+' => Ok(Token.Plus)
            '-' => Ok(Token.Minus)
            '*' => Ok(Token.Star)
            '/' => Ok(Token.Slash)
            '^' => Ok(Token.Caret)
            '(' => Ok(Token.LeftParen)
            ')' => Ok(Token.RightParen)
            '=' => Ok(Token.Equals)
            _ => Error(CalcError.BadCharacter(start))
        }
    }

    // Whether the next token is the character `symbol`, without reading it.
    bool nextIs(read this, byte symbol) {
        nint at = this.pos
        while at < this.input.length() && (this.input[at] == ' ' || this.input[at] == '\t') {
            at += 1
        }
        return at < this.input.length() && this.input[at] == symbol
    }

    // `12`, `0.5`, `.25`, `3.`: the digits and one point, read by `double.parse`.
    Result<Token, CalcError> number(ref this, nint start) from source {
        bool point = false
        while this.pos < this.input.length() {
            byte c = this.input[this.pos]
            if c == '.' && !point {
                point = true
            } else if !isDigit(c) {
                break
            }
            this.pos += 1
        }
        double value = double.parse(this.input[start..this.pos]) ?? return Error(CalcError.BadNumber(start))
        return Ok(Token.Number(value))
    }
}
