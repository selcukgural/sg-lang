// Enums carry data; `match` must handle every variant.

enum Shape {
    Circle(int radius)
    Rect(int width, int height)
    Empty
}

int area(read Shape s) {
    return match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Empty => 0
    }
}

string name(read Shape s) {
    return match s {
        Circle(r) when r > 100 => "big circle"
        Circle(_) => "circle"
        Rect(w, h) => {
            if w == h {
                return "square"
            }
            "rectangle"
        }
        Empty => "nothing"
    }
}

// `match ref` lends the values for writing.
void grow(ref Shape s, int by) {
    match s {
        Circle(r) => r += by
        Rect(w, h) => {
            w += by
            h += by
        }
        Empty => {}
    }
}

void main() {
    var circle = Shape.Circle(2)
    var rect = Shape.Rect(3, 4)
    var empty = Shape.Empty

    print(area(read circle))
    print(area(read rect))
    print(area(read empty))

    grow(ref rect, 1)
    grow(ref circle, 200)
    print($"{name(read circle)}: {area(read circle)}")
    print($"{name(read rect)}: {area(read rect)}")
    print(name(read Shape.Rect(5, 5)))
    print(name(read empty))

    // `is` tests one variant; the names live in the block.
    if rect is Rect(w, h) {
        print($"{w} x {h}")
    }
    if circle is not Empty {
        print("not empty")
    }

    // `match` on an owner moves the value in, like `var y = x`.
    match rect {
        Rect(w, _) => print(w)
        var other => print(area(read other))
    }
}
