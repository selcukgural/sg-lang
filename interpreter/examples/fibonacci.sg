// Recursion and a loop computing the same thing; assert compares them.
long fibRecursive(int n) {
    if n < 2 {
        return n
    }
    return fibRecursive(n - 1) + fibRecursive(n - 2)
}

long fibLoop(int n) {
    long a = 0
    long b = 1
    for _ in 0..n {
        var next = a + b
        a = b
        b = next
    }
    return a
}

void main() {
    for n in 0..15 {
        assert(fibRecursive(n) == fibLoop(n))
    }
    print($"fib(14) = {fibLoop(14)}")
    print($"fib(90) = {fibLoop(90)}")
}
