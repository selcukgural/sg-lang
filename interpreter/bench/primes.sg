// Loops, multiplication and remainder: primes below five million by trial division.
bool isPrime(int n) {
    if n < 2 {
        return false
    }
    var d = 2
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d += 1
    }
    return true
}

void main() {
    var count = 0
    for n in 0..5000000 {
        if isPrime(n) {
            count += 1
        }
    }
    print(count)
}
