// Ten million numbers sorted by C's `qsort` with a comparator written in SG: C calls it through
// the pointer it is given, as it calls the comparator of `callback.c`.
extern {
    void qsort(raw void base, nuint count, nuint size, CFunc<raw void, raw void, int> compare)
}

export int compareInts(raw void a, raw void b) {
    var x = unsafe ((raw int)a)[0]
    var y = unsafe ((raw int)b)[0]
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    return 0
}

void main() {
    nint count = 10_000_000
    var items = Memory.allocate<int>(count)
    uint state = 2463534242
    for i in 0..count {
        state ^= state << 13
        state ^= state >> 17
        state ^= state << 5
        unsafe {
            items[i] = (int)(state >> 1)
        }
    }
    unsafe qsort((raw void)items, (nuint)count, 4, compareInts)
    print($"{unsafe items[0]} {unsafe items[count / 2]} {unsafe items[count - 1]}")
    unsafe Memory.free(items)
}
