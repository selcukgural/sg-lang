// Bytes sorted into the classes a lexer needs, with ranges and `or` in a `match`. Ten million
// bytes are gone over twenty times. Each arm is a test of a range or of single bytes, which
// is what the C program writes by hand.
int kind(byte c) {
    return match c {
        'a'..='z' or 'A'..='Z' or '_' => 1
        '0'..='9' => 2
        ' ' or '\t' or '\n' or '\r' => 3
        '(' or ')' or '{' or '}' or '[' or ']' => 4
        '+' or '-' or '*' or '/' or '%' or '=' or '<' or '>' => 5
        _ => 0
    }
}

void main() {
    var bytes = List<byte>()
    long seed = 7
    for i in 0..10000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        bytes.add((byte)(seed % 128))
    }
    long total = 0
    for round in 0..20 {
        for c in read bytes {
            total += kind(c) + round
        }
    }
    print(total)
}
