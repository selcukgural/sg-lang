struct Row {
    string name
    int total
}

int countWords(read string text) {
    int words = 0
    for w in text.splitWhitespace() {
        words += 1
    }
    return words
}

read string? secondField(read string line) {
    var parts = line.split(',')
    _ = parts.next() ?? return null
    return parts.next()
}

Row? parseRow(read string line) {
    var parts = line.split(';')
    var name = parts.next() ?? return null
    int total = 0
    for field in parts {
        var value = int.parse(field.trim()) ?? return null
        total += value
    }
    return Row { name = name.trim().clone(), total = total }
}

void main() {
    print("xyz".chars().next() ?? '-')
    print(countWords("  the quick\u{a0}brown\u{3000}fox  "))
    print(secondField("a,b,c") ?? "none")
    print(secondField("a") ?? "none")
    var boxed = new "x:y:z".clone()
    for p in boxed.split(':') {
        print(p)
    }
    var text = "one two\nthree\n\nfour five six\n"
    int lineNumber = 0
    for line in text.lines() {
        lineNumber += 1
        if line.length() == 0 {
            continue
        }
        for word in line.splitWhitespace() {
            if word == "five" {
                break
            }
            print($"{lineNumber}: {word}")
        }
    }
    var rows = List<Row>()
    for line in "ada; 1; 2\nbob ;3\nbad; x\n".lines() {
        var row = parseRow(line)
        if row is not null {
            rows.add(row)
        } else {
            print($"bad line: {line}")
        }
    }
    for row in read rows {
        print($"{row.name} {row.total}")
    }
    var it = "a-b-c".split("-")
    while true {
        var part = it.next()
        if part is null {
            break
        }
        print(part)
    }
    print("abc".indexOf("") ?? -1)
    print("abc".lastIndexOf("") ?? -1)
    print("".split(',').next() ?? "none")
    print("".lines().next() ?? "none")
    print("   ".splitWhitespace().next() ?? "none")
    print($"[{"\u{2003} x \t".trim()}]")
    print("é".startsWith('é'))
    print("aé".endsWith("é"))
    print("abc".contains('é'))
    print("AbC".equalsIgnoreAsciiCase("aBc"))
    print("É".equalsIgnoreAsciiCase("é"))
    print("abc".startsWith(""))
    byte colon = ':'
    print("a:b".indexOf(colon) ?? -1)
}
