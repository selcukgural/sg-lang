// A borrow of a value that has no name is fine while the line lasts.
string make() {
    return "hello world".clone()
}

List<int> numbers() {
    return List<int> { 1, 2, 3 }
}

int total(read int[] values) {
    var sum = 0
    for v in values {
        sum += v
    }
    return sum
}

void main() {
    print(make()[..5])
    print(make()[6..] == "world")
    print(make()[..5].length())
    print(total(numbers()[1..]))
    print(total(read numbers()))
    print(make().asBytes()[0])
    // A constant is there for the whole run.
    var word = "constant"[..5]
    var bytes = "abc".asBytes()
    print(word)
    print(bytes)
    // What is copied out does not borrow.
    var first = numbers()[0]
    var size = make()[..5].length()
    print(first + (int)size)
}
