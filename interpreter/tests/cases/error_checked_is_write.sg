enum Shape {
    Circle(long radius)
    Named(string name)
}

struct Drawing {
    Shape shape
    long moves
}

// The names of an `is` borrow for the whole `if`.
void main() {
    var drawing = new shared checked Drawing { shape = Shape.Named("a"), moves = 0 }
    if drawing.shape is Named(name) {
        drawing.shape = Shape.Circle(1)
    }
}
