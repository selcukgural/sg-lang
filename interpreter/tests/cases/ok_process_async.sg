// The async versions: `runAsync`, `outputAsync` and `statusAsync` of a `Command`, and `waitAsync`
// of a `Process`, which do the work of those without `Async` without holding the thread. The
// program started is `sg-test-tool` (tests/tool), whose words are its steps.
Command tool(read string[] steps) {
    var command = Command("sg-test-tool")
    command.args(steps)
    return command
}

async Result<void, ProcessError> main() {
    var said = try await tool(read List<string> { "out=hello async" }).outputAsync()
    print($"output: {said.trim()}")

    var status = try await tool(read List<string> { "exit=3" }).statusAsync()
    print($"status: {status}")
    if await tool(read List<string> { "exit=3" }).runAsync() is Error(cause) {
        print($"run: {cause}")
    }
    try await tool(read List<string> { "out=run writes here" }).runAsync()
    if await tool(read List<string> { "out=some", "exit=2" }).outputAsync() is Error(cause) {
        print($"output: {cause}")
    }
    if await tool(read List<string> { "bad" }).outputAsync() is Error(cause) {
        print($"output: {cause}")
    }

    var sort = tool(read List<string> { "sort" })
    sort.input("b\na\nc\n")
    var sorted = try await sort.outputAsync()
    print(sorted.replaceAll("\n", " "))

    var process = try tool(read List<string> { "exit=6" }).start()
    print(try await process.waitAsync())
    if await Command("no-such-program-anywhere").statusAsync() is Error(cause) {
        print($"missing: {cause}")
    }
    return Ok()
}
