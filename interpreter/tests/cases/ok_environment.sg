// The variables of the environment, read with `Environment.get`. The test sets one through C, as no
// SG program can: with bytes of UTF-8 on Linux and macOS, with units of UTF-16 on Windows, where a
// lone surrogate is what is not text. What is not text comes as a name of the system does (choice
// 1950): each byte a character from U+10FF80, which `Path.systemBytes` gives back as the byte; on
// Windows the lone surrogate is the three bytes WTF-8 writes it with.
extern {
    int setenv(read CString name, raw byte value, int overwrite)
    int putenv(raw byte entry)
    int SetEnvironmentVariableW(raw ushort name, raw ushort value)
}

// A name of ASCII in units of UTF-16, ended by a zero.
raw ushort wide(read string ascii) {
    var bytes = ascii.asBytes()
    var units = Memory.allocate<ushort>(bytes.length() + 1)
    for i in 0..bytes.length() {
        unsafe {
            units[i] = (ushort)bytes[i]
        }
    }
    return units
}

void show(read string name) {
    var shown = name.replaceAll("\u{0}", "\\0")
    match Environment.get(name) {
        Ok(value) => print($"{shown} = {value}")
        Error(cause) => print($"[{shown}]: {cause}")
    }
}

void main() {
    print(Environment.get("PATH") is Ok(_))
    show("SG_NO_SUCH_VARIABLE_2718")
    show("")
    show("A=B")
    show("PA\u{0}TH")
    var home = Environment.get("SG_NO_SUCH_VARIABLE_2718") ?? "/nowhere"
    print(home)

    if OperatingSystem.isWindows() {
        var text = wide("SG_TEST_TEXT")
        var bytes = wide("SG_TEST_BYTES")
        var v = Memory.allocate<ushort>(8)
        unsafe {
            v[0] = 0x63
            v[1] = 0x61
            v[2] = 0x66
            v[3] = 0xe9
            _ = SetEnvironmentVariableW(text, v)
            v[1] = 0xd800
            _ = SetEnvironmentVariableW(bytes, v)
            // A name with the lone surrogate in it, and the value `x`.
            var odd = wide("SG_TEST_XX")
            odd[8] = 0xdc00
            v[0] = 0x78
            v[1] = 0
            _ = SetEnvironmentVariableW(odd, v)
            Memory.free(odd)
            Memory.free(v)
            Memory.free(text)
            Memory.free(bytes)
        }
    } else {
        var name = CString.from("SG_TEST_TEXT") ?? panic("zero byte")
        var p = Memory.allocate<byte>(8)
        unsafe {
            p[0] = 0x63
            p[1] = 0x61
            p[2] = 0x66
            p[3] = 0xc3
            p[4] = 0xa9
            _ = setenv(read name, p, 1)
            p[1] = 0xff
            var bad = CString.from("SG_TEST_BYTES") ?? panic("zero byte")
            _ = setenv(read bad, p, 1)
            Memory.free(p)
            // A name with the byte 0xFE in it, and the value `x`: `SG_TEST_\xFEX=x`, which
            // `putenv` keeps, so it is never freed.
            var entry = Memory.allocate<byte>(13)
            var ascii = "SG_TEST_XX=x".asBytes()
            for i in 0..ascii.length() {
                entry[i] = ascii[i]
            }
            entry[8] = 0xfe
            entry[12] = 0
            _ = putenv(entry)
        }
    }
    show("SG_TEST_TEXT")
    var value = Environment.get("SG_TEST_BYTES") ?? panic("SG_TEST_BYTES is set")
    var expected = OperatingSystem.isWindows() ? "63eda08066c3a9" : "63ff66c3a9"
    var given = Path.systemBytes(read value)
    print($"SG_TEST_BYTES as the system has it: {Hex.encode(read given) == expected}")
    print($"it starts with c and ends with fé: {value.startsWith("c") && value.endsWith("fé")}")
    // The odd name, written from its bytes.
    var name = List<byte>()
    for b in "SG_TEST_".asBytes() {
        name.add(b)
    }
    if OperatingSystem.isWindows() {
        name.add(0xed)
        name.add(0xb0)
        name.add(0x80)
    } else {
        name.add(0xfe)
    }
    name.add(0x58)
    var odd = Path.fromSystemBytes(read name)
    print($"the variable whose name is not text: {Environment.get(read odd) ?? "not found"}")
}
