enum Expr {
    Number(int value)
    Name(string text)
    Add(Expr* left, Expr* right)
    Empty
}
enum Slot {
    Full(Expr item)
    Maybe(Expr? item)
    Nothing
}

int f(read Expr e) {
    return match e {
        Add(Number(a), _) => a
        Add(_, Number(b)) => b
        Add(Number(c), Number(d)) => c
        _ => 0
    }
}
void main() {}
