// The variable of `for i in a..b` is a copy of the count made in each round: changing it
// changes nothing about the rounds, in the interpreter and in compiled code alike.
void main() {
    long sum = 5
    for i in 0..4 {
        i += 1
        sum += 1
        print(i)
    }
    print(sum)
    // A loop after it may name its variable `i` again: the first `i` has ended.
    var ys = int[3] { 3, 4, 5 }
    for i in ys {
        i += 1
        print(i)
    }
    print(sum)
}
