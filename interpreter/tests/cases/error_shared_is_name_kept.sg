// The name an `is` gives out of a `shared` value is for its statement (choice 1592).
enum Shape {
    Named(string name)
    Empty
}
struct Box {
    Shape shape
    List<string> items
    string? opt
}
alias BoxRef = shared checked Box
BoxRef make() {
    return new BoxRef { shape = Shape.Named("a long text that lives on the heap one".clone()), items = List<string> { "a long text that lives on the heap two".clone() }, opt = "a long text that lives on the heap three".clone() }
}
int grow(read BoxRef b) {
    b.items.clear()
    b.shape = Shape.Empty
    b.opt = null
    return 0
}
void main() {
    var a = make()
    var b = share a
    var other = "o".clone()
    var r = read other
    if a.shape is Named(name) {
        r = read name
    }
    b.shape = Shape.Empty
    print(r)
}
