void bump(ref int[] values) {
    for v in ref values {
        v += 1
    }
}

test "a ref slice writes into the array" {
    var a = int[3] { 1, 2, 3 }
    bump(ref a)
    assert(a == int[3] { 2, 3, 4 })
    bump(ref a[2..])
    assert(a[2] == 5)
}

test "a failed assert writes both arrays" {
    var a = int[2] { 1, 2 }
    assert(a == int[2] { 1, 3 })
}

test "a failed assert writes both slices" {
    var xs = List<int> { 1, 2, 3 }
    assert(xs[..2] == xs[1..])
}

void main() {
}
