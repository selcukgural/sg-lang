// Two tasks that each wait in a `select` for the other to send first: every task waits, and
// nothing is left that could end a wait. The interpreter sees it exactly; compiled code counts
// the threads that sleep (slice 193) and gives the same panic.
void ping(Channel<int> inbox, Channel<int> quiet, Sender<int> out) {
    var x = select {
        inbox.receive() as n => n
        quiet.receive() as n => n
        ended => 0
    }
    _ = out.send(x + 1)
}

void main() {
    var a = Channel<int>(1)
    var b = Channel<int>(1)
    var c = Channel<int>(1)
    var toA = a.sender()
    var toB = b.sender()
    var toC = c.sender()
    var first = Task.run(ping, a.clone(), c.clone(), toB)
    var second = Task.run(ping, b.clone(), c.clone(), toA)
    first.wait()
    second.wait()
    _ = toC
}
