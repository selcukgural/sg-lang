// Windows onto lists and arrays: empty ones, ones of values that have no name, ones inside others.
int[4] make() {
    return int[4] { 4, 3, 2, 1 }
}

int next(ref int counter) {
    counter += 1
    print($"next {counter}")
    return counter
}

int head(read int[4] values) {
    var part = values[1..]
    return part[0] + (int)values[..2].length()
}

read string longest(read string[] words) {
    var best = words[0]
    for word in words {
        if word.length() > best.length() {
            best = word
        }
    }
    return best
}

void main() {
    var empty = List<int>()
    print(empty[..])
    print(empty[0..0])
    print(empty[..].length())
    print(empty[0..].length())
    for x in empty[..0] {
        print(x)
    }
    print(empty[..] == empty[0..0])

    print(make().length())
    print(make()[2])
    print(make()[1..3])
    print(head(read make()))

    var counter = 0
    var values = List<int> { 10, 20, 30, 40, 50 }
    print(values[next(ref counter)..next(ref counter) + 2])
    print(values[next(ref counter)])

    var words = List<string> { "a".clone(), "bcd".clone(), "ef".clone() }
    print(longest(read words))
    print(longest(words[2..]))
    print(words[..2])
    print(words[1..].get(0) ?? "none")
    print(words[1..].get(5) ?? "none")
    print(words[..].indexOf("ef") ?? -1)
    print(words[..2].contains("ef"))

    var array = string[2] { "x".clone(), "y".clone() }
    print(longest(read array))
    print(array.get(1) ?? "none")
    print(array.get(2) ?? "none")
    print(array.contains("y"))

    var numbers = int[5] { 5, 4, 3, 2, 1 }
    var middle = ref numbers[1..4]
    middle[0] = 40
    var inner = middle[1..]
    print(inner)
    print(numbers)
    print(numbers[..] == numbers[0..5])
    print(numbers[1..] == numbers[..4])
    print(numbers.get(4) ?? -1)
    print(numbers[4..].get(1) ?? -1)
    print($"all {numbers[..]} and {numbers[3..].length()}")
}
