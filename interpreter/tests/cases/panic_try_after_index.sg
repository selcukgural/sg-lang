// The index is computed before the `try`, so the panic comes first and `word` never prints. Compiled
// code therefore does not compute such a `try` first (choice 1817; `cli.rs` tests that it asks
// for a name).

Result<string, string> word(int x) {
    print($"word {x}")
    return Ok("w")
}

Result<int, string> fill() {
    var lists = List<List<string>>()
    lists[3].add(try word(1))
    return Ok(0)
}

void main() {
    match fill() {
        Ok(_) => print("ok")
        Error(e) => print(e)
    }
}
