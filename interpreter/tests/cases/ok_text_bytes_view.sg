// The bytes of a text, looked at where they are (`asBytes` and the slices of it): every way a
// `read byte[]` is read gives the same as it does for the bytes of a list.

int sum(read byte[] data) {
    int total = 0
    for b in data {
        total += b
    }
    return total
}

void main() {
    var text = "héllo, world"
    var bytes = text.asBytes()
    print(bytes.length())
    print(bytes[1])
    print(bytes.get(2) ?? 0)
    print(bytes.get(99) ?? 0)
    print(bytes[8..])
    var inner = bytes[8..][1..3]
    print(inner)
    print(inner.length())
    print(inner[0])
    print(bytes[..0].length())
    print(sum(bytes))
    print(sum(bytes[..1]))
    print(bytes.indexOf(',') ?? -1)
    print(bytes[8..].contains('o'))
    print(bytes[8..] == "world".asBytes())
    print(bytes[8..] == "World".asBytes())
    print(string.fromUtf8(bytes[..6]) ?? "?")

    var list = List<byte>()
    list.addAll(bytes[8..])
    list.add('!')
    print(string.fromUtf8(read list) ?? "?")
    var copy = byte[5] { 0, 0, 0, 0, 0 }
    copy[..].copyFrom(bytes[8..])
    print(copy)

    // The view keeps the text it was taken from, as it was.
    var other = "abc"
    var view = other.asBytes()
    print(view)
    print(sum(view))
}
