// A call that changes something and gives a value too is called for the change, and its value
// is thrown away on purpose with `_ =`: a built-in method, a function and a method of your own.
struct Stack {
    List<int> items

    nint push(ref this, int item) {
        this.items.add(item)
        print($"pushed {item}")
        return this.items.length()
    }
}

int noisy(int n) {
    print($"noisy {n}")
    return n * 2
}

void main() {
    var xs = List<int>()
    xs.add(1)
    xs.add(2)
    _ = xs.removeLast()
    print(xs)

    var seen = HashSet<string>()
    _ = seen.add("a")
    _ = seen.add("a")
    _ = seen.remove("b")
    print(seen.length())

    var ages = HashMap<string, int>()
    ages.add("ada", 36)
    _ = ages.remove("ada")
    _ = ages.getOrAdd("bob", 7)
    print(ages.get("bob") ?? 0)

    var words = "one two".splitWhitespace()
    _ = words.next()
    print(words.next() ?? "")

    // Functions and methods of your own may print or change through `ref`; their value is
    // dropped the same way.
    _ = noisy(4)
    var stack = Stack { items = List<int>() }
    _ = stack.push(5)

    _ = xs.contains(1)
    _ = "  x ".trim()
    _ = (-3).max(0)
}
