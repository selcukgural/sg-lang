enum Shape {
    Circle(int radius)
    Rect(int width, int height)
    Empty
}

int area(read Shape s) {
    return match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Empty => 0
    }
}

void main() {
    var s = Shape.Rect(3, 4)
    match s {
        Rect(w, h) => print(w * h)
        _ => print("other")
    }
    print(area(read s))
}
