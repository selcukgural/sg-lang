// Structs of numbers, `read`, `ref` and methods: all of it is compiled through C as well.
struct Point : Copyable {
    int x
    int y
}

struct Rect {
    Point corner
    int width
    int height

    Rect create(int width, int height) {
        return Rect { corner = Point { x = 0, y = 0 }, width = width, height = height }
    }

    long area(read this) {
        long wide = this.width
        return wide * this.height
    }

    void moveBy(ref this, int dx, int dy) {
        this.corner.x += dx
        this.corner.y += dy
    }

    bool contains(read this, Point p) {
        return p.x >= this.corner.x && p.x < this.corner.x + this.width &&
            p.y >= this.corner.y && p.y < this.corner.y + this.height
    }
}

void grow(ref Rect rect, int by) {
    rect.width += by
    rect.height += by
}

long total(read Rect a, read Rect b) {
    return a.area() + b.area()
}

void swapInts(ref int a, ref int b) {
    var kept = a
    a = b
    b = kept
}

void countdown(ref int n) {
    while n > 0 {
        n -= 1
    }
}

void main() {
    var rect = Rect(4, 3)
    print(rect.area())
    rect.moveBy(10, 20)
    grow(ref rect, 2)
    print($"{rect.corner.x},{rect.corner.y} {rect.width}x{rect.height}")
    print(rect.contains(Point { x = 12, y = 22 }))
    print(rect.contains(Point { x = 1, y = 1 }))

    var other = Rect(1, 1)
    print(total(read rect, read other))

    var p = rect.corner                  // Copyable: a copy
    p.x = 0
    print(rect.corner.x)
    print(p.x)

    var a = 1
    var b = 2
    swapInts(ref a, ref b)
    print($"{a} {b}")
    countdown(ref a)
    print(a == 0)

    byte small = 200
    print(small.wrappingAdd(100))
    print((int)small * 2)
    long big = 4000000000
    print(big / 3 % 7)
    print(-big)
}
