// The list is cleared after `out` changes: in that round it still holds the borrow of the
// round before.
void main() {
    var out = List<byte>()
    var pieces = List<read byte[]>()
    for i in 0..3 {
        out.clear()
        pieces.clear()
        out.add((byte)i)
        pieces.add(out[0..1])
        print(pieces.length())
    }
}
