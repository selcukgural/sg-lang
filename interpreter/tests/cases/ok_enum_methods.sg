enum Shape : Formattable, Equatable, Comparable {
    Circle(int radius)
    Rect(int width, int height)
    Empty

    int area(read this) {
        return match this {
            Circle(r) => 3 * r * r
            Rect(w, h) => w * h
            Empty => 0
        }
    }

    void grow(ref this) {
        match this {
            Circle(r) => r += 1
            Rect(w, h) => {
                w += 1
                h += 1
            }
            Empty => {}
        }
    }

    Shape unit() {
        return Shape.Rect(1, 1)
    }

    void format(read this, ref Formatter f) {
        f.write($"<{this.area()}>")
    }

    int compare(read this, read Shape other) {
        return this.area() - other.area()
    }
}

// An enum that compares its values in its own way: by kind, whatever the text.
enum Answer : Equatable {
    Yes(string said)
    No

    bool equals(read this, read Answer other) {
        return match this {
            Yes(_) => other is Yes(_)
            No => other is No
        }
    }
}

void main() {
    var s = Shape.Circle(2)
    print(s.area())
    s.grow()
    print(s)
    var u = Shape.unit()
    print(u)
    print(u < s)
    print(u == Shape.Rect(1, 1))
    var xs = List<Shape>()
    xs.add(Shape.Circle(3))
    xs.add(Shape.Empty)
    xs.add(Shape.unit())
    xs.sort()
    print(xs)
    print(Answer.Yes("sure") == Answer.Yes("of course"))
    print(Answer.Yes("sure") == Answer.No)
    var answers = List<Answer> { Answer.No, Answer.Yes("y") }
    var wanted = Answer.Yes("anything")
    print(answers.indexOf(read wanted) ?? -1)
}
