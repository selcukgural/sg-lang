// A task waits in `lock ... when` for a flag that only `main` could set, and `main` waits for
// the task first: every task waits, and nothing is left that could end a wait.
struct Gate {
    bool open
}

int pass(shared locked Gate gate) {
    lock gate as g when g.open {
        return 1
    }
    return 0
}

void main() {
    var gate = new shared locked Gate { open = false }
    var t = Task.run(pass, share gate)
    print(t.wait())
    lock gate as g {
        g.open = true
    }
}
