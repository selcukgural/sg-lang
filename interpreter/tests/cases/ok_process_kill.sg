// Stopping a program: `kill` sends the signal 9, `terminate` the signal 15, which a program may
// catch to end in its own way. A program that has ended is not stopped again: it keeps its number
// until it is waited for.
Result<void, ProcessError> main() {
    var sleep = Command("sleep")
    sleep.arg("10")
    var killed = try sleep.start()
    killed.kill()
    print(try killed.wait())
    var asked = try sleep.start()
    asked.terminate()
    print(try asked.wait())

    // `true` has ended by the time the other program has; `kill` then does nothing.
    var done = try Command("true").start()
    var pause = Command("sleep")
    pause.arg("0.2")
    try pause.run()
    done.kill()
    print(try done.wait())

    // A shell that catches the polite stop, once it says it is ready for it.
    var sh = Command("sh")
    sh.args(read List<string> { "-c", "trap 'echo caught; kill $!; exit 5' TERM; echo ready; sleep 10 & wait" })
    sh.pipeOutput()
    var shell = try sh.start()
    var output = shell.takeOutput() ?? panic("the output was asked for")
    var line = ""
    _ = try output.readLine(ref line)
    print(line)
    shell.terminate()
    _ = try output.readLine(ref line)
    print(line)
    print(try shell.wait())
    return Ok()
}
