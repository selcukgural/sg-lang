// Stopping a program: `kill` sends the signal 9, `terminate` the signal 15, which a program may
// catch to end in its own way. A program that has ended is not stopped again: it keeps its number
// until it is waited for. Windows has no polite stop: both end the program with the code 1. The
// program started is `sg-test-tool` (tests/tool), whose words are its steps.
Command tool(read string[] steps) {
    var command = Command("sg-test-tool")
    command.args(steps)
    return command
}

Result<void, ProcessError> main() {
    var sleep = tool(read List<string> { "sleep=10000" })
    var killed = try sleep.start()
    killed.kill()
    print(try killed.wait())
    var asked = try sleep.start()
    asked.terminate()
    print(try asked.wait())

    // The first has ended by the time the other one has; `kill` then does nothing.
    var done = try tool(read List<string> {}).start()
    try tool(read List<string> { "sleep=200" }).run()
    done.kill()
    print(try done.wait())

    // A program that catches the polite stop, once it says it is ready for it.
    var listening = tool(read List<string> { "listen" })
    listening.pipeOutput()
    var listener = try listening.start()
    var output = listener.takeOutput() ?? panic("the output was asked for")
    var line = ""
    _ = try output.readLine(ref line)
    print(line)
    listener.terminate()
    if try output.readLine(ref line) {
        print(line)
    } else {
        print("its output ended")
    }
    print(try listener.wait())
    return Ok()
}
