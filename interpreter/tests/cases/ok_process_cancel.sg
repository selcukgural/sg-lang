// A cancel stops the program it ends the wait for: `statusAsync`, `outputAsync` and `waitAsync`
// give `Cancelled`, and the program is stopped. With a token cancelled before the call, the
// program does not start. The program started is `sg-test-tool` (tests/tool), whose words are its
// steps.
Command tool(read string[] steps) {
    var command = Command("sg-test-tool")
    command.args(steps)
    return command
}

async Result<void, ProcessError> main() {
    var sleep = tool(read List<string> { "sleep=10000" })
    var soon = CancellationSource.after(100)
    if await sleep.statusAsync(read soon.token()) is Error(cause) {
        print($"status: {cause}")
    }
    var later = CancellationSource.after(100)
    if await sleep.outputAsync(read later.token()) is Error(cause) {
        print($"output: {cause}")
    }
    var other = CancellationSource.after(100)
    var process = try sleep.start()
    if await process.waitAsync(read other.token()) is Error(cause) {
        print($"wait: {cause}")
    }

    var before = CancellationSource()
    before.cancel()
    if await tool(read List<string> { "out=started" }).runAsync(read before.token()) is Error(cause) {
        print($"run: {cause}")
    }
    var never = CancellationSource.after(10000)
    var status = try await tool(read List<string> {}).statusAsync(read never.token())
    print(status)
    return Ok()
}
