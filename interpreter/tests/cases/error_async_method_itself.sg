struct Counter {
    int n

    public async int down(read this) {
        if this.n == 0 {
            return 0
        }
        var next = Counter { n = this.n - 1 }
        return await next.again()
    }

    public async int again(read this) {
        return await this.down()
    }
}

async void main() {
    var counter = Counter { n = 3 }
    print(await counter.down())
}
