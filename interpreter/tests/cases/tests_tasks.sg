int twice(int x) {
    return x * 2
}

Result<int, string> limited(int x) {
    if x > 1 {
        return Error("too big")
    }
    return Ok(x)
}

void loud(int x) {
    printError("from the task")
}

test "a task gives what its function returns" {
    var t = Task.run(twice, 4)
    assert(t.wait() == 8)
}

test "an error leaves the other task, which is waited for" {
    var t = Task.run(twice, 4)
    var u = Task.run(limited, 5)
    var value = try u.wait()
    assert(t.wait() == value)
}

test "what a task writes to the error shows under its test" {
    var t = Task.run(loud, 1)
    t.wait()
    assert(false)
}
