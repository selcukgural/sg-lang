// `Memory.zeroSecurely` writes zeros over a window, and the C compiler keeps them although
// nothing reads them afterwards.

struct Pair {
    uint a
    uint b
}

void forget(ref byte[] secret) {
    Memory.zeroSecurely(ref secret)
}

void main() {
    var key = List<byte>()
    for i in 0..8 {
        key.add((byte)(i + 1))
    }
    forget(ref key)
    print(key)
    ulong[3] words = ulong[3] { 1, 2, 3 }
    Memory.zeroSecurely(ref words[1..])
    print(words)
    Memory.zeroSecurely(ref words)
    print(words)
    var pairs = List<Pair>()
    pairs.add(Pair { a = 1, b = 2 })
    Memory.zeroSecurely(ref pairs)
    print($"{pairs[0].a} {pairs[0].b}")
    double[2] values = double[2] { 1.5, -2 }
    Memory.zeroSecurely(ref values)
    print(values)
}
