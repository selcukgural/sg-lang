// A bit field takes only what fits its bits: in a debug build the rest is a panic.
struct Flags {
    uint version : 4
    uint length : 4
}

void main() {
    var flags = Flags { version = 1, length = 2 }
    uint grown = 14
    flags.length = grown
    print(flags.length)
    flags.length += 3
    print(flags.length)
}
