// A `Process` that ends without being waited for stops its program: on a way out with an error, and
// in a field of a struct that ends. Had the programs gone on, they would write after a third of a
// second. The program started is `sg-test-tool` (tests/tool), whose words are its steps.
struct Holder {
    Process process
}

Command late(read string word) {
    var command = Command("sg-test-tool")
    command.args(read List<string> { "sleep=300", $"out={word} survived".toString() })
    return command
}

Result<void, IoError> leave() {
    var process = try late("the first").start()
    print(process.id() > 0)
    _ = try File.readText("/no/such/file")
    _ = try process.wait()
    return Ok()
}

void main() {
    match leave() {
        Ok => print("read")
        Error(cause) => print($"left: {cause}")
    }
    match late("the second").start() {
        Ok(process) => {
            var holder = Holder { process = process }
            print(holder.process.id() > 0)
        }
        Error(cause) => print($"{cause}")
    }
    var pause = Command("sg-test-tool")
    pause.arg("sleep=600")
    _ = pause.status()
    print("done")
}
