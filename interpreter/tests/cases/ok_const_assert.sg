// `const assert`: checked when the program is compiled, at the top of a file and in a block;
// nothing of it is left in the program.
struct Header {
    uint magic
    ushort version
    ushort flags
}

const int BlockSize = 64
const int[4] Primes = { 2, 3, 5, 7 }

const assert(BlockSize % 8 == 0)
const assert(Primes.length() == 4, "four primes")
const assert(sumOf(Primes) == 17)
const assert(Memory.sizeOf<Header>() == 8, "a header is eight bytes, as the file has it")
const assert(Memory.alignOf<Header>() == 4 && nint.MaxValue >= int.MaxValue)

int sumOf(read int[] items) {
    var total = 0
    for item in items {
        total += item
    }
    return total
}

void main() {
    const int Half = BlockSize / 2
    const assert(Half * 2 == BlockSize)
    for i in 0..2 {
        const assert(Half > 0, "half a block is something")
        print(i * Half)
    }
}
