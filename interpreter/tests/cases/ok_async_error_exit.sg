// A function that ends with an error waits, before it returns, for the tasks it started
// and did not await: no task is cut off, and its error is the one that counts.
async void note(string text, int ms) {
    await Task.delay(ms)
    print(text)
}

async Result<int, string> check(int x) {
    if x < 0 {
        return Error("below zero")
    }
    return Ok(x)
}

async Result<void, string> run() {
    var late = note("the late task ends", 20)
    var value = try await check(-1)
    print(value)
    await late
    return Ok()
}

async void main() {
    if await run() is Error(cause) {
        print($"run: {cause}")
    }
}
