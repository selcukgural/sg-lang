// A const and a static are indexed from the end too (1925): the value is found when the program is
// compiled.

const int[] Primes = { 2, 3, 5, 7 }
const int Last = Primes[^1]
const string Name = "hello"
const byte End = Name[^1]
const assert(Primes[^4] == 2)
static int Top = Primes[^1] + Primes[^4]

void main() {
    print($"{Last} {End} {Top}")
    const int Inner = Primes[^3]
    print(Inner)
    print(Primes[1..^1].length())
}
