// Two ranges of one array lent as `ref` to one call clash where they share items (choice 1610);
// ranges that never do go together (choice 2011), and ranges whose ends are written as numbers
// are told apart when the program is compiled (choice 2013).
void both(ref int[] a, ref int[] b) {
    a[0] = b[0]
}
void main() {
    var xs = int[4] { 1, 2, 3, 4 }
    both(ref xs[0..1], ref xs[2..4])
    both(ref xs[0..2], ref xs[1..4])
}
