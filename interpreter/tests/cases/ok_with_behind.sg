// What the hints of `with` on a `T*` and on a `shared T` write (choice 2212).
struct Point : Formattable, Copyable {
    int x
    int y
}

struct Label : Formattable, Clonable {
    string text
    int size
}

void main() {
    var label = new Label { text = "a".clone(), size = 1 }
    var bigger = label.clone() with { size = 20 }
    print(bigger)
    var origin = new shared Point { x = 1, y = 2 }
    read origin as point {
        print(point with { x = 20 })
    }
    var tag = new shared locked Label { text = "b".clone(), size = 2 }
    lock tag as held {
        print(held.clone() with { size = 30 })
    }
}
