// A `ref` field reached through a `read` borrow only reads: copied out, it would change what is
// only looked at (choice 1592).
struct W<from source> {
    ref List<string> items
}
void clear(ref List<string> xs) {
    xs.clear()
}
void wipe(read W w) {
    var inner = w.items
    inner.clear()
}
void main() {
    var xs = List<string> { "a long text that lives on the heap one".clone() }
    var w = W { items = ref xs }
    var v = read w.items[0]
    wipe(read w)
    print(v)
}
