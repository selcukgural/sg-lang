// Random texts with white space of every kind, separators and characters of several bytes:
// compiled code must split and trim them as the interpreter does.
void show(read string t) {
    print($"[{t.trim()}] [{t.trimStart()}] [{t.trimEnd()}]")
    for p in t.split(',') { print($"s<{p}>") }
    for p in t.split("ab") { print($"S<{p}>") }
    for p in t.split('é') { print($"E<{p}>") }
    for p in t.lines() { print($"l<{p}>") }
    for p in t.splitWhitespace() { print($"w<{p}>") }
    nint n = 0
    for c in t.chars() { n += c.utf8Length() }
    print($"{n} {t.length()} {t.indexOf('b') ?? -1} {t.lastIndexOf("ab") ?? -1} {t.contains('😀')} {t.startsWith(' ')} {t.endsWith("\n")}")
}
void main() {
    show(";\u{85}bc\u{c}")
    show("\u{2028}")
    show("b\u{b}\u{9}bc\u{e9}\u{e9}c\u{a}")
    show("\u{c}")
    show("bx,\u{a}xb")
    show("x\u{85}b\u{a}b\u{c};\u{a0}\u{e9}")
    show("\u{c},")
    show("\u{a0}\u{c} ,xx\u{9}\u{2028},")
    show("cxb\u{9}ab\u{c}\u{e9}\u{3000}")
    show("x\u{1f600}\u{2028}\u{a0}\u{a} \u{a}")
    show("x")
    show("\u{b}ab\u{3000}\u{1f600}")
    show("c,\u{b}\u{e9}")
    show("\u{3000};")
    show("ab\u{e9}bc\u{c}x\u{3000}\u{3000}\u{2028}abx\u{1f600}cc")
    show("abcb\u{a0}")
    show("x\u{1f600}\u{a0}\u{85}\u{2028}a\u{1f600}\u{2028} ,")
    show("b\u{9}\u{a0};\u{a}\u{85}\u{85}")
    show("abc \u{1f600}\u{85}\u{c}\u{d};\u{e9}\u{c}\u{d}\u{e9}\u{2028}\u{85}")
    show(";c ")
    show("\u{a}\u{a}")
    show("")
    show("x \u{d}\u{a0}a;\u{e9}")
    show("\u{2028}x\u{3000};\u{b}b\u{1f600}\u{c}")
    show("\u{85}\u{85}\u{85},ab\u{85}")
    show("")
    show("c\u{9}\u{1f600}")
    show(",\u{3000}")
    show("b,ax;\u{c},\u{2028}a")
    show("\u{9}")
    show("\u{85};\u{d}\u{2028}\u{2028}ab,,ab")
    show("abab\u{a0}c;,\u{3000}")
    show("\u{d}ab \u{b}a\u{9}\u{b}\u{2028};\u{c}a")
    show("\u{b}\u{a0}c\u{d}\u{b}\u{2028} \u{2028}\u{a}\u{c}\u{c}\u{b}")
    show("\u{a}\u{9}\u{a}\u{85}\u{a}")
    show("\u{b}ab\u{2028}")
    show("aa\u{d}ab\u{d}\u{9}\u{2028}\u{1f600}\u{2028}\u{2028}c")
    show(",\u{a}ab")
    show("\u{3000}\u{9}ab")
    show("aab\u{2028}c,\u{85}\u{9}ab ")
    show("\u{3000}c\u{85}\u{1f600}\u{85}c")
    show("  ;a;x\u{1f600};ab\u{2028};")
    show("\u{c};aa,\u{b};\u{e9}")
    show("\u{9}\u{9}a\u{d}\u{9}\u{a0}\u{b}\u{a}x\u{3000}\u{d}\u{c}\u{e9}")
    show(";b\u{2028}\u{1f600}x\u{b}\u{e9}\u{b};\u{c};\u{b}\u{b}")
    show("")
    show("\u{1f600} a; ;ab,\u{c}b\u{3000}\u{b}\u{b}")
    show("ab,\u{c}b\u{a}\u{9}\u{d}b")
    show(",\u{b}\u{1f600}\u{c}ac\u{1f600}\u{3000}\u{b}\u{b}\u{9}\u{d}")
    show("\u{b}\u{c}ab\u{b}\u{a}\u{b}\u{d}")
    show("\u{c}\u{9}\u{1f600};\u{e9},\u{85}\u{1f600}\u{3000}c\u{a}\u{e9}c\u{9}")
    show("\u{a0},;\u{2028};\u{d};\u{1f600}\u{a},")
    show("ab \u{a} \u{e9}\u{b}")
    show("\u{3000}\u{e9}\u{9}\u{2028}\u{3000}c")
    show("\u{2028}a\u{3000}\u{c}\u{1f600}\u{1f600}a\u{85}\u{3000}\u{b}\u{a0}")
    show("c,\u{a},c\u{d}\u{d}b")
    show(" \u{d};\u{e9}\u{d}\u{85};\u{c}\u{b}xab\u{3000}c\u{d}")
    show("")
    show(" \u{e9}c\u{d}ac\u{d}c\u{a}c\u{d},")
    show("a\u{3000}\u{c}\u{e9}\u{d};b")
}
