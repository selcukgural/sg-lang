// A `shared checked` value reached through a field is known by that path (`sheet.drawing`):
// read for the whole `if` by its names, it cannot be changed inside it.
enum Shape {
    Circle(long radius)
    Named(string name)
}

struct Drawing {
    Shape shape
}

struct Sheet {
    shared checked Drawing drawing
}

void main() {
    var sheet = Sheet { drawing = new shared checked Drawing { shape = Shape.Named("a") } }
    if sheet.drawing.shape is Named(name) {
        sheet.drawing.shape = Shape.Circle(1)
    }
}
