// `copyFrom`: the items of a window copied over as many (choices 1597, 1609).
struct Point : Copyable {
    int x
    int y
}

void fill(ref int[] into, read int[] from) {
    into.copyFrom(from)
}

void main() {
    // Over an array, a range of it, a list and a window lent as `ref`.
    var xs = int[6] { 1, 2, 3, 4, 5, 6 }
    var ys = int[2] { 9, 8 }
    xs[1..3].copyFrom(read ys)
    print(xs)
    var list = List<int> { 0, 0 }
    list.copyFrom(read ys)
    print(list)
    var zs = int[2]
    zs.copyFrom(read list)
    print(zs)
    fill(ref xs[4..], ys[..])
    print(xs)

    // Two windows of one place, forward and back, as `memmove` copies them.
    var bytes = List<byte> { 1, 2, 3, 4, 5, 6, 7, 8 }
    bytes[0..5].copyFrom(bytes[3..8])
    print(bytes)
    bytes[3..8].copyFrom(bytes[0..5])
    print(bytes)
    xs.copyFrom(read xs)
    print(xs)

    // Structs that copy, numbers of every width, and nothing at all.
    var points = Point[2] { Point { x = 0, y = 0 }, Point { x = 0, y = 0 } }
    var given = List<Point> { Point { x = 1, y = 2 }, Point { x = 3, y = 4 } }
    points.copyFrom(read given)
    print($"{points[0].x} {points[1].y}")
    var doubles = List<double> { 0.0, 0.0, 0.0 }
    var halves = double[3] { 0.5, 1.5, 2.5 }
    doubles.copyFrom(read halves)
    print(doubles)
    var none = List<int>()
    none.copyFrom(ys[0..0])
    xs[2..2].copyFrom(ys[1..1])
    print($"{none.length()} {xs}")
}
