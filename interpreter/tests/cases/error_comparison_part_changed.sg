// The two sides of `==` are computed from left to right too (choice 1592).
int g(ref List<string> xs) {
    xs.clear()
    return 1
}
string take(ref List<string> xs) {
    xs.clear()
    return "x".clone()
}
struct Word<from source> : Copyable {
    read string text
    int n
}
void main() {
    var xs = List<string> { "a long text that lives on the heap, number one".clone() }
    var e = xs[0] == take(ref xs)
    print(e)
    var ys = List<string> { "x".clone() }
    var f = ys[0] == take(ref ys)
    print(f)
}
