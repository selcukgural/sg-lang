// `front.sg` with the async wait for a change (2036): `waitChangeAsync` sees the pause, the going
// on and the end of a job in front at the terminal. Run at a terminal of its own by `script`
// (tests/cli.rs).

// Whether the group of the program `id` is the one in front at its terminal.
async bool inFront(int id) {
    var look = Command("sh")
    look.args(read List<string> { "-c", $"ps -o pgid= -o tpgid= -p {id}".toString() })
    var seen = await look.outputAsync() ?? ""
    var words = List<string>()
    for word in seen.split(' ') {
        var trimmed = word.trim()
        if trimmed.length() > 0 {
            words.add(trimmed.clone())
        }
    }
    return words.length() == 2 && words[0] == words[1]
}

async Result<void, IoError> main() {
    var me = Process.currentId()
    var job = Command("sh")
    _ = await File.deleteAsync("front-async-went-on")
    job.args(read List<string> { "-c", "kill -TSTP $$; echo resumed again; while [ ! -e front-async-went-on ]; do sleep 0.01; done" })
    job.foreground()
    var process = try job.start()
    var paused = try await process.waitChangeAsync()
    print(paused is Stopped(_))
    try Terminal.giveTo(read process)
    process.signalGroup(Signal.Continue)
    // The job writes `resumed again` at the same terminal once it goes on; the change it made
    // is printed only after the job has ended, so that the two lines always come in one order.
    // The job ends only once `front-async-went-on` is there, written after the going on was seen: had
    // it ended first, the wait would tell the end and the going on would never be seen.
    var went = try await process.waitChangeAsync()
    try await File.writeTextAsync("front-async-went-on", "")
    var ended = try await process.waitChangeAsync()
    print(went)
    print(ended)
    try Terminal.takeBack()
    var front = await inFront(me)
    print($"me in front at the end: {front}")
    var status = try await process.waitAsync()
    print(status)
    try await File.deleteAsync("front-async-went-on")
    return Ok()
}
