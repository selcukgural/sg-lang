// The limits of the shop, seen from other modules.

public const int MaxItems = 8
public const int[] Steps = { 1, 2, 4 }
const int Spare = 3

public int capacity() {
    return MaxItems * 2 + Spare
}

// Made of other consts and operators: a const calls no function.
public const int[] Powers = { 1, Steps[2], Steps[2] * Steps[2], Steps[2] * Steps[2] * Steps[2] }
public const string Label = "up to 8 items"
