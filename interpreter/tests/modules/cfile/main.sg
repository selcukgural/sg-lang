// A C file beside the program: its inline functions, a macro behind one, and its variables;
// and a module with a C file of its own.
use bits

extern "./native.c" {
    long square(long n)
    int count_bits(ulong n)
    long hits
    Point origin
    CLong tagged_value(read Tagged t)
    CULong long_bits()
}

// A variable of the C library: POSIX's, which Windows' C library does not have, so there it is
// not linked (the `if` on `OperatingSystem.isWindows()` below) and the program says so.
extern {
    int opterr
}

struct Point {
    int x
    int y
}

// C's `long` is `CLong`, its `unsigned long` `CULong`.
struct Tagged {
    byte tag
    CLong value
    CULong mask
}

void main() {
    long total = 0
    for i in 0..10 {
        total += unsafe square(i)
    }
    print(total)
    print(unsafe count_bits(0xff00ff))
    print(unsafe hits)
    unsafe {
        hits = 100
        hits += 1
    }
    print(unsafe hits)
    var p = unsafe origin
    print($"{p.x} {p.y}")
    unsafe {
        origin.y = 40
    }
    print(unsafe origin.y)
    if OperatingSystem.isWindows() {
        print("opterr: not in the C library of Windows")
    } else {
        unsafe {
            opterr = 1
        }
        print(unsafe opterr)
        unsafe {
            opterr = 0
        }
        print(unsafe opterr)
    }
    var tagged = Tagged { tag = 7, value = -5, mask = 0xffff }
    print(unsafe tagged_value(read tagged))
    print((ulong)unsafe long_bits() == (ulong)Memory.sizeOf<CLong>() * 8)
    print(bits.countBits(0xf0f0))
    print(bits.checksum("hello"))
}
