public struct Product : Formattable {
    public readonly string code
    public long price
    int quantity

    public Product create(string code, long price) {
        return Product { code = code, price = price, quantity = 0 }
    }

    public int available(read this) {
        return this.quantity
    }

    void recount(ref this, int quantity) {
        this.quantity = quantity
    }

    public void receive(ref this, int count) {
        this.recount(this.quantity + count)
    }
}

public enum Color : Formattable, Copyable {
    Red
    Green
    Custom(int rgb)

    // A method of a `public` enum is seen from outside only when it is `public` too.
    public int rgb(read this) {
        return match this {
            Red => this.channel(16)
            Green => this.channel(8)
            Custom(rgb) => rgb
        }
    }

    int channel(read this, int shift) {
        return 255 << shift
    }

    public Color gray() {
        return Color.Custom(0x808080)
    }
}

public struct Point : Copyable, Formattable {
    public int x
    public int y
}

struct Shelf {
    int row
}

int secret() {
    return 7
}
