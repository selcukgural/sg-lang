// The general category of a character, from the Unicode tables of the language (choice 1476):
// `c.category()` gives one. Written in SG and brought along by the language; only the lookup in
// the tables (`System.charCategory`) is the compiler's own.

// What Unicode says a character is. The names are Unicode's long names (`Uppercase_Letter`)
// written as SG writes a name; `abbreviation()` gives the short one (`Lu`), which `\p{Lu}` of a
// `Regex` takes. Surrogates have no variant: no `char` is one.
public enum UnicodeCategory : Copyable, Equatable, Hashable, Formattable {
    // Lu: `A`, `Ä`, `Σ`.
    UppercaseLetter
    // Ll: `a`, `ä`, `σ`.
    LowercaseLetter
    // Lt: a letter of two that begins a word in title case, `ǅ`.
    TitlecaseLetter
    // Lm: a letter that changes the one before it, `ʰ`.
    ModifierLetter
    // Lo: a letter with no case, `א`, `中`.
    OtherLetter
    // Mn: a mark that takes no room of its own, the combining acute accent U+0301.
    NonspacingMark
    // Mc: a mark that takes room, as the vowel signs of Devanagari.
    SpacingMark
    // Me: a mark around the character before it, U+20DD COMBINING ENCLOSING CIRCLE.
    EnclosingMark
    // Nd: a digit, `7`, `٣`.
    DecimalNumber
    // Nl: a number written as a letter, `Ⅻ`.
    LetterNumber
    // No: another number, `½`, `²`.
    OtherNumber
    // Pc: a mark that joins words, `_`.
    ConnectorPunctuation
    // Pd: a dash, `-`, `—`.
    DashPunctuation
    // Ps: an opening bracket, `(`, `[`, `{`.
    OpenPunctuation
    // Pe: a closing bracket, `)`, `]`, `}`.
    ClosePunctuation
    // Pi: an opening quotation mark, `«`, `“`.
    InitialPunctuation
    // Pf: a closing quotation mark, `»`, `”`.
    FinalPunctuation
    // Po: other punctuation, `!`, `,`, `.`.
    OtherPunctuation
    // Sm: a sign of mathematics, `+`, `=`, `∑`.
    MathSymbol
    // Sc: a currency sign, `$`, `€`, `₺`.
    CurrencySymbol
    // Sk: a sign that changes another, written alone, `^`, `` ` ``.
    ModifierSymbol
    // So: another symbol, `©`, `°`, an emoji.
    OtherSymbol
    // Zs: a space, ` `, U+00A0 NO-BREAK SPACE.
    SpaceSeparator
    // Zl: U+2028 LINE SEPARATOR.
    LineSeparator
    // Zp: U+2029 PARAGRAPH SEPARATOR.
    ParagraphSeparator
    // Cc: a control character, `\n`, `\t`.
    Control
    // Cf: a character that shapes text without being seen, U+200D ZERO WIDTH JOINER.
    Format
    // Co: a character of the private use areas, U+E000.
    PrivateUse
    // Cn: a code point Unicode has not given a character yet.
    Unassigned

    // The short name Unicode gives the category: `Lu` for `UppercaseLetter`.
    public read string abbreviation(this) {
        match this {
            UppercaseLetter => return "Lu"
            LowercaseLetter => return "Ll"
            TitlecaseLetter => return "Lt"
            ModifierLetter => return "Lm"
            OtherLetter => return "Lo"
            NonspacingMark => return "Mn"
            SpacingMark => return "Mc"
            EnclosingMark => return "Me"
            DecimalNumber => return "Nd"
            LetterNumber => return "Nl"
            OtherNumber => return "No"
            ConnectorPunctuation => return "Pc"
            DashPunctuation => return "Pd"
            OpenPunctuation => return "Ps"
            ClosePunctuation => return "Pe"
            InitialPunctuation => return "Pi"
            FinalPunctuation => return "Pf"
            OtherPunctuation => return "Po"
            MathSymbol => return "Sm"
            CurrencySymbol => return "Sc"
            ModifierSymbol => return "Sk"
            OtherSymbol => return "So"
            SpaceSeparator => return "Zs"
            LineSeparator => return "Zl"
            ParagraphSeparator => return "Zp"
            Control => return "Cc"
            Format => return "Cf"
            PrivateUse => return "Co"
            Unassigned => return "Cn"
        }
    }

    // `c.category()` of a `char`.
    UnicodeCategory of(char c) {
        match System.charCategory(c) {
            0 => return UnicodeCategory.UppercaseLetter
            1 => return UnicodeCategory.LowercaseLetter
            2 => return UnicodeCategory.TitlecaseLetter
            3 => return UnicodeCategory.ModifierLetter
            4 => return UnicodeCategory.OtherLetter
            5 => return UnicodeCategory.NonspacingMark
            6 => return UnicodeCategory.SpacingMark
            7 => return UnicodeCategory.EnclosingMark
            8 => return UnicodeCategory.DecimalNumber
            9 => return UnicodeCategory.LetterNumber
            10 => return UnicodeCategory.OtherNumber
            11 => return UnicodeCategory.ConnectorPunctuation
            12 => return UnicodeCategory.DashPunctuation
            13 => return UnicodeCategory.OpenPunctuation
            14 => return UnicodeCategory.ClosePunctuation
            15 => return UnicodeCategory.InitialPunctuation
            16 => return UnicodeCategory.FinalPunctuation
            17 => return UnicodeCategory.OtherPunctuation
            18 => return UnicodeCategory.MathSymbol
            19 => return UnicodeCategory.CurrencySymbol
            20 => return UnicodeCategory.ModifierSymbol
            21 => return UnicodeCategory.OtherSymbol
            22 => return UnicodeCategory.SpaceSeparator
            23 => return UnicodeCategory.LineSeparator
            24 => return UnicodeCategory.ParagraphSeparator
            25 => return UnicodeCategory.Control
            26 => return UnicodeCategory.Format
            27 => return UnicodeCategory.PrivateUse
            _ => return UnicodeCategory.Unassigned
        }
    }

    // Whether `code` is a character a reader does not see, or that turns or drives the text
    // around it (`UnicodeHiddenRanges`). A text from outside shown to a person (a line of `Log`,
    // the name of an entry of a zip archive, a key of JSON in an error) has them escaped.
    bool hides(int code) {
        if code < 0x80 {
            return code < 32 || code == 127
        }
        for i in 0..UnicodeHiddenRanges.length() / 2 {
            if code < UnicodeHiddenRanges[2 * i] {
                return false
            }
            if code <= UnicodeHiddenRanges[2 * i + 1] {
                return true
            }
        }
        return false
    }

    // `code` escaped: `\n`, `\r` and `\t` by their letter, others as `\u001b`, or `\u{e0041}`
    // past U+FFFF.
    void escape(ref string out, int code) {
        if code == '\n' {
            out.write("\\n")
        } else if code == '\r' {
            out.write("\\r")
        } else if code == '\t' {
            out.write("\\t")
        } else if code > 0xFFFF {
            out.write($"\\u{{{code:x}}}")
        } else {
            out.write($"\\u{code:x4}")
        }
    }
}

// The characters a reader does not see, or that turn or drive the text around them, as ranges
// (first, last): the control characters (C0, DEL, C1), the characters of format (Cf: the soft
// hyphen, the marks of direction and of no width, the tags), the separators of lines and
// paragraphs, and the fillers that show nothing. The selectors of variation of emoji (U+FE00 to
// U+FE0F) are left as they are. A text from outside shown to a person (a line of `Log`, the name of
// an entry of a zip archive, a key of JSON in an error) has them escaped.
const int[52] UnicodeHiddenRanges = {
    0x0000, 0x001F, 0x007F, 0x009F, 0x00AD, 0x00AD, 0x034F, 0x034F, 0x0600, 0x0605,
    0x061C, 0x061C, 0x06DD, 0x06DD, 0x070F, 0x070F, 0x0890, 0x0891, 0x08E2, 0x08E2,
    0x115F, 0x1160, 0x17B4, 0x17B5, 0x180B, 0x180F, 0x200B, 0x200F, 0x2028, 0x202E,
    0x2060, 0x206F, 0x3164, 0x3164, 0xFEFF, 0xFEFF, 0xFFA0, 0xFFA0, 0xFFF0, 0xFFFB,
    0x110BD, 0x110BD, 0x110CD, 0x110CD, 0x13430, 0x1343F, 0x1BCA0, 0x1BCA3, 0x1D173, 0x1D17A,
    0xE0000, 0xE0FFF
}
