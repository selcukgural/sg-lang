// Folders, and what the system knows of a file: `Directory`, `DirectoryEntry`, `FileInfo` and
// `FileKind`; `File.info(path)`, `File.linkInfo(path)`, `File.exists(path)`, `File.createTemp()`,
// `File.openTemp()` and `File.mapRead(path)` (`MappedFile`) are done here too, and `SeekFrom`, which
// `seek` takes, is here; `DirectoryRoot` is a folder that paths from outside do not lead out of.
// Written in SG and brought
// along by the language; only the calls of the system (`System.list`, `System.status` and the
// others) are the compiler's own, and only this module can call them.

// What a name in a folder is. `File.info` follows a link to what it points at, so only a listing of a
// folder and `File.linkInfo` tell a `Link`. On Windows a junction of folders is `Other`.
public enum FileKind : Copyable, Equatable, Hashable, Formattable {
    File
    Directory
    Link
    Other
}

// Where `seek` puts a reader or a writer of a file: so many bytes from the start of the file, from its
// end, or from where the stream stands. A place before the start is `InvalidInput`; one after the end
// is no error: a read there finds the end, and a write there leaves zero bytes before what it writes.
public enum SeekFrom : Copyable, Equatable, Formattable {
    Start(long offset)
    End(long offset)
    Current(long offset)
}

// The kind as the system call gives it.
FileKind kindOf(long code) {
    match code {
        0 => return FileKind.File
        1 => return FileKind.Directory
        2 => return FileKind.Link
        _ => return FileKind.Other
    }
}

// What the system said of a file, in the order of `System.status`.
FileInfo infoOf(read long[] fields) {
    return FileInfo { kind = kindOf(fields[0]), size = fields[1], modified = DateTime { ns = fields[2] }, permissions = (int)fields[3] }
}

// What the system knows of a file or a folder: `File.info(path)`.
public struct FileInfo : Copyable, Equatable, Formattable {
    public readonly FileKind kind
    // In bytes. Of a link itself (`File.linkInfo`), the length of what it holds on Linux and macOS,
    // and 0 on Windows.
    public readonly long size
    // When what it holds was last written.
    public readonly DateTime modified
    // The bits of the mode of Unix, from 0 to 0o7777: `0o644` is a file its owner reads and writes
    // and the others read. On Windows a file is `0o666`, or `0o444` when it may only be read, and
    // a folder `0o777` or `0o555` (choice 1978).
    public readonly int permissions

    // `File.info(path)`: a link is followed to what it points at.
    Result<FileInfo, IoError> of(read string path) {
        var fields = long[4]
        try System.status(path, ref fields)
        return Ok(infoOf(read fields))
    }

    // `File.linkInfo(path)`: what the system knows of the path itself. A link is not followed, and
    // is of the kind `Link` (choice 1976).
    Result<FileInfo, IoError> ofLink(read string path) {
        var fields = long[4]
        try System.linkStatus(path, ref fields)
        return Ok(infoOf(read fields))
    }

    // `reader.info()`: what the system knows of the file the reader reads, asked of the open file, so
    // what it says is of that file even when its path has been given to another since (1873).
    Result<FileInfo, IoError> ofReader(read StreamReader reader) {
        var fields = long[4]
        try System.readerStatus(read reader, ref fields)
        return Ok(infoOf(read fields))
    }

    // `File.createTemp()`: a new empty file with a name nobody else has, inside `Directory.temp()`, that
    // only the user of the program can read and write, and gives its path. Removing it is the
    // program's work (`File.delete`).
    Result<string, IoError> makeTemp() {
        var folder = Directory.temp()
        var template = Path.join(read folder, "sg-XXXXXX")
        return System.makeTempFile(read template)
    }

    // `File.openTemp()`: a writer of a new file that has no name, inside `Directory.temp()`, opened
    // to be read too: `writer.openReader()` gives a reader of it (choices 2074 and 2076). The file
    // is gone when its last stream is closed, also when the program is ended from outside before
    // that. On Windows a name is seen in the folder while it is open.
    Result<StreamWriter, IoError> openTemp() {
        var folder = Directory.temp()
        var template = Path.join(read folder, "sg-XXXXXX")
        return System.openTemp(read template)
    }

    // `File.exists(path)`: whether the path names a file, a link followed. A folder is not a file, and
    // a path that cannot be looked at (the permission of a folder on the way) is not there either.
    bool isFile(read string path) {
        return isKind(path, 0)
    }

    // `File.infoAsync(path)`, `File.existsAsync(path)` and `File.createTempAsync()`: the same, for an
    // async function, the system asked on a thread of input and output while the task waits (1871).
    async Result<FileInfo, IoError> ofAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var fields = long[4]
        try await System.statusAsync(path, ref fields, read token)
        return Ok(infoOf(read fields))
    }

    async Result<FileInfo, IoError> ofLinkAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var fields = long[4]
        try await System.linkStatusAsync(path, ref fields, read token)
        return Ok(infoOf(read fields))
    }

    async bool isFileAsync(read string path, read CancellationToken token = CancellationToken.None) {
        return await isKindAsync(path, 0, read token)
    }

    async Result<string, IoError> makeTempAsync(read CancellationToken token = CancellationToken.None) {
        var folder = Directory.temp()
        var template = Path.join(read folder, "sg-XXXXXX")
        return await System.makeTempFileAsync(read template, read token)
    }

    async Result<StreamWriter, IoError> openTempAsync(read CancellationToken token = CancellationToken.None) {
        var folder = Directory.temp()
        var template = Path.join(read folder, "sg-XXXXXX")
        return await System.openTempAsync(read template, read token)
    }
}

bool isKind(read string path, long kind) {
    var fields = long[4]
    if System.status(path, ref fields) is Error(_) {
        return false
    }
    return fields[0] == kind
}

async bool isKindAsync(read string path, long kind, read CancellationToken token) {
    var fields = long[4]
    if await System.statusAsync(path, ref fields, read token) is Error(_) {
        return false
    }
    return fields[0] == kind
}

// The bytes of a file put in the memory of the program to be read: `try unsafe File.mapRead(path)`
// (choice 1980). The system reads a page of the file from the disk when it is first read, and keeps
// it with the files it has read; nothing is copied. Where the value ends the file is taken out of
// the memory again. It is `unsafe` because the bytes are the file's as it is on the disk: another
// program that writes into the file changes them while they are read, and one that cuts it short
// stops this one when it reads past the new end (`SIGBUS`). An empty file gives no bytes.
public struct MappedFile : Disposable, unsafe Sendable {
    raw byte data
    long length

    // `File.mapRead(path)`.
    Result<MappedFile, IoError> open(read string path) {
        var length = long[1]
        var data = try System.mapRead(path, ref length)
        return Ok(MappedFile { data = data, length = length[0] })
    }

    async Result<MappedFile, IoError> openAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var length = long[1]
        var data = try await System.mapReadAsync(path, ref length, read token)
        return Ok(MappedFile { data = data, length = length[0] })
    }

    // The bytes of the file, as long as this value lives.
    public read byte[] bytes(read this) from this {
        return unsafe Memory.view(this.data, (nint)this.length)
    }

    void dispose(ref this) {
        System.unmap(this.data, this.length)
    }
}

// The lock of a file waited for by an async task: `stream.lockAsync()` and `stream.lockSharedAsync()`
// (choices 1979, 1983). The lock is tried, and while another holds it the task waits a little on the
// clock, from 1 ms up to 10, and tries again: a cancel ends the wait at once, and no lock is taken
// after it. No thread is held; the order in which programs waited is not kept.
struct FileLock {
    async Result<void, IoError> reader(ref StreamReader reader, bool together) {
        var pause = 1
        while true {
            var got = false
            if together {
                got = try reader.tryLockShared()
            } else {
                got = try reader.tryLock()
            }
            if got {
                return Ok()
            }
            await Task.delay(pause)
            pause = longer(pause)
        }
    }

    async Result<void, IoError> readerTold(ref StreamReader reader, bool together, read CancellationToken token) {
        var pause = 1
        while true {
            if token.isCancelled() {
                return Error(IoError.Cancelled(Cancelled { }))
            }
            var got = false
            if together {
                got = try reader.tryLockShared()
            } else {
                got = try reader.tryLock()
            }
            if got {
                return Ok()
            }
            if await Task.delay(pause, read token) is Error(cancelled) {
                return Error(IoError.Cancelled(cancelled))
            }
            pause = longer(pause)
        }
    }

    async Result<void, IoError> writer(ref StreamWriter writer, bool together) {
        var pause = 1
        while true {
            var got = false
            if together {
                got = try writer.tryLockShared()
            } else {
                got = try writer.tryLock()
            }
            if got {
                return Ok()
            }
            await Task.delay(pause)
            pause = longer(pause)
        }
    }

    async Result<void, IoError> writerTold(ref StreamWriter writer, bool together, read CancellationToken token) {
        var pause = 1
        while true {
            if token.isCancelled() {
                return Error(IoError.Cancelled(Cancelled { }))
            }
            var got = false
            if together {
                got = try writer.tryLockShared()
            } else {
                got = try writer.tryLock()
            }
            if got {
                return Ok()
            }
            if await Task.delay(pause, read token) is Error(cancelled) {
                return Error(IoError.Cancelled(cancelled))
            }
            pause = longer(pause)
        }
    }
}

// The next pause of a lock waited for: twice the last, at most 10 ms.
int longer(int pause) {
    if pause >= 5 {
        return 10
    }
    return pause * 2
}

// A name in a folder and what it is, as `Directory.list` gives it.
public struct DirectoryEntry : Equatable, Formattable {
    // The name alone, without the folder: `Path.join(folder, entry.name)` is the path.
    public readonly string name
    public readonly FileKind kind
}

// The folders of the system. Each function takes the path of a folder and asks the system, so what it
// says can be different the next moment: to use a file, open it and look at the error, rather than
// asking first whether it is there.
public struct Directory {
    // Makes the folder; the one it is in must be there. A folder or a file already there is
    // `AlreadyExists`.
    public Result<void, IoError> create(read string path) {
        return System.createDirectory(path)
    }

    // Makes the folder and every folder on the way that is not there yet. A folder already there is no
    // error; a file in the way is.
    public Result<void, IoError> createAll(read string path) {
        match System.createDirectory(path) {
            Ok => return Ok()
            Error(cause) => {
                if cause == IoError.AlreadyExists && Directory.exists(path) {
                    return Ok()
                }
                if cause != IoError.NotFound {
                    return Error(cause)
                }
            }
        }
        var parent = Path.parent(path)
        if parent.length() == 0 || parent == path {
            return Error(IoError.NotFound)
        }
        try Directory.createAll(parent)
        match System.createDirectory(path) {
            Ok => return Ok()
            Error(cause) => {
                if cause == IoError.AlreadyExists && Directory.exists(path) {
                    return Ok()
                }
                return Error(cause)
            }
        }
    }

    // Removes the folder, which must be empty (`DirectoryNotEmpty`).
    public Result<void, IoError> delete(read string path) {
        return System.removeDirectory(path)
    }

    // Removes the folder and all it holds. A link inside is removed, not followed, and so is a link that
    // takes the place of a folder while this works; a path that is itself a link is `NotDirectory`.
    public Result<void, IoError> deleteAll(read string path) {
        return System.removeAll(path)
    }

    // Puts the names the folder holds on the disk, so that a file made, renamed or removed in it
    // stays so if the machine stops: after `File.replace` of a file written and synced, the new
    // name is not certain until its folder is synced too. On Windows, which keeps the names with
    // the files, it does nothing but tell a path that is not a folder (`NotDirectory`).
    public Result<void, IoError> sync(read string path) {
        return System.syncDirectory(path)
    }

    // The names in the folder, without `.` and `..`, in the order of their bytes: the same on every
    // system. A name that is not UTF-8 comes as `Path.systemBytes` reads it (choice 1950), and opens
    // the same file.
    public Result<List<DirectoryEntry>, IoError> list(read string path) {
        var names = List<string>()
        var kinds = List<byte>()
        try System.list(path, ref names, ref kinds)
        var entries = List<DirectoryEntry>()
        var at = 0
        for name in names {
            entries.add(DirectoryEntry { name = name, kind = kindOf((long)kinds[at]) })
            at += 1
        }
        return Ok(entries)
    }

    // Whether the path names a folder, a link followed.
    public bool exists(read string path) {
        return isKind(path, 1)
    }

    // The folder the program works in. It is not changed from inside: every thread of the program would
    // see it change.
    public Result<string, IoError> current() {
        return System.current()
    }

    // The folder for files that do not have to stay: `TMPDIR` as it is written, or `/tmp`. On Windows
    // the folder Windows gives (`TMP`, `TEMP`, or the user's own), without the `\` at its end.
    public string temp() {
        if OperatingSystem.isWindows() {
            return System.tempFolder() ?? "C:\\Windows\\Temp"
        }
        if Environment.get("TMPDIR") is Ok(folder) && folder.length() > 0 {
            return folder.clone()
        }
        return "/tmp"
    }

    // Makes a new folder with a name nobody else has, inside `Directory.temp()`, that only the user of
    // the program can go into, and gives its path. Removing it is the program's work
    // (`Directory.deleteAll`).
    public Result<string, IoError> createTemp() {
        var folder = Directory.temp()
        var template = Path.join(read folder, "sg-XXXXXX")
        return System.makeTemp(read template)
    }

    // The same for an async function (1871): each asks the system on a thread of input and output
    // while the task waits, and gives `IoError.Cancelled` for a token cancelled before. `current`
    // and `temp` ask nothing of the disk and are called as they are.

    public async Result<void, IoError> createAsync(read string path, read CancellationToken token = CancellationToken.None) {
        return await System.createDirectoryAsync(path, read token)
    }

    // As `createAll`, going up the path to the first folder there and making those below it in a
    // loop, since an async function does not await itself.
    public async Result<void, IoError> createAllAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var missing = List<string>()
        var at = path.clone()
        while true {
            match await System.createDirectoryAsync(read at, read token) {
                Ok => break
                Error(cause) => {
                    if cause == IoError.AlreadyExists && await Directory.existsAsync(read at, read token) {
                        break
                    }
                    if cause != IoError.NotFound {
                        return Error(cause)
                    }
                }
            }
            var parent = Path.parent(read at)
            if parent.length() == 0 || parent == at {
                return Error(IoError.NotFound)
            }
            var up = parent.clone()
            missing.add(at)
            at = up
        }
        var i = missing.length()
        while i > 0 {
            i -= 1
            match await System.createDirectoryAsync(read missing[i], read token) {
                Ok => {}
                Error(cause) => {
                    if cause != IoError.AlreadyExists || !await Directory.existsAsync(read missing[i], read token) {
                        return Error(cause)
                    }
                }
            }
        }
        return Ok()
    }

    public async Result<void, IoError> deleteAsync(read string path, read CancellationToken token = CancellationToken.None) {
        return await System.removeDirectoryAsync(path, read token)
    }

    public async Result<void, IoError> deleteAllAsync(read string path, read CancellationToken token = CancellationToken.None) {
        return await System.removeAllAsync(path, read token)
    }

    public async Result<void, IoError> syncAsync(read string path, read CancellationToken token = CancellationToken.None) {
        return await System.syncDirectoryAsync(path, read token)
    }

    public async Result<List<DirectoryEntry>, IoError> listAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var names = List<string>()
        var kinds = List<byte>()
        try await System.listAsync(path, ref names, ref kinds, read token)
        var entries = List<DirectoryEntry>()
        var at = 0
        for name in names {
            entries.add(DirectoryEntry { name = name, kind = kindOf((long)kinds[at]) })
            at += 1
        }
        return Ok(entries)
    }

    public async bool existsAsync(read string path, read CancellationToken token = CancellationToken.None) {
        return await isKindAsync(path, 1, read token)
    }

    public async Result<string, IoError> createTempAsync(read CancellationToken token = CancellationToken.None) {
        var folder = Directory.temp()
        var template = Path.join(read folder, "sg-XXXXXX")
        return await System.makeTempAsync(read template, read token)
    }

    // Watches the folder: from when it returns, each name made in it, deleted from it or written
    // comes to the `DirectoryWatcher` it gives (choices 2056-2065). What is in the folders in it
    // is not watched; `watchAll` watches that too. What is there already is not told. A file
    // is `NotDirectory`.
    public Result<DirectoryWatcher, IoError> watch(read string path) {
        var id = try System.watchStart(path, false)
        return Ok(DirectoryWatcher.of(path, id))
    }

    // `watch` of the folder and of every folder in it, however deep, and of those made or moved
    // into it later: what is in a folder that comes in is told as made, each name. A link to a
    // folder is a name, and what it points at is not watched.
    public Result<DirectoryWatcher, IoError> watchAll(read string path) {
        var id = try System.watchStart(path, true)
        return Ok(DirectoryWatcher.of(path, id))
    }

    public async Result<DirectoryWatcher, IoError> watchAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var id = try await System.watchStartAsync(path, false, read token)
        return Ok(DirectoryWatcher.of(path, id))
    }

    public async Result<DirectoryWatcher, IoError> watchAllAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var id = try await System.watchStartAsync(path, true, read token)
        return Ok(DirectoryWatcher.of(path, id))
    }

    // Opens the folder to be the root of paths that come from outside the program (choices 2066 to
    // 2071): what the `DirectoryRoot` it gives opens, lists, makes and removes lies inside the
    // folder, whatever the path says and whatever links the folder holds. The path of the folder
    // itself is found as any path is, a link followed. A file is `NotDirectory`.
    public Result<DirectoryRoot, IoError> openRoot(read string path) {
        var handle = try System.rootOpen(-1, path)
        return Ok(DirectoryRoot { handle = handle })
    }

    public async Result<DirectoryRoot, IoError> openRootAsync(read string path, read CancellationToken token = CancellationToken.None) {
        var handle = try await System.rootOpenAsync(-1, path, read token)
        return Ok(DirectoryRoot { handle = handle })
    }
}

// A folder held open, and the only place its paths lead to (`Directory.openRoot`, choices 2066 to
// 2071). A path is written with `/` and counted from the folder: `2026/report.txt`. A link on the
// way is followed while what it points at stays inside the folder; a path that leads out of it
// is `OutsideRoot`: one that starts at the root of the system (`/etc`), one that climbs past the
// folder with `..`, and one that goes through a link that does either. `.` and `..` that stay
// inside are parts as any other. A name that one of the systems cannot keep inside a folder is
// `InvalidInput` on all of them, as for `Path.joinInside`: an empty path or an empty part
// (`a//b`, `a/`), a `\` or a `:`, a control character, a part that ends with `.` or a space, and
// the name of a device of Windows (`CON`, `nul.txt`).
// The folder is held, not its path: when it is renamed or moved the root is still that folder,
// and a folder put where it was is another. Other programs that change the folder while a path
// is walked cannot lead the walk out. Several tasks may use one root at once.
public struct DirectoryRoot : Disposable {
    // The handle of the folder.
    long handle

    // What no system may be given as a path under a folder (choice 2070): `InvalidInput` for a `\\`
    // or a `:` anywhere, then `OutsideRoot` for a path that starts at the root of the system, then
    // `InvalidInput` for a part that is no name on every system. One pass over the bytes: this is
    // asked before every call of a root.
    Result<void, IoError> named(read string path) {
        var bytes = path.asBytes()
        var count = bytes.length()
        if count == 0 {
            return Error(IoError.InvalidInput)
        }
        var outside = (int)bytes[0] == (int)'/'
        var bad = false
        nint start = 0
        for at in 0..count {
            var b = (int)bytes[at]
            if b == (int)'\\' || b == (int)':' {
                return Error(IoError.InvalidInput)
            }
            if b == (int)'/' {
                if !DirectoryRoot.isPart(path, start, at) {
                    bad = true
                }
                start = at + 1
            } else if b < 32 || b == 127 || (b == 0xC2 && at + 1 < count && (int)bytes[at + 1] >= 0x80 && (int)bytes[at + 1] < 0xA0) {
                // A control character: C0, DEL, and C1, which UTF-8 writes as C2 80 to C2 9F.
                bad = true
            }
        }
        if outside {
            return Error(IoError.OutsideRoot)
        }
        if bad || !DirectoryRoot.isPart(path, start, count) {
            return Error(IoError.InvalidInput)
        }
        return Ok()
    }

    // Whether the bytes of the path from `start` to `end` are a part every system keeps inside a
    // folder, as `Path.staysInside` says of a part, but for `.` and `..`, which are parts here: not
    // empty, not ended by `.` or a space, and not the name of a device of Windows, which all start
    // with one of five letters.
    bool isPart(read string path, nint start, nint end) {
        var bytes = path.asBytes()
        var n = end - start
        if n == 0 {
            return false
        }
        var last = (int)bytes[end - 1]
        if last == (int)' ' {
            return false
        }
        if last == (int)'.' {
            return n == 1 || (n == 2 && (int)bytes[start] == (int)'.')
        }
        // Lower case of an ASCII letter.
        var first = (int)bytes[start] | 32
        if first == (int)'c' || first == (int)'p' || first == (int)'a' || first == (int)'n' || first == (int)'l' {
            return !Path.isDevice(path[start..end])
        }
        return true
    }

    // A reader of the file, as `File.openText` gives.
    public Result<StreamReader, IoError> openText(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootReader(this.handle, path, false)
    }

    // The same, but only of a regular file, as `File.openRegular`: a folder is `IsDirectory`, and
    // a pipe, a device or a socket `NotAFile`, refused before it is opened.
    public Result<StreamReader, IoError> openRegular(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootReader(this.handle, path, true)
    }

    // A writer of the file, which is made or emptied, as `File.createText` gives.
    public Result<StreamWriter, IoError> createText(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootWriter(this.handle, path, 1)
    }

    // A writer that writes after what the file holds, as `File.openAppend` gives.
    public Result<StreamWriter, IoError> openAppend(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootWriter(this.handle, path, 2)
    }

    // A writer from the start of the file over what it holds, as `File.openWrite` gives.
    public Result<StreamWriter, IoError> openWrite(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootWriter(this.handle, path, 3)
    }

    // What the system knows of the path, a link followed, as `File.info`.
    public Result<FileInfo, IoError> info(read this, read string path) {
        try DirectoryRoot.named(path)
        var fields = long[4]
        try System.rootStatus(this.handle, path, true, ref fields)
        return Ok(infoOf(read fields))
    }

    // What the system knows of the path itself, a link at its end not followed, as
    // `File.linkInfo`. A link that points out of the folder can be looked at so, and removed.
    public Result<FileInfo, IoError> linkInfo(read this, read string path) {
        try DirectoryRoot.named(path)
        var fields = long[4]
        try System.rootStatus(this.handle, path, false, ref fields)
        return Ok(infoOf(read fields))
    }

    // Whether the path names something inside the folder, a file or a folder, a link followed.
    // What cannot be looked at, or lies outside, is not there.
    public bool exists(read this, read string path) {
        return this.info(path) is Ok(_)
    }

    // The names in the folder at the path, as `Directory.list`; `.` is the root itself.
    public Result<List<DirectoryEntry>, IoError> list(read this, read string path) {
        try DirectoryRoot.named(path)
        var names = List<string>()
        var kinds = List<byte>()
        try System.rootList(this.handle, path, ref names, ref kinds)
        return Ok(entriesOf(read names, read kinds))
    }

    // Makes the folder; the one it is in must be there, as for `Directory.create`.
    public Result<void, IoError> createDirectory(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootMake(this.handle, path)
    }

    // Removes the file, or the link itself when the path ends at one. A folder is `IsDirectory`.
    public Result<void, IoError> delete(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootRemove(this.handle, path, false)
    }

    // Removes the folder, which must be empty (`DirectoryNotEmpty`). The root itself is not
    // removed through itself (`InvalidInput`).
    public Result<void, IoError> deleteDirectory(read this, read string path) {
        try DirectoryRoot.named(path)
        return System.rootRemove(this.handle, path, true)
    }

    // A folder inside this one opened as a root of its own: what it gives stays inside that
    // folder.
    public Result<DirectoryRoot, IoError> openRoot(read this, read string path) {
        try DirectoryRoot.named(path)
        var handle = try System.rootOpen(this.handle, path)
        return Ok(DirectoryRoot { handle = handle })
    }

    // The same for an async function: the system is asked on a thread of input and output
    // while the task waits, and a token cancelled before gives `IoError.Cancelled`.

    public async Result<StreamReader, IoError> openTextAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootReaderAsync(this.handle, path, false, read token)
    }

    public async Result<StreamReader, IoError> openRegularAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootReaderAsync(this.handle, path, true, read token)
    }

    public async Result<StreamWriter, IoError> createTextAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootWriterAsync(this.handle, path, 1, read token)
    }

    public async Result<StreamWriter, IoError> openAppendAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootWriterAsync(this.handle, path, 2, read token)
    }

    public async Result<StreamWriter, IoError> openWriteAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootWriterAsync(this.handle, path, 3, read token)
    }

    public async Result<FileInfo, IoError> infoAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        var fields = long[4]
        try await System.rootStatusAsync(this.handle, path, true, ref fields, read token)
        return Ok(infoOf(read fields))
    }

    public async Result<FileInfo, IoError> linkInfoAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        var fields = long[4]
        try await System.rootStatusAsync(this.handle, path, false, ref fields, read token)
        return Ok(infoOf(read fields))
    }

    public async bool existsAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        if DirectoryRoot.named(path) is Error(_) {
            return false
        }
        var fields = long[4]
        if await System.rootStatusAsync(this.handle, path, true, ref fields, read token) is Error(_) {
            return false
        }
        return true
    }

    public async Result<List<DirectoryEntry>, IoError> listAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        var names = List<string>()
        var kinds = List<byte>()
        try await System.rootListAsync(this.handle, path, ref names, ref kinds, read token)
        return Ok(entriesOf(read names, read kinds))
    }

    public async Result<void, IoError> createDirectoryAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootMakeAsync(this.handle, path, read token)
    }

    public async Result<void, IoError> deleteAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootRemoveAsync(this.handle, path, false, read token)
    }

    public async Result<void, IoError> deleteDirectoryAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        return await System.rootRemoveAsync(this.handle, path, true, read token)
    }

    public async Result<DirectoryRoot, IoError> openRootAsync(read this, read string path, read CancellationToken token = CancellationToken.None) {
        try DirectoryRoot.named(path)
        var handle = try await System.rootOpenAsync(this.handle, path, read token)
        return Ok(DirectoryRoot { handle = handle })
    }

    void dispose(ref this) {
        System.rootClose(this.handle)
    }
}

// The entries of a listing, as `System.list` and `System.rootList` give them.
List<DirectoryEntry> entriesOf(read List<string> names, read List<byte> kinds) {
    var entries = List<DirectoryEntry>()
    var at = 0
    for name in names {
        entries.add(DirectoryEntry { name = name.clone(), kind = kindOf((long)kinds[at]) })
        at += 1
    }
    return entries
}

// What a `DirectoryWatcher` was told of a name under its folder. The path is the folder as it was
// given joined with the name: `Path.join("logs", "today.txt")`. A name renamed or moved is
// `Deleted` at the old path and `Created` at the new one, on every system, since not every
// system can tell which two go together. `Changed` is a file written or its attributes changed;
// a folder is never `Changed`. `Lost`: the system, or the watcher, kept no more changes because
// they came faster than the program took them; what changed under that path is to be found by
// listing it again. A file made and at once written may come as made and changed, or only as
// made; one made as its folder came in may come twice as made.
public enum FileChange : Equatable, Formattable {
    Created(string path)
    Deleted(string path)
    Changed(string path)
    Lost(string path)
}

// What `Directory.watch` and `Directory.watchAll` give: the changes under the folder that came and
// were not taken yet, in the order they came. The same change twice in a row before it is taken is
// one. At most 16384 wait; beyond that they are dropped, and one `Lost` of the folder says so. When
// the folder itself is deleted or moved away, `next` gives what came before, then `NotFound`. Ending
// the watcher stops the watching.
public struct DirectoryWatcher : Disposable {
    // The watcher of the system.
    long id
    // The folder as it was given.
    string folder
    // Changes taken from the system and not given yet, from `at` on.
    List<string> names
    List<byte> kinds
    nint at

    DirectoryWatcher of(read string folder, long id) {
        return DirectoryWatcher { id = id, folder = folder.clone(), names = List<string>(), kinds = List<byte>(), at = 0 }
    }

    // Waits for the next change and gives it; one that came before is given at once.
    public Result<FileChange, IoError> next(ref this) {
        if this.at == this.names.length() {
            this.names.clear()
            this.kinds.clear()
            this.at = 0
            try System.watchNext(this.id, true, ref this.names, ref this.kinds)
        }
        return Ok(this.take())
    }

    // `next` without holding the thread, for an async function. A cancel ends the wait
    // (`IoError.Cancelled`); a change that comes later stays for the next call, and a token
    // cancelled already takes nothing.
    public async Result<FileChange, IoError> nextAsync(ref this, read CancellationToken token = CancellationToken.None) {
        try token.check()
        while this.at == this.names.length() {
            this.names.clear()
            this.kinds.clear()
            this.at = 0
            try System.watchNext(this.id, false, ref this.names, ref this.kinds)
            if this.names.length() == 0 {
                try await System.watchWaitAsync(this.id, read token)
            }
        }
        return Ok(this.take())
    }

    FileChange take(ref this) {
        var path = Path.join(read this.folder, read this.names[this.at])
        var kind = this.kinds[this.at]
        this.at += 1
        match kind {
            0 => return FileChange.Created(path)
            1 => return FileChange.Deleted(path)
            2 => return FileChange.Changed(path)
            _ => return FileChange.Lost(path)
        }
    }

    void dispose(ref this) {
        System.watchStop(this.id)
    }
}
