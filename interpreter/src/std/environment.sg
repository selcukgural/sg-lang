// The variables of the environment the program was started with. They are read, never set: setting
// one while another thread reads one is not safe in C, and a program that runs another gives it an
// environment of its own. Written in SG and brought along by the language; only the reading of a
// variable (`System.variable`) is the compiler's own, and only this module can call it.

// Why `Environment.get` gave no text.
public enum VariableError : Copyable, Equatable, Hashable, Formattable {
    // The variable is not set.
    Missing
}

public struct Environment {
    // The text of the variable: `Environment.get("HOME") ?? "/"`. A name and a value are names of
    // the system (choice 1950): what is not UTF-8 in them is written as `Path.systemBytes` reads it.
    public Result<string, VariableError> get(read string name) {
        var bytes = List<byte>()
        if !System.variable(name, ref bytes) {
            return Error(VariableError.Missing)
        }
        return Ok(System.nameText(read bytes))
    }
}
