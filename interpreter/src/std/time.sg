// The clock: a span of time (`Duration`), a moment of a monotonic clock (`Instant`), a moment of
// the calendar in UTC (`DateTime`), and one seen at an offset from UTC (`DateTimeOffset`). Written
// in SG and brought along by the language; a program that names one of these types gets this
// module, seen from every module with nothing written. Only the readings of the clock and of the
// time zone of the system (`Clock.monotonic()`, `Clock.wall()`, `Clock.offsetAt(seconds)`) are the
// compiler's own, and only this module can call them.

// A span of time, in nanoseconds; it may be negative. The arithmetic follows the rule of the
// numbers: an overflow is a panic in a debug build and in a test, and wraps in a release build.
public struct Duration : Copyable, Equatable, Hashable, Comparable, Formattable {
    long ns

    public Duration fromNanoseconds(long count) {
        return Duration { ns = count }
    }

    public Duration fromMicroseconds(long count) {
        return Duration { ns = count * 1000 }
    }

    public Duration fromMilliseconds(long count) {
        return Duration { ns = count * 1000000 }
    }

    public Duration fromSeconds(long count) {
        return Duration { ns = count * 1000000000 }
    }

    // The whole units in the span, cut toward zero.
    public long nanoseconds(read this) {
        return this.ns
    }

    public long microseconds(read this) {
        return this.ns / 1000
    }

    public long milliseconds(read this) {
        return this.ns / 1000000
    }

    public long seconds(read this) {
        return this.ns / 1000000000
    }

    // The span in seconds, with the fraction.
    public double totalSeconds(read this) {
        return (double)this.ns / 1000000000.0
    }

    public Duration plus(read this, Duration other) {
        return Duration { ns = this.ns + other.ns }
    }

    public Duration minus(read this, Duration other) {
        return Duration { ns = this.ns - other.ns }
    }

    public Duration times(read this, long factor) {
        return Duration { ns = this.ns * factor }
    }

    public int compare(read this, read Duration other) {
        return this.ns.compare(other.ns)
    }

    // In the unit its size calls for, with the fewest digits after the point: `1.5s`, `250ms`,
    // `3µs`, `-2ms`, `0s`. Seconds stay seconds: `90s`.
    public void format(read this, ref Formatter f) {
        if this.ns == 0 {
            f.write("0s")
            return
        }
        // The unit is chosen on the size without negating it, since the most negative span has
        // no positive one.
        long unit = 1000000000
        int width = 9
        if this.ns > -1000 && this.ns < 1000 {
            unit = 1
            width = 0
        } else if this.ns > -1000000 && this.ns < 1000000 {
            unit = 1000
            width = 3
        } else if this.ns > -1000000000 && this.ns < 1000000000 {
            unit = 1000000
            width = 6
        }
        var whole = this.ns / unit
        var part = this.ns % unit
        if this.ns < 0 {
            f.write("-")
            whole = -whole
            part = -part
        }
        f.write(whole)
        if part != 0 {
            while part % 10 == 0 {
                part = part / 10
                width -= 1
            }
            f.write(".")
            var shown = digits(part)
            while shown < width {
                f.write("0")
                shown += 1
            }
            f.write(part)
        }
        if unit == 1 {
            f.write("ns")
        } else if unit == 1000 {
            f.write("µs")
        } else if unit == 1000000 {
            f.write("ms")
        } else {
            f.write("s")
        }
    }
}

// A moment of the monotonic clock: it never goes back and nothing sets it. Only the distance
// between two moments means something, so it is not printed. On Linux and macOS it stops while
// the machine sleeps, as Rust's `Instant`; on Windows it goes on (choice 1674).
public struct Instant : Copyable, Equatable, Hashable, Comparable {
    long ns

    public Instant now() {
        return Instant { ns = Clock.monotonic() }
    }

    // The time gone by since this moment.
    public Duration elapsed(read this) {
        return Duration { ns = Clock.monotonic() - this.ns }
    }

    // The time from `earlier` to this moment; negative when `earlier` is later.
    public Duration since(read this, Instant earlier) {
        return Duration { ns = this.ns - earlier.ns }
    }

    public Instant plus(read this, Duration span) {
        return Instant { ns = this.ns + span.ns }
    }

    public Instant minus(read this, Duration span) {
        return Instant { ns = this.ns - span.ns }
    }

    public int compare(read this, read Instant other) {
        return this.ns.compare(other.ns)
    }
}

public enum DayOfWeek : Copyable, Equatable, Hashable, Formattable {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

// The part of a date or a time that `DateTime.utc` was given wrong, a moment outside the years
// a `DateTime` holds, an offset from UTC of a day or more or with a part of a second, a time the
// clocks of the place skipped (`DateTimeOffset.local`), or where a text stops being one that
// `parse` reads.
public enum DateError : Copyable, Equatable, Hashable, Formattable {
    InvalidMonth
    InvalidDay
    InvalidHour
    InvalidMinute
    InvalidSecond
    OutOfRange
    InvalidOffset
    SkippedLocalTime
    InvalidText(nint position)
}

// A moment of the calendar in UTC: the nanoseconds since 1970-01-01T00:00:00Z, as the clock of
// the system counts them, without leap seconds. It holds the years 1677 to 2262. The calendar is
// the Gregorian one, also before it was in use.
public struct DateTime : Copyable, Equatable, Hashable, Comparable, Formattable {
    long ns

    // The clock of the system: it can be set, and can go back.
    public DateTime now() {
        return DateTime { ns = Clock.wall() }
    }

    public DateTime fromUnixSeconds(long seconds) {
        return DateTime { ns = seconds * 1000000000 }
    }

    public DateTime fromUnixMilliseconds(long milliseconds) {
        return DateTime { ns = milliseconds * 1000000 }
    }

    public Result<DateTime, DateError> utc(int year, int month, int day, int hour, int minute, int second) {
        var seconds = try civilSeconds(year, month, day, hour, minute, second)
        if !holdsSeconds(seconds, 0) {
            return Error(DateError.OutOfRange)
        }
        return Ok(DateTime { ns = seconds * 1000000000 })
    }

    // A moment written in RFC 3339, as `DateTimeOffset.parse` reads it, taken to UTC:
    // `2026-11-18T12:30:05+03:00` is `2026-11-18T09:30:05Z`.
    public Result<DateTime, DateError> parse(read string text) {
        var seen = try DateTimeOffset.parse(text)
        return Ok(seen.toUtc())
    }

    // The moment seen at the offset of the time zone of the system then (`TZ` and
    // `/etc/localtime` on Linux and macOS; on Windows the zone set in Windows).
    public DateTimeOffset toLocal(read this) {
        return DateTimeOffset { ns = this.ns, ahead = Clock.offsetAt(floorDivide(this.ns, 1000000000)) }
    }

    // The moment seen at an offset from UTC: `InvalidOffset` for a day or more either way, or a
    // part of a second.
    public Result<DateTimeOffset, DateError> withOffset(read this, Duration offset) {
        if offset.ns % 1000000000 != 0 || offset.ns <= -86400000000000 || offset.ns >= 86400000000000 {
            return Error(DateError.InvalidOffset)
        }
        return Ok(DateTimeOffset { ns = this.ns, ahead = (int)(offset.ns / 1000000000) })
    }

    // The seconds since 1970, rounded down: a moment before 1970 with a fraction counts the
    // second it lies in.
    public long unixSeconds(read this) {
        return floorDivide(this.ns, 1000000000)
    }

    public long unixMilliseconds(read this) {
        return floorDivide(this.ns, 1000000)
    }

    public int year(read this) {
        return civilFromDays(floorDivide(this.ns, 86400000000000)).year
    }

    public int month(read this) {
        return civilFromDays(floorDivide(this.ns, 86400000000000)).month
    }

    public int day(read this) {
        return civilFromDays(floorDivide(this.ns, 86400000000000)).day
    }

    public int hour(read this) {
        return (int)(floorModulo(this.ns, 86400000000000) / 3600000000000)
    }

    public int minute(read this) {
        return (int)(floorModulo(this.ns, 3600000000000) / 60000000000)
    }

    public int second(read this) {
        return (int)(floorModulo(this.ns, 60000000000) / 1000000000)
    }

    public int nanosecond(read this) {
        return (int)floorModulo(this.ns, 1000000000)
    }

    public DayOfWeek dayOfWeek(read this) {
        return weekday(floorDivide(this.ns, 86400000000000))
    }

    // The time from `earlier` to this moment; negative when `earlier` is later.
    public Duration since(read this, DateTime earlier) {
        return Duration { ns = this.ns - earlier.ns }
    }

    public DateTime plus(read this, Duration span) {
        return DateTime { ns = this.ns + span.ns }
    }

    public DateTime minus(read this, Duration span) {
        return DateTime { ns = this.ns - span.ns }
    }

    public int compare(read this, read DateTime other) {
        return this.ns.compare(other.ns)
    }

    // ISO 8601: `2026-11-15T09:30:05Z`, with the fraction of the second in 3, 6 or 9 digits when
    // there is one: `2026-11-15T09:30:05.120Z`.
    public void format(read this, ref Formatter f) {
        writeCivil(floorDivide(this.ns, 1000000000), (int)floorModulo(this.ns, 1000000000), ref f)
        f.write("Z")
    }
}

// A moment of the calendar seen at an offset from UTC, as the clocks of a place show it:
// `2026-11-18T12:30:05+03:00`. `DateTime.toLocal()` sees one at the offset of the time zone of the
// system, `withOffset` at an offset given, and `toUtc()` gives the moment back. The offset is kept as
// it was: `plus` of a day after the clocks of the place changed gives the old offset, and
// `t.toUtc().plus(span).toLocal()` the new one. Two are equal when both the moment and the offset
// are; `a.toUtc() == b.toUtc()` asks only for the moment. In order by the moment, then the offset.
public struct DateTimeOffset : Copyable, Equatable, Hashable, Comparable, Formattable {
    long ns
    // The seconds the place is ahead of UTC, less than a day either way.
    int ahead

    // The moment the clocks of the system's time zone show this date and time at.
    // `SkippedLocalTime` when they skip it (the hour lost when summer time starts); when they show
    // it twice (the hour when it ends), the earlier of the two. The parts are checked as
    // `DateTime.utc` checks them.
    public Result<DateTimeOffset, DateError> local(int year, int month, int day, int hour, int minute, int second) {
        var wall = try civilSeconds(year, month, day, hour, minute, second)
        // A moment the clocks show this at is the date and time less an offset in force at that
        // moment. The offsets around it are those in force a day before, at it and a day after,
        // as counted in UTC: the clocks change at most once in two days.
        long? found = null
        var shift = -1
        while shift <= 1 {
            var offset = Clock.offsetAt(wall + shift * 86400)
            var moment = wall - offset
            if Clock.offsetAt(moment) == offset && (found is null || moment < found) {
                found = moment
            }
            shift += 1
        }
        if found is null {
            return Error(DateError.SkippedLocalTime)
        }
        if !holdsSeconds(found, 0) {
            return Error(DateError.OutOfRange)
        }
        return Ok(DateTimeOffset { ns = found * 1000000000, ahead = (int)(wall - found) })
    }

    // A moment in RFC 3339, the form of ISO 8601 that `print` writes: `2026-11-18T12:30:05+03:00`,
    // `2026-11-18T09:30:05.5Z`. The date and the time of day take all their digits; the fraction of
    // the second has 1 to 9 of them, and the offset is `Z` (kept as `+00:00`), `+hh:mm` or `-hh:mm`,
    // with `:ss` after it as `print` writes the offsets of old local times. Nothing may come before
    // or after. `InvalidText` gives where the text stops being one; then the parts are checked as
    // `DateTime.utc` checks them (a second of 60 is `InvalidSecond`: a `DateTime` counts no leap
    // seconds), the offset as `withOffset` checks it, and the moment against the range.
    public Result<DateTimeOffset, DateError> parse(read string text) {
        nint at = 0
        var year = try digitsAt(text, ref at, 4)
        try expect(text, ref at, '-')
        var month = try digitsAt(text, ref at, 2)
        try expect(text, ref at, '-')
        var day = try digitsAt(text, ref at, 2)
        try expect(text, ref at, 'T')
        var hour = try digitsAt(text, ref at, 2)
        try expect(text, ref at, ':')
        var minute = try digitsAt(text, ref at, 2)
        try expect(text, ref at, ':')
        var second = try digitsAt(text, ref at, 2)
        var part = 0
        if at < text.length() && text[at] == '.' {
            at += 1
            var count = 0
            while at < text.length() && text[at] >= '0' && text[at] <= '9' {
                if count == 9 {
                    return Error(DateError.InvalidText(at))
                }
                part = part * 10 + (int)(text[at] - '0')
                count += 1
                at += 1
            }
            if count == 0 {
                return Error(DateError.InvalidText(at))
            }
            while count < 9 {
                part *= 10
                count += 1
            }
        }
        var offset = 0
        var offsetValid = true
        if at < text.length() && text[at] == 'Z' {
            at += 1
        } else if at < text.length() && (text[at] == '+' || text[at] == '-') {
            var sign = 1
            if text[at] == '-' {
                sign = -1
            }
            at += 1
            var hours = try digitsAt(text, ref at, 2)
            try expect(text, ref at, ':')
            var minutes = try digitsAt(text, ref at, 2)
            var seconds = 0
            if at < text.length() && text[at] == ':' {
                at += 1
                seconds = try digitsAt(text, ref at, 2)
            }
            offsetValid = hours <= 23 && minutes <= 59 && seconds <= 59
            offset = sign * (hours * 3600 + minutes * 60 + seconds)
        } else {
            return Error(DateError.InvalidText(at))
        }
        if at != text.length() {
            return Error(DateError.InvalidText(at))
        }
        var wall = try civilSeconds(year, month, day, hour, minute, second)
        if !offsetValid {
            return Error(DateError.InvalidOffset)
        }
        var moment = wall - offset
        if !holdsSeconds(moment, part) {
            return Error(DateError.OutOfRange)
        }
        return Ok(DateTimeOffset { ns = moment * 1000000000 + part, ahead = offset })
    }

    // The moment in UTC.
    public DateTime toUtc(read this) {
        return DateTime { ns = this.ns }
    }

    // How far the place is ahead of UTC; negative west of it.
    public Duration offset(read this) {
        return Duration { ns = (long)this.ahead * 1000000000 }
    }

    // The parts of the date and the time of day as the clocks of the place show them.
    public int year(read this) {
        return civilFromDays(floorDivide(this.wallSeconds(), 86400)).year
    }

    public int month(read this) {
        return civilFromDays(floorDivide(this.wallSeconds(), 86400)).month
    }

    public int day(read this) {
        return civilFromDays(floorDivide(this.wallSeconds(), 86400)).day
    }

    public int hour(read this) {
        return (int)(floorModulo(this.wallSeconds(), 86400) / 3600)
    }

    public int minute(read this) {
        return (int)(floorModulo(this.wallSeconds(), 3600) / 60)
    }

    public int second(read this) {
        return (int)floorModulo(this.wallSeconds(), 60)
    }

    public int nanosecond(read this) {
        return (int)floorModulo(this.ns, 1000000000)
    }

    public DayOfWeek dayOfWeek(read this) {
        return weekday(floorDivide(this.wallSeconds(), 86400))
    }

    // The time from `earlier` to this moment, whatever their offsets; negative when `earlier` is
    // later.
    public Duration since(read this, DateTimeOffset earlier) {
        return Duration { ns = this.ns - earlier.ns }
    }

    // The moment a span later, at the same offset.
    public DateTimeOffset plus(read this, Duration span) {
        return DateTimeOffset { ns = this.ns + span.ns, ahead = this.ahead }
    }

    public DateTimeOffset minus(read this, Duration span) {
        return DateTimeOffset { ns = this.ns - span.ns, ahead = this.ahead }
    }

    public int compare(read this, read DateTimeOffset other) {
        var moment = this.ns.compare(other.ns)
        if moment != 0 {
            return moment
        }
        return this.ahead.compare(other.ahead)
    }

    // RFC 3339: `2026-11-18T12:30:05+03:00`, the fraction as `DateTime` writes it, an offset of 0
    // as `+00:00`, and the seconds of an offset after it when it has them, as the local times of
    // old had (`+01:56:56`).
    public void format(read this, ref Formatter f) {
        writeCivil(this.wallSeconds(), (int)floorModulo(this.ns, 1000000000), ref f)
        var rest = this.ahead
        if rest < 0 {
            f.write("-")
            rest = -rest
        } else {
            f.write("+")
        }
        f.write($"{rest / 3600:D2}:{rest / 60 % 60:D2}")
        if rest % 60 != 0 {
            f.write($":{rest % 60:D2}")
        }
    }

    // The seconds since 1970 of the date and time the clocks of the place show, counted as if
    // they were in UTC.
    long wallSeconds(read this) {
        return floorDivide(this.ns, 1000000000) + this.ahead
    }
}

struct Civil : Copyable {
    int year
    int month
    int day
}

// The seconds since 1970 of a date and a time of day counted as if they were in UTC, or the part
// given wrong, checked in this order: the month first, so that the day is checked against it.
Result<long, DateError> civilSeconds(int year, int month, int day, int hour, int minute, int second) {
    if month < 1 || month > 12 {
        return Error(DateError.InvalidMonth)
    }
    if day < 1 || day > daysInMonth(year, month) {
        return Error(DateError.InvalidDay)
    }
    if hour < 0 || hour > 23 {
        return Error(DateError.InvalidHour)
    }
    if minute < 0 || minute > 59 {
        return Error(DateError.InvalidMinute)
    }
    if second < 0 || second > 59 {
        return Error(DateError.InvalidSecond)
    }
    // A year this far out is outside the range whatever the rest says, and the days of it would
    // not fit the arithmetic below.
    if year < 1000 || year > 3000 {
        return Error(DateError.OutOfRange)
    }
    return Ok(daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second)
}

// Whether the nanoseconds of a moment that many whole seconds and `part` nanoseconds after 1970
// fit in a `long`, as a `DateTime` keeps them.
bool holdsSeconds(long seconds, int part) {
    return seconds >= -9223372036 && (seconds < 9223372036 || seconds == 9223372036 && part <= 854775807)
}

// The day of the week of a day counted from 1970-01-01, which was a Thursday.
DayOfWeek weekday(long days) {
    var day = floorModulo(days + 3, 7)
    if day == 0 {
        return DayOfWeek.Monday
    } else if day == 1 {
        return DayOfWeek.Tuesday
    } else if day == 2 {
        return DayOfWeek.Wednesday
    } else if day == 3 {
        return DayOfWeek.Thursday
    } else if day == 4 {
        return DayOfWeek.Friday
    } else if day == 5 {
        return DayOfWeek.Saturday
    }
    return DayOfWeek.Sunday
}

// The date and time of day of a moment `seconds` and `part` nanoseconds after 1970, in ISO 8601,
// with the fraction of the second in 3, 6 or 9 digits when there is one.
void writeCivil(long seconds, int part, ref Formatter f) {
    var date = civilFromDays(floorDivide(seconds, 86400))
    var time = floorModulo(seconds, 86400)
    f.write($"{date.year:D4}-{date.month:D2}-{date.day:D2}T{time / 3600:D2}:{time / 60 % 60:D2}:{time % 60:D2}")
    if part != 0 {
        if part % 1000000 == 0 {
            f.write($".{part / 1000000:D3}")
        } else if part % 1000 == 0 {
            f.write($".{part / 1000:D6}")
        } else {
            f.write($".{part:D9}")
        }
    }
}

// The number written in exactly `count` digits at `at`, which moves past them; `InvalidText` at
// the first byte that is not a digit.
Result<int, DateError> digitsAt(read string text, ref nint at, int count) {
    var value = 0
    var left = count
    while left > 0 {
        if at >= text.length() || text[at] < '0' || text[at] > '9' {
            return Error(DateError.InvalidText(at))
        }
        value = value * 10 + (int)(text[at] - '0')
        at += 1
        left -= 1
    }
    return Ok(value)
}

// Moves past the byte at `at` when it is `expected`; `InvalidText` there when it is not.
Result<void, DateError> expect(read string text, ref nint at, byte expected) {
    if at >= text.length() || text[at] != expected {
        return Error(DateError.InvalidText(at))
    }
    at += 1
    return Ok()
}

// How many decimal digits a positive number has.
int digits(long value) {
    var count = 1
    var rest = value
    while rest >= 10 {
        rest = rest / 10
        count += 1
    }
    return count
}

long floorDivide(long a, long b) {
    var quotient = a / b
    if a % b != 0 && (a < 0) != (b < 0) {
        quotient -= 1
    }
    return quotient
}

long floorModulo(long a, long b) {
    var rest = a % b
    if rest != 0 && (rest < 0) != (b < 0) {
        rest += b
    }
    return rest
}

bool isLeapYear(long year) {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

int daysInMonth(long year, int month) {
    if month == 2 {
        if isLeapYear(year) {
            return 29
        }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    return 31
}

// The days from 1970-01-01 to a date, and back: Howard Hinnant's algorithms, which count in eras
// of 400 years that start on the first of March.
long daysFromCivil(long year, int month, int day) {
    var y = year
    if month <= 2 {
        y -= 1
    }
    var era = floorDivide(y, 400)
    var yearOfEra = y - era * 400
    long shifted = month + 9
    if month > 2 {
        shifted = month - 3
    }
    var dayOfYear = (153 * shifted + 2) / 5 + day - 1
    var dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
    return era * 146097 + dayOfEra - 719468
}

Civil civilFromDays(long days) {
    var z = days + 719468
    var era = floorDivide(z, 146097)
    var dayOfEra = z - era * 146097
    var yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    var shifted = (5 * dayOfYear + 2) / 153
    var day = dayOfYear - (153 * shifted + 2) / 5 + 1
    var month = shifted + 3
    if shifted >= 10 {
        month = shifted - 9
    }
    var year = yearOfEra + era * 400
    if month <= 2 {
        year += 1
    }
    return Civil { year = (int)year, month = (int)month, day = (int)day }
}
