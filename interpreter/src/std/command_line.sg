// The command line of a program, declared and then read: the flags, the options that take a value
// and the words in their places (choices 1410, 1423-1433). Written in SG and brought along by the
// language. GNU's way of writing: `--name value`, `--name=value`, `-v`, `-vq`, `-ofile`, `-vo file`;
// options may come after the words, `--` makes every word after it a word, a lone `-` is a word.
// A long name is never shortened (`--verb` is not `--verbose`): a script that worked would read
// another option once one more is declared. What the program declares wrongly is a panic the first
// run shows, since the declaring runs whatever the command line holds.

// Why the command line could not be read, or what it asked for instead of a run.
public enum CommandLineError : Equatable, Formattable {
    // `-h` or `--help`: the text of the help, as `CommandLine.help` gives it.
    HelpAsked(string text)
    // `--version`, when the program gave one: `gifcrop 1.2.0`.
    VersionAsked(string text)
    // An option nobody declared, as it was written, with the declared long name nearest to it.
    UnknownOption(string word, string? suggestion)
    // An option that takes a value came last, with nothing after it.
    MissingValue(string option)
    // A flag was given a value with `=`: `--verbose=yes`.
    UnexpectedValue(string option)
    // A word the program declared with `positional` was not given.
    MissingArgument(string name)
    // A word past the ones declared, with no `rest` to take it.
    TooManyArguments(string word)

    // The help or the version as they are; otherwise one line:
    // `unknown option '--verbos' (did you mean '--verbose'?)`.
    public void format(read this, ref Formatter f) {
        match this {
            HelpAsked(text) => f.write(text)
            VersionAsked(text) => f.write(text)
            UnknownOption(word, suggestion) => {
                if suggestion is not null {
                    f.write($"unknown option '{shown(word)}' (did you mean '--{suggestion}'?)")
                } else {
                    f.write($"unknown option '{shown(word)}'")
                }
            }
            MissingValue(option) => f.write($"option '{option}' needs a value")
            UnexpectedValue(option) => f.write($"option '{option}' takes no value")
            MissingArgument(name) => f.write($"missing <{name}>")
            TooManyArguments(word) => f.write($"unexpected argument '{shown(word)}'")
        }
    }
}

// A word of the command line as a message shows it: a character a reader does not see, or that
// drives the terminal, escaped (`UnicodeCategory.hides`), so that a word cannot write lines of
// its own into the error.
string shown(read string word) {
    var out = string.withCapacity(word.length())
    for c in word.chars() {
        if UnicodeCategory.hides((int)c) {
            UnicodeCategory.escape(ref out, (int)c)
        } else {
            out.write(c)
        }
    }
    return out
}

// What a declared name is.
enum ArgumentKind : Copyable, Equatable {
    Flag
    Option
    Positional
    Rest
}

// The command line a program takes: `var cl = CommandLine("gifcrop", "Crops GIF images.")`, then
// `cl.flag`, `cl.option`, `cl.positional`, `cl.rest` and `cl.version` in the order the help lists
// them, and `cl.parseOrExit(read args)` or `cl.parse(read args)`.
public struct CommandLine {
    string program
    string about
    // Empty when the program gave no version: then there is no `--version`.
    string versionText
    // One row for each declaration, in its order.
    List<string> names
    List<ArgumentKind> kinds
    // The short letter of a flag or an option, 0 when it has none.
    List<int> letters
    // The word the help writes for the value of an option: `FILE` in `--output FILE`.
    List<string> valueNames
    List<string> helps

    // A command line for the program named `program`, `about` the line the help starts with (empty
    // for none).
    public CommandLine create(read string program, read string about) {
        return CommandLine {
            program = program.clone(), about = about.clone(), versionText = "",
            names = List<string>(), kinds = List<ArgumentKind>(), letters = List<int>(),
            valueNames = List<string>(), helps = List<string>()
        }
    }

    // A flag, there or not: `cl.flag("verbose", 'v', "Print each step")` takes `--verbose` and
    // `-v`; `null` for no short letter.
    public void flag(ref this, read string name, char? letter, read string help) {
        this.declare(name, letter, ArgumentKind.Flag, "", help)
    }

    // An option with a value: `cl.option("output", 'o', "FILE", "Where to write")` takes
    // `--output x`, `--output=x`, `-o x` and `-ox`. Given more than once, `option` gives the last
    // value and `options` all of them.
    public void option(ref this, read string name, char? letter, read string valueName, read string help) {
        this.declare(name, letter, ArgumentKind.Option, valueName, help)
    }

    // A word that must be given, the next one in order: `cl.positional("input", "The GIF to read")`.
    public void positional(ref this, read string name, read string help) {
        if this.kinds.contains(ArgumentKind.Rest) {
            panic($"`positional(\"{name}\")` comes after `rest`: declare every `positional` before the `rest` that takes the words left")
        }
        this.declare(name, null, ArgumentKind.Positional, "", help)
    }

    // The words left after the declared ones, none or more: `cl.rest("files", "More GIFs")`. Declared
    // once, last.
    public void rest(ref this, read string name, read string help) {
        if this.kinds.contains(ArgumentKind.Rest) {
            panic($"`rest(\"{name}\")` is declared a second time: only one `rest` takes the words left")
        }
        this.declare(name, null, ArgumentKind.Rest, "", help)
    }

    // The version `--version` prints after the name of the program: `cl.version("1.2.0")`.
    public void version(ref this, read string version) {
        if this.names.contains("version") {
            panic("`version(...)` with a declared name `version`: `--version` is the version's own; give the name another word")
        }
        this.versionText = $"{this.program} {version}".toString()
    }

    void declare(ref this, read string name, char? letter, ArgumentKind kind, read string valueName, read string help) {
        if !validName(name) {
            panic($"`{name}` cannot be the name of an argument: lower-case letters, digits and `-`, starting with a letter")
        }
        if name == "help" || name == "version" && this.versionText.length() > 0 {
            panic($"the name `{name}` is taken: `--{name}` is built in")
        }
        if this.names.contains(name) {
            panic($"the name `{name}` is declared a second time: give each flag, option and word a name of its own")
        }
        int code = 0
        if letter is not null {
            code = (int)letter
            if !isLetterOrDigit(code) {
                panic($"`{letter}` cannot be a short letter: an ASCII letter or digit")
            }
            if code == 'h' {
                panic($"the short letter `h` of `{name}` is taken: `-h` is the help's own")
            }
            if this.letters.contains(code) {
                panic($"the short letter `{letter}` of `{name}` is declared a second time: give it another letter, or `null`")
            }
        }
        this.names.add(name.clone())
        this.kinds.add(kind)
        this.letters.add(code)
        this.valueNames.add(valueName.clone())
        this.helps.add(help.clone())
    }

    // The text `-h` and `--help` print, without a line break at its end.
    public string help(read this) {
        var text = string.withCapacity(256)
        if this.about.length() > 0 {
            text.write($"{this.about}\n\n")
        }
        text.write($"Usage: {this.program} [options]")
        var argumentRows = List<string>()
        var argumentHelps = List<string>()
        var optionRows = List<string>()
        var optionHelps = List<string>()
        for i in 0..this.names.length() {
            var name = read this.names[i]
            match this.kinds[i] {
                Positional => {
                    text.write($" <{name}>")
                    argumentRows.add($"<{name}>".toString())
                    argumentHelps.add(this.helps[i].clone())
                }
                Rest => {
                    text.write($" [{name}...]")
                    argumentRows.add($"[{name}...]".toString())
                    argumentHelps.add(this.helps[i].clone())
                }
                Flag => {
                    optionRows.add(optionLabel(name, this.letters[i], ""))
                    optionHelps.add(this.helps[i].clone())
                }
                Option => {
                    optionRows.add(optionLabel(name, this.letters[i], this.valueNames[i]))
                    optionHelps.add(this.helps[i].clone())
                }
            }
        }
        optionRows.add(optionLabel("help", 'h', ""))
        optionHelps.add("Print this help")
        if this.versionText.length() > 0 {
            optionRows.add(optionLabel("version", 0, ""))
            optionHelps.add("Print the version")
        }
        nint width = 0
        for row in read argumentRows {
            width = width.max(charCount(read row))
        }
        for row in read optionRows {
            width = width.max(charCount(read row))
        }
        if argumentRows.length() > 0 {
            text.write("\n\nArguments:")
            writeRows(ref text, read argumentRows, read argumentHelps, width)
        }
        text.write("\n\nOptions:")
        writeRows(ref text, read optionRows, read optionHelps, width)
        return text
    }

    // The arguments read as declared, or why they could not be, or the help or the version asked for.
    public Result<Arguments, CommandLineError> parse(read this, read string[] args) {
        var values = List<List<string>>()
        for _ in 0..this.names.length() {
            values.add(List<string>())
        }
        nint placed = 0
        bool wordsOnly = false
        nint i = 0
        while i < args.length() {
            var word = read args[i]
            i += 1
            if wordsOnly || word == "-" || !word.startsWith('-') {
                if !this.place(ref values, ref placed, word) {
                    return Error(CommandLineError.TooManyArguments(word.clone()))
                }
                continue
            }
            if word == "--" {
                wordsOnly = true
                continue
            }
            if word.startsWith("--") {
                var body = word[2..]
                nint? equals = body.indexOf('=')
                var name = body
                if equals is not null {
                    name = body[..equals]
                }
                if name == "help" && equals is null {
                    return Error(CommandLineError.HelpAsked(this.help()))
                }
                if name == "version" && equals is null && this.versionText.length() > 0 {
                    return Error(CommandLineError.VersionAsked(this.versionText.clone()))
                }
                nint? found = this.findLong(name)
                if found is null {
                    if name == "help" || name == "version" && this.versionText.length() > 0 {
                        return Error(CommandLineError.UnexpectedValue($"--{name}".toString()))
                    }
                    return Error(CommandLineError.UnknownOption($"--{name}".toString(), this.nearest(name)))
                }
                if this.kinds[found] == ArgumentKind.Flag {
                    if equals is not null {
                        return Error(CommandLineError.UnexpectedValue($"--{name}".toString()))
                    }
                    values[found].add("")
                } else if equals is not null {
                    values[found].add(body[equals + 1..].clone())
                } else if i < args.length() {
                    values[found].add(args[i].clone())
                    i += 1
                } else {
                    return Error(CommandLineError.MissingValue($"--{name}".toString()))
                }
                continue
            }
            var bytes = word.asBytes()
            nint at = 1
            while at < bytes.length() {
                int code = bytes[at]
                // No short letter is other than an ASCII letter or digit: the word is named whole.
                if !isLetterOrDigit(code) {
                    return Error(CommandLineError.UnknownOption(word.clone(), null))
                }
                if code == 'h' {
                    return Error(CommandLineError.HelpAsked(this.help()))
                }
                nint? found = this.letters.indexOf(code)
                if found is null {
                    return Error(CommandLineError.UnknownOption($"-{(char)code}".toString(), null))
                }
                at += 1
                if this.kinds[found] == ArgumentKind.Flag {
                    values[found].add("")
                    continue
                }
                if at < bytes.length() {
                    values[found].add(word[at..].clone())
                } else if i < args.length() {
                    values[found].add(args[i].clone())
                    i += 1
                } else {
                    return Error(CommandLineError.MissingValue($"-{(char)code}".toString()))
                }
                break
            }
        }
        var names = List<string>()
        var kinds = List<ArgumentKind>()
        for k in 0..this.names.length() {
            if this.kinds[k] == ArgumentKind.Positional && values[k].length() == 0 {
                return Error(CommandLineError.MissingArgument(this.names[k].clone()))
            }
            names.add(this.names[k].clone())
            kinds.add(this.kinds[k])
        }
        return Ok(Arguments { names = names, kinds = kinds, values = values })
    }

    // The arguments, or the program ends: the help or the version printed to the output with 0, an
    // error to the standard error with 2, as `gifcrop: missing <input>` and
    // `Try 'gifcrop --help'.`.
    public Arguments parseOrExit(read this, read string[] args) {
        match this.parse(args) {
            Ok(arguments) => return arguments
            Error(HelpAsked(text)) => {
                print(text)
                exit(0)
            }
            Error(VersionAsked(text)) => {
                print(text)
                exit(0)
            }
            Error(cause) => {
                printError($"{this.program}: {cause}")
                printError($"Try '{this.program} --help'.")
                exit(2)
            }
        }
    }

    // Puts a word in the next declared place, or in the rest; false when there is no place for it.
    bool place(read this, ref List<List<string>> values, ref nint placed, read string word) {
        nint seen = 0
        nint? rest = null
        for k in 0..this.names.length() {
            if this.kinds[k] == ArgumentKind.Positional {
                if seen == placed {
                    values[k].add(word.clone())
                    placed += 1
                    return true
                }
                seen += 1
            } else if this.kinds[k] == ArgumentKind.Rest {
                rest = k
            }
        }
        if rest is null {
            return false
        }
        values[rest].add(word.clone())
        return true
    }

    nint? findLong(read this, read string name) {
        for k in 0..this.names.length() {
            if this.names[k] == name && (this.kinds[k] == ArgumentKind.Flag || this.kinds[k] == ArgumentKind.Option) {
                return k
            }
        }
        return null
    }

    // The declared long name nearest to `name`, two edits at most; the first declared of those as
    // near.
    string? nearest(read this, read string name) {
        string? best = null
        nint bestDistance = 3
        for k in 0..this.names.length() {
            if this.kinds[k] == ArgumentKind.Flag || this.kinds[k] == ArgumentKind.Option {
                nint d = nearDistance(name, this.names[k])
                if d < bestDistance {
                    best = this.names[k].clone()
                    bestDistance = d
                }
            }
        }
        nint help = nearDistance(name, "help")
        if help < bestDistance {
            best = "help"
            bestDistance = help
        }
        if this.versionText.length() > 0 && nearDistance(name, "version") < bestDistance {
            best = "version"
        }
        return best
    }
}

// The command line as it was read: `a.flag("verbose")`, `a.option("output")`, `a.options("include")`,
// `a.positional("input")`, `a.rest()`. Asking a name that was not declared, or declared as
// something else, is a panic: it is the program's mistake, not the user's.
public struct Arguments {
    List<string> names
    List<ArgumentKind> kinds
    List<List<string>> values

    // Whether the flag was given.
    public bool flag(read this, read string name) {
        return this.values[this.find(name, ArgumentKind.Flag, "flag")].length() > 0
    }

    // The value the option was given last, `null` when it was not given.
    public read string? option(read this, read string name) from this {
        var given = read this.values[this.find(name, ArgumentKind.Option, "option")]
        if given.length() == 0 {
            return null
        }
        return given[^1]
    }

    // Every value the option was given, in order.
    public read List<string> options(read this, read string name) from this {
        return this.values[this.find(name, ArgumentKind.Option, "options")]
    }

    // The word given in the place of `name`.
    public read string positional(read this, read string name) from this {
        return this.values[this.find(name, ArgumentKind.Positional, "positional")][0]
    }

    // The words left after the declared ones.
    public read List<string> rest(read this) from this {
        nint? at = this.kinds.indexOf(ArgumentKind.Rest)
        if at is null {
            panic("`rest()` with no `rest` declared: declare it with `cl.rest(\"name\", \"help\")`")
        }
        return this.values[at]
    }

    nint find(read this, read string name, ArgumentKind kind, read string asked) {
        nint? at = this.names.indexOf(name)
        if at is null {
            for k in 0..this.names.length() {
                if this.kinds[k] == kind && nearDistance(name, this.names[k]) <= 2 {
                    panic($"`{asked}(\"{name}\")` asks a name that was not declared: did you mean `{asked}(\"{this.names[k]}\")`?")
                }
            }
            panic($"`{asked}(\"{name}\")` asks a name that was not declared: declare it with `cl.{askedAs(kind)}(\"{name}\", ...)`")
        }
        if this.kinds[at] != kind {
            var other = askedAs(this.kinds[at])
            panic($"`{asked}(\"{name}\")` asks a name declared with `{other}`: ask it with `{other}(\"{name}\")`")
        }
        return at
    }
}

string askedAs(ArgumentKind kind) {
    match kind {
        Flag => return "flag"
        Option => return "option"
        Positional => return "positional"
        Rest => return "rest"
    }
}

bool isLetterOrDigit(int code) {
    return code >= 'a' && code <= 'z' || code >= 'A' && code <= 'Z' || code >= '0' && code <= '9'
}

// Lower-case ASCII letters, digits and `-`, starting with a letter.
bool validName(read string name) {
    var bytes = name.asBytes()
    if bytes.length() == 0 || bytes[0] < 'a' || bytes[0] > 'z' {
        return false
    }
    for b in bytes {
        if !(b >= 'a' && b <= 'z' || b >= '0' && b <= '9' || b == '-') {
            return false
        }
    }
    return true
}

// `-o, --output FILE`, `    --dry-run` with no short letter.
string optionLabel(read string name, int letter, read string valueName) {
    var label = string.withCapacity(32)
    if letter != 0 {
        label.write($"-{(char)letter}, ")
    } else {
        label.write("    ")
    }
    label.write($"--{name}")
    if valueName.length() > 0 {
        label.write($" {valueName}")
    }
    return label
}

void writeRows(ref string text, read List<string> rows, read List<string> helps, nint width) {
    for i in 0..rows.length() {
        text.write($"\n  {rows[i]}")
        if helps[i].length() > 0 {
            text.write(" ".repeat(width - charCount(read rows[i]) + 4))
            text.write(helps[i])
        }
    }
}

// `editDistance` when it is 2 or less, else 3 or more: names whose lengths are 3 apart are not
// compared, so that a long word written by mistake costs no more than its length.
nint nearDistance(read string a, read string b) {
    if a.length() > b.length() + 2 || b.length() > a.length() + 2 {
        return 3
    }
    return editDistance(a, b)
}

// How many bytes must be put in, taken out or changed to make `a` into `b` (Levenshtein).
nint editDistance(read string a, read string b) {
    var x = a.asBytes()
    var y = b.asBytes()
    var row = List<nint>()
    for j in 0..y.length() + 1 {
        row.add(j)
    }
    for i in 0..x.length() {
        nint diagonal = row[0]
        row[0] = i + 1
        for j in 0..y.length() {
            nint above = row[j + 1]
            nint cost = 1
            if x[i] == y[j] {
                cost = 0
            }
            row[j + 1] = (above + 1).min(row[j] + 1).min(diagonal + cost)
            diagonal = above
        }
    }
    return row[y.length()]
}

// How many characters the text has: the columns of the help are counted in them.
nint charCount(read string text) {
    nint n = 0
    for _ in text.chars() {
        n += 1
    }
    return n
}
