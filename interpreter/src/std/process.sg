// Running another program: `Command`, which runs it and waits for it or starts it and goes on, the
// program that runs (`Process`), programs joined by pipes (`Pipeline`), how a program ended
// (`ExitStatus`) and why it did not do its work (`ProcessError`). No shell reads the words: each
// argument reaches the program as it is written, so a text from outside never becomes a command of
// its own. Written in SG and brought along by the language; only the calls of the system under it
// (`System.run`, `System.start`, `System.wait`, `System.tryWait`, `System.detach`,
// `System.signal`, `System.signalId`, `System.processId`, the pipes, their streams and the question
// whether a file can be run) are the compiler's own, and only this module can call them.

// How a program ended.
public enum ExitStatus : Copyable, Equatable, Hashable, Formattable {
    // It ended by itself, with this code: 0 says it did its work. From 0 to 255 on Linux and
    // macOS; on Windows a code of 32 bits, where one with its highest bit set (negative here)
    // is the system's (`0xC0000005` for memory read where there is none).
    Code(int code)
    // A signal of the system stopped it: 9 is `kill -9`, 15 the polite stop.
    Signal(int number)

    // Whether it ended by itself with 0.
    public bool success(read this) {
        return this == ExitStatus.Code(0)
    }

    // `exited with code 3`, `was stopped by signal 9`; a code with its highest bit set in
    // hex, as Windows writes it: `exited with code 0xC0000005`.
    public void format(read this, ref Formatter f) {
        match this {
            Code(code) when code < 0 => f.write($"exited with code 0x{code:X8}")
            Code(code) => f.write($"exited with code {code}")
            Signal(number) => f.write($"was stopped by signal {number}")
        }
    }
}

// What became of a program that runs: `Process.waitChange` gives it, as a shell sees its jobs.
public enum ProcessChange : Copyable, Equatable, Formattable {
    // A signal paused it: Ctrl-Z at the terminal (`Signal.TerminalStop`), a read of the terminal
    // while not in front (`TerminalInput`), or `SIGSTOP`. Its number, as `ExitStatus.Signal` has
    // one: 20 for Ctrl-Z on Linux, 18 on macOS.
    Stopped(int number)
    // It went on after a pause (`Signal.Continue`).
    Continued
    // It ended, and has been waited for.
    Ended(ExitStatus status)

    // `was paused by signal 20`, `went on`, or how it ended (`exited with code 0`).
    public void format(read this, ref Formatter f) {
        match this {
            Stopped(number) => f.write($"was paused by signal {number}")
            Continued => f.write("went on")
            Ended(status) => f.write($"{status}")
        }
    }
}

// Why `run` or `output` did not give what the program did.
public enum ProcessError : Copyable, Equatable, Formattable {
    // The program could not be started (`NotFound`, `PermissionDenied`, `InvalidInput` for a word
    // with a zero byte in it), or what it wrote was not UTF-8 (`InvalidText`).
    Io(IoError cause)
    // It ran, and did not end with 0.
    Failed(ExitStatus status)

    // What the `IoError` says, or `the program exited with code 1`.
    public void format(read this, ref Formatter f) {
        match this {
            Io(cause) => f.write($"{cause}")
            Failed(status) => f.write($"the program {status}")
        }
    }
}

// A program to run, with its arguments, the folder it works in, the changes to its environment and
// where its input comes from and its output goes; `run`, `output` or `status` runs it and waits for
// it to end. A program it starts gets the output and the standard error of this one, what was
// printed before it already written out, unless it was told otherwise.
public struct Command {
    // As it was given: a name looked for in `PATH`, or a path.
    string program
    // What the program gets as its command line: its name as it was given, then the arguments.
    List<string> words
    // The folder it works in; empty for the folder of this program.
    string folder
    // It starts with no variables of this program's environment.
    bool clear
    // The changes to the environment, in the order they were made: a name with its value, or a name
    // to remove (`kept` false). The last change of a name is the one that counts.
    List<string> names
    List<string> values
    List<bool> kept
    // Where its input comes from: the input of this program (0), nothing (1), the text of `input`
    // (2), a pipe kept by the `Process` that `start` gives (3), or the file at `inPath` (4).
    long inWay
    string inPath
    string text
    // Where its output goes: the output of this program (0), a pipe kept by the `Process` (1),
    // nowhere (2), the file at `outPath`, made empty first (3) or written at its end (4).
    long outWay
    string outPath
    // Where its standard error goes: as for the output, or where its output goes (6).
    long errWay
    string errPath
    // The group it starts in: this program's (0) or a new one of its own (-1).
    long group
    // It starts in a session of its own.
    bool session
    // Its group is put in front at the terminal of this program as it starts.
    bool front

    // The program to run. A name without `/` is looked for in the folders of `PATH` when it runs,
    // leaving out an empty folder and one that does not start with `/`, so a file of the folder this
    // program works in is never run by its name alone. A path with `/` is taken as it is, from the
    // folder this program works in.
    public Command create(read string program) {
        var words = List<string>()
        words.add(program.clone())
        return Command {
            program = program.clone(), words = words, folder = "", clear = false,
            names = List<string>(), values = List<string>(), kept = List<bool>(),
            inWay = 0, inPath = "", text = "", outWay = 0, outPath = "", errWay = 0, errPath = "",
            group = 0, session = false, front = false
        }
    }

    // One more argument, as it is written: no shell splits it or reads `*` or `$` in it.
    public void arg(ref this, read string word) {
        this.words.add(word.clone())
    }

    // More arguments, each as it is written.
    public void args(ref this, read string[] words) {
        for word in words {
            this.words.add(word.clone())
        }
    }

    // The folder the program works in; this program's own folder stays as it is.
    public void directory(ref this, read string path) {
        this.folder = path.clone()
    }

    // A variable of the environment the program gets; the environment of this program stays as it is.
    public void setVariable(ref this, read string name, read string value) {
        this.names.add(name.clone())
        this.values.add(value.clone())
        this.kept.add(true)
    }

    // A variable of this program's environment the program does not get.
    public void removeVariable(ref this, read string name) {
        this.names.add(name.clone())
        this.values.add("")
        this.kept.add(false)
    }

    // The program gets none of this program's variables, only those set after this.
    public void clearVariables(ref this) {
        this.clear = true
        this.names.clear()
        this.values.clear()
        this.kept.clear()
    }

    // What the program reads as its input, given while what it writes is read, so that neither waits
    // for the other. A program that ends before it read all of it is no error. In place of what
    // `pipeInput` or `inputFrom` said.
    public void input(ref this, read string text) {
        this.inWay = 2
        this.inPath = ""
        this.text = text.clone()
    }

    // The program `start` starts reads what this one writes to the `StreamWriter` that
    // `takeInput` gives; in place of a text of `input` or a file of `inputFrom`. Only `start` looks
    // at it: a program `run` runs reads the input of this one.
    public void pipeInput(ref this) {
        this.inWay = 3
        this.inPath = ""
        this.text = ""
    }

    // The program reads the file at `path`, as `< path` at a shell; in place of a text of `input`
    // or a pipe of `pipeInput`. The file is opened as the program starts: one that cannot be
    // opened is the error of `run`, `status`, `output` or `start`, and the program does not start.
    public void inputFrom(ref this, read string path) {
        this.inWay = 4
        this.inPath = path.clone()
        this.text = ""
    }

    // What the program `start` starts writes to its output is read from the `StreamReader` that
    // `takeOutput` gives. Only `start` looks at it. In place of a file or of `discardOutput`.
    public void pipeOutput(ref this) {
        this.outWay = 1
        this.outPath = ""
    }

    // What the program writes to its output goes nowhere, as `> /dev/null` at a shell.
    public void discardOutput(ref this) {
        this.outWay = 2
        this.outPath = ""
    }

    // What the program writes to its output goes into the file at `path`, as `> path` at a
    // shell: a file that is there is made empty first, one that is not is made (with the mode
    // 0o666 less what the mask of this program takes away). It is opened as the program starts.
    public void outputTo(ref this, read string path) {
        this.outWay = 3
        this.outPath = path.clone()
    }

    // The same at the end of what the file holds, as `>> path`: each write goes to the end, even
    // when another program writes to the file too.
    public void appendOutputTo(ref this, read string path) {
        this.outWay = 4
        this.outPath = path.clone()
    }

    // What the program `start` starts writes to its standard error is read from the
    // `StreamReader` that `takeError` gives. Only `start` looks at it.
    public void pipeError(ref this) {
        this.errWay = 1
        this.errPath = ""
    }

    // What the program writes to its standard error goes nowhere, as `2> /dev/null`.
    public void discardError(ref this) {
        this.errWay = 2
        this.errPath = ""
    }

    // What the program writes to its standard error goes into the file at `path`, as `2> path`,
    // made empty first.
    public void errorTo(ref this, read string path) {
        this.errWay = 3
        this.errPath = path.clone()
    }

    // The same at the end of what the file holds, as `2>> path`.
    public void appendErrorTo(ref this, read string path) {
        this.errWay = 4
        this.errPath = path.clone()
    }

    // What the program writes to its standard error goes where its output goes, as `2>&1`: into
    // the text `output` gives, the pipe of `pipeOutput`, the file of `outputTo` or the next program
    // of a `Pipeline`.
    public void errorToOutput(ref this) {
        this.errWay = 6
        this.errPath = ""
    }

    // The program starts in a group of programs of its own, which those it starts join, as a shell
    // starts each job: `Process.signalGroup` and `killGroup` then reach them all, and the end of
    // its `Process` without a wait stops them all. Ctrl-C at the terminal reaches only the group in
    // front there, so a program in a group of its own does not get it (unless `foreground` put it
    // in front). On Windows the group is made with `CREATE_NEW_PROCESS_GROUP`, to which only Ctrl-
    // Break can be sent.
    public void newGroup(ref this) {
        this.group = -1
    }

    // The program starts in a session of its own, with no terminal (`setsid`), as a daemon does: a
    // terminal that closes does not send it `Hangup`. It is in a group of its own too. On Windows it
    // starts without a console (`DETACHED_PROCESS`).
    public void newSession(ref this) {
        this.session = true
    }

    // The program starts in a group of its own that is put in front at the terminal of this
    // program before it runs a single step, as a shell runs a job in front: it reads the keyboard,
    // and Ctrl-C and Ctrl-Z at the terminal reach it and not this program. No terminal is
    // `IoError.NotATerminal` where it starts. When it has ended, or was paused, `Terminal.takeBack`
    // puts this program in front again; `run`, `output` and `status` do it themselves once it has
    // ended. One with `newSession` too is a panic where it starts: a session of its own has no
    // terminal of this program. On Windows, whose console has no group in front, only the group.
    public void foreground(ref this) {
        this.group = -1
        this.front = true
    }

    // Starts the program and goes on while it runs. Its input, output and standard error are what
    // the calls above said: pipes kept by the `Process` it gives where `pipeInput`, `pipeOutput`
    // and `pipeError` asked for them, and those of this program where nothing was said; a text of
    // `input` is written into its input while it runs. The `Process` it gives is waited for
    // (`wait`, `waitAsync`); one that ends without that stops the program.
    public Result<Process, IoError> start(read this) {
        var ways = this.plainWays()
        return this.begin(read ways)
    }

    // Runs the program and waits for it to end. It reads the input of this program, unless `input`
    // or `inputFrom` gave it another, and writes where its output and its standard error were sent,
    // to those of this program when they were not; a pipe asked for is one only for `start`. An
    // end with anything but 0 is `Failed`.
    public Result<void, ProcessError> run(read this) {
        var nothing = ""
        match this.runWaiting(false, ref nothing) {
            Ok(status) => {
                if status.success() {
                    return Ok()
                }
                return Error(ProcessError.Failed(status))
            }
            Error(cause) => return Error(ProcessError.Io(cause))
        }
    }

    // Runs the program and gives what it wrote to its output, which must be UTF-8. Its standard error
    // is the standard error of this program, unless it was sent elsewhere (`errorToOutput` puts it
    // into the text too), and it reads nothing, unless `input` or `inputFrom` gave it something to
    // read. An output sent to a file or nowhere is not read: the text is then empty. An end with
    // anything but 0 is `Failed`, whatever it wrote.
    public Result<string, ProcessError> output(read this) {
        var text = ""
        match this.runWaiting(true, ref text) {
            Ok(status) => {
                if !status.success() {
                    return Error(ProcessError.Failed(status))
                }
            }
            Error(cause) => return Error(ProcessError.Io(cause))
        }
        return Ok(text)
    }

    // Runs the program as `run` does and gives how it ended, without taking any end for an error:
    // for a program whose code says something, as `grep` ends with 1 when it found nothing.
    public Result<ExitStatus, IoError> status(read this) {
        var nothing = ""
        return this.runWaiting(false, ref nothing)
    }

    // `run` without holding the thread, for an async function. A cancel stops the program; with a
    // token cancelled before, it does not start.
    public async Result<void, ProcessError> runAsync(read this, read CancellationToken token = CancellationToken.None) {
        try Command.unless(read token)
        var status = try await this.statusAsync(read token)
        if status.success() {
            return Ok()
        }
        return Error(ProcessError.Failed(status))
    }

    // `output` without holding the thread, for an async function. A cancel stops the program; with
    // a token cancelled before, it does not start.
    public async Result<string, ProcessError> outputAsync(read this, read CancellationToken token = CancellationToken.None) {
        var got = await this.outputWaited(read token)
        this.giveBack()
        return got
    }

    // `outputAsync`, but for the terminal given back.
    async Result<string, ProcessError> outputWaited(read this, read CancellationToken token) {
        try Command.unless(read token)
        var ways = this.waysOf(true)
        var process = try this.begin(read ways)
        var text = ""
        match process.takeOutput() {
            null => {}
            var reader => {
                var written = await reader.readTextAsync(read token)
                var status = try await process.waitAsync(read token)
                if !status.success() {
                    return Error(ProcessError.Failed(status))
                }
                text = try written
                return Ok(text)
            }
        }
        var status = try await process.waitAsync(read token)
        if !status.success() {
            return Error(ProcessError.Failed(status))
        }
        return Ok(text)
    }

    // `status` without holding the thread, for an async function. A cancel stops the program; with
    // a token cancelled before, it does not start.
    public async Result<ExitStatus, IoError> statusAsync(read this, read CancellationToken token = CancellationToken.None) {
        try token.check()
        var ways = this.waysOf(false)
        var process = try this.begin(read ways)
        var status = await process.waitAsync(read token)
        this.giveBack()
        return status
    }

    // A program put in front (`foreground`) that `run`, `output` or `status` waited for has ended:
    // this one is put in front again. One that cannot be has no terminal any more, and nothing to
    // give back.
    void giveBack(read this) {
        if this.front {
            _ = System.terminalFront(0)
        }
    }

    // `IoError.Cancelled` when the token is cancelled already, so that the program does not start.
    Result<void, IoError> unless(read CancellationToken token = CancellationToken.None) {
        try token.check()
        return Ok()
    }

    // Where the streams of a program that is run and waited for go: a pipe asked for is one only for
    // `start`, so it is the stream of this program here; the output is a pipe read into the text
    // when `capture`, unless it was sent to a file or nowhere, and the input is then nothing unless
    // the program was given one.
    long[8] waysOf(read this, bool capture) {
        long input = this.inWay
        if input == 3 || (capture && input == 0) {
            input = 0
            if capture {
                input = 1
            }
        }
        long output = this.outWay
        if output == 1 {
            output = 0
        }
        if capture && output == 0 {
            output = 1
        }
        long error = this.errWay
        if error == 1 {
            error = 0
        }
        return long[8] { input, output, error, -1, -1, this.group, this.session ? 1 : 0, this.front ? 1 : 0 }
    }

    // The ways of a program started and gone on from: the streams as the calls above said, no
    // pipe of a `Pipeline`, then the group (0 this program's, -1 a new one, or the number of one
    // to join), the session and the terminal (0 or 1), as `System.start` takes them.
    long[8] plainWays(read this) {
        return long[8] { this.inWay, this.outWay, this.errWay, -1, -1, this.group, this.session ? 1 : 0, this.front ? 1 : 0 }
    }

    // `foreground` with `newSession` is a panic: a program in a session of its own cannot be in
    // front at the terminal of this one.
    void grouping(read this) {
        if this.front && this.session {
            panic("the program starts in a session of its own (`newSession`), which has no terminal of this program to be in front at (`foreground`)")
        }
    }

    // Starts the program with its streams where `ways` says: the three ways, then the ends of
    // pipes made by a `Pipeline` its input comes from and its output goes to, or -1.
    Result<Process, IoError> begin(read this, read long[] ways) {
        this.grouping()
        try this.valid()
        var path = try this.found()
        var made = long[5]
        var paths = List<string> { this.inPath.clone(), this.outPath.clone(), this.errPath.clone() }
        try System.start(
            read path, read this.words, read this.folder, this.clear, read this.names, read this.values, read this.kept,
            read ways, read this.text, read paths, ref made
        )
        // The group it is in: its own when it made one (a session makes one on Linux and macOS),
        // the one it joined, or none.
        long group = 0
        if ways[5] < 0 || (ways[6] != 0 && !OperatingSystem.isWindows()) {
            group = made[0]
        } else if ways[5] > 0 {
            group = ways[5]
        }
        var process = Process {
            pid = made[0], handle = made[4], input = null, output = null, error = null, ended = false,
            how = ExitStatus.Code(0), group = group
        }
        if made[1] >= 0 {
            process.input = System.writer(made[1])
        }
        if made[2] >= 0 {
            process.output = System.reader(made[2])
        }
        if made[3] >= 0 {
            process.error = System.reader(made[3])
        }
        return Ok(process)
    }

    // Starts the program, gives it its input, puts what it writes into `output` when `capture`, and
    // waits for it to end. What it wrote must be UTF-8, unless it did not end with 0, when what it
    // wrote does not count.
    Result<ExitStatus, IoError> runWaiting(read this, bool capture, ref string output) {
        this.grouping()
        try this.valid()
        var path = try this.found()
        var ways = this.waysOf(capture)
        var paths = List<string> { this.inPath.clone(), this.outPath.clone(), this.errPath.clone() }
        // How it ended, the code or the signal, and where the first byte of its output that is not
        // UTF-8 is (-1 when there is none).
        var ended = long[3]
        try System.run(
            read path, read this.words, read this.folder, this.clear, read this.names, read this.values, read this.kept,
            read ways, read this.text, read paths, capture && ways[1] == 1, ref output, ref ended
        )
        this.giveBack()
        var status = ExitStatus.Signal((int)ended[1])
        if ended[0] == 0 {
            status = ExitStatus.Code(ended[1].wrappingToInt())
        }
        if ended[2] >= 0 && status.success() {
            return Error(IoError.InvalidText(ended[2]))
        }
        return Ok(status)
    }

    // What the system cannot take: a zero byte would end a word early, and a name of a variable with
    // `=` in it, or an empty one, would be read as another name. A file with a zero byte in its
    // name is not there.
    Result<void, IoError> valid(read this) {
        if this.program.contains('\0') || this.folder.contains('\0') {
            return Error(IoError.NotFound)
        }
        if this.inPath.contains('\0') || this.outPath.contains('\0') || this.errPath.contains('\0') {
            return Error(IoError.NotFound)
        }
        for word in read this.words {
            if word.contains('\0') {
                return Error(IoError.InvalidInput)
            }
        }
        for name in read this.names {
            if name.length() == 0 || name.contains('=') || name.contains('\0') {
                return Error(IoError.InvalidInput)
            }
        }
        for value in read this.values {
            if value.contains('\0') {
                return Error(IoError.InvalidInput)
            }
        }
        return Ok()
    }

    // The path of the program: a name looked for in `PATH`, or a path made to start from the folder
    // this program works in when the program works in another one. On Windows `\` and a drive
    // (`C:`) make a path too, and a name without an extension is looked for as `name.exe`. Only
    // the folders of `PATH` that are absolute are looked in, and never the folder this program
    // works in, where a program put by someone else could be run. A path on Windows gets `.exe`
    // too when it has no extension, as Rust gives it.
    Result<string, IoError> found(read this) {
        var name = this.program.clone()
        if OperatingSystem.isWindows() && name.length() > 0 && Path.extension(read name).length() == 0 {
            name = $"{name}.exe".toString()
        }
        if Command.isPath(read this.program) {
            if Command.isAbsolute(read name) || this.folder.length() == 0 {
                return Ok(name)
            }
            var here = try Directory.current()
            return Ok(Path.join(read here, read name))
        }
        if this.program.length() == 0 {
            return Error(IoError.NotFound)
        }
        var folders = ""
        match Environment.get("PATH") {
            Ok(text) => folders = text
            Error(_) => return Error(IoError.NotFound)
        }
        // A file that is there and cannot be run is told only when no folder has one that can.
        var denied = false
        for folder in Command.pathFolders(read folders) {
            if !Command.isAbsolute(read folder) {
                continue
            }
            var path = Path.join(read folder, read name)
            match System.executable(read path) {
                1 => return Ok(path)
                2 => denied = true
                _ => {}
            }
        }
        if denied {
            return Error(IoError.PermissionDenied)
        }
        return Error(IoError.NotFound)
    }

    // Whether the program is named by a path, not looked for: it holds a separator, or on
    // Windows a drive (`C:tool.exe`).
    bool isPath(read string program) {
        if OperatingSystem.isWindows() {
            return program.contains('/') || program.contains('\\') || program.contains(':')
        }
        return program.contains('/')
    }

    // Whether the path does not depend on the folder this program works in: it starts at `/` on
    // Linux and macOS; on Windows at a drive with a separator (`C:\`) or a share (`\\server\share\`),
    // not at a separator alone (`\tools`), which is on the drive of that folder, nor at a drive
    // alone (`C:tools`), which is in the folder that drive works in.
    bool isAbsolute(read string path) {
        if OperatingSystem.isWindows() {
            return Path.rootLength(path) >= 3
        }
        return path.startsWith('/')
    }

    // The folders of `PATH`: apart at `:` on Linux and macOS; on Windows at `;`, where a folder
    // may be quoted to hold a `;` and the quotes are not part of it, as Rust and Go read it.
    List<string> pathFolders(read string text) {
        var folders = List<string>()
        if !OperatingSystem.isWindows() {
            for folder in text.split(':') {
                folders.add(folder.clone())
            }
            return folders
        }
        nint start = 0
        var quoted = false
        for i in 0..text.length() {
            if text[i] == '"' {
                quoted = !quoted
            } else if text[i] == ';' && !quoted {
                folders.add(text[start..i].replaceAll("\"", ""))
                start = i + 1
            }
        }
        folders.add(text[start..].replaceAll("\"", ""))
        return folders
    }
}

// A program `start` started, which runs while this one goes on. It is waited for with `wait` or
// `waitAsync`, which give how it ended, or let go of with `detach`; one that ends without that (an
// error that leaves the function, a field or an item that ends) is stopped with the signal 9 and
// waited for there. The pipes `Command` asked for are taken out of it as streams of their own.
public struct Process : Disposable {
    // The number the system knows the program by.
    long pid
    // What names the program to the calls of the system: the number on Linux and macOS, its
    // handle on Windows, which names it, and no other, until it is waited for.
    long handle
    // The pipes not taken out yet.
    StreamWriter? input
    StreamReader? output
    StreamReader? error
    // It has been waited for, or let go of: the system may give its number to another program.
    bool ended
    // How it ended, once it has been waited for.
    ExitStatus how
    // The group it is in when it was started in one of its own (`newGroup`, `newSession`,
    // `foreground`) or joined one (`Pipeline.newGroup`): its number; 0 for this program's.
    long group

    // The number the system knows the program by, as `ps` shows it.
    public int id(read this) {
        return (int)this.pid
    }

    // The number the system knows this program by.
    public int currentId() {
        return (int)System.processId(0)
    }

    // The number of the program that started this one, as the system says it now: when that one
    // has ended, the program that took this one in (1, or a keeper of orphans, on Linux and
    // macOS). On Windows the number that program had, which another may have by now.
    public int parentId() {
        return (int)System.processId(1)
    }

    // Sends a signal to the program the system knows by `id`, which need not be one this program
    // started: `NotFound` when there is none, `PermissionDenied` when this program may not send it
    // one. The number of a program that has ended may have been given to another since; a
    // `Process` of this program names its own and no other until it is waited for. An `id` of 0
    // or less, which would name a group of programs on Linux and macOS, is `InvalidInput`. On
    // Windows every signal stops the program as `kill` does, but `Signal.WindowChange`, which only
    // looks whether it is there.
    public Result<void, IoError> signalId(int id, Signal signal) {
        if id <= 0 {
            return Error(IoError.InvalidInput)
        }
        return System.signalId(id, signalNumber(signal))
    }

    // Stops the program the system knows by `id` at once, with the signal 9, as `signalId` sends.
    public Result<void, IoError> killId(int id) {
        if id <= 0 {
            return Error(IoError.InvalidInput)
        }
        return System.signalId(id, 9)
    }

    // The writer of the input of the program, when `pipeInput` asked for it; `null` when it did not,
    // or when it was taken already. Closing it tells the program that its input has ended.
    public StreamWriter? takeInput(ref this) {
        return this.input.take()
    }

    // The reader of the output of the program, when `pipeOutput` asked for it; `null` when it did
    // not, or when it was taken already.
    public StreamReader? takeOutput(ref this) {
        return this.output.take()
    }

    // The reader of the standard error of the program, when `pipeError` asked for it; `null` when it
    // did not, or when it was taken already.
    public StreamReader? takeError(ref this) {
        return this.error.take()
    }

    // Stops the program at once: the signal 9, which it cannot catch. It is still waited for, and
    // ends with `ExitStatus.Signal(9)` unless it had ended before. Once it has ended, nothing. On
    // Windows it ends with `ExitStatus.Code(1)`.
    public void kill(read this) {
        if !this.ended {
            System.signal(this.handle, 9)
        }
    }

    // Asks the program to stop: the signal 15, which it may catch to end in its own way. A paused
    // program gets it only once it goes on: send `Signal.Continue` after it, as `kill` at a shell
    // does for a job. Windows has no such request to send: there the program is stopped as `kill`
    // stops it.
    public void terminate(read this) {
        if !this.ended {
            System.signal(this.handle, 15)
        }
    }

    // Sends the program a signal: `Signal.Interrupt` is what Ctrl-C at a terminal sends it. Once it
    // has ended, nothing. On Windows every signal stops the program as `kill` does, but
    // `Signal.WindowChange`, which does nothing.
    public void signal(read this, Signal signal) {
        if !this.ended {
            System.signal(this.handle, signalNumber(signal))
        }
    }

    // The number of the group the program is in, when it was started in a group of its own
    // (`Command.newGroup`, `newSession`, `foreground`) or in that of a `Pipeline` (`newGroup`):
    // the number of the program that made the group, as `ps -o pgid` shows it, and as `kill --
    // -number` takes it at a shell. `null` when it is in the group of this program.
    public int? groupId(read this) {
        if this.group == 0 {
            return null
        }
        return (int)this.group
    }

    // Sends a signal to every program of the group of this one: the programs it started, and the
    // others of its `Pipeline`, which `signal` leaves out. `Signal.Continue` lets a paused job go
    // on, as `fg` and `bg` do. A program of the group that ended long ago is no matter: the group
    // lives while one of its programs does. A program not started in a group of its own (see
    // `groupId`) is a panic: the group would be that of this program. A paused program gets
    // `Signal.Terminate` only once it goes on, so send `Signal.Continue` after it. On Windows
    // `Signal.Interrupt` is Ctrl-Break to the group, and another signal goes to this program only,
    // as `signal` sends it, and to none once it has ended.
    public void signalGroup(read this, Signal signal) {
        this.grouped("signalGroup")
        if OperatingSystem.isWindows() && this.ended {
            return
        }
        System.signalGroup(this.handle, this.group, signalNumber(signal))
    }

    // Stops every program of the group at once, with the signal 9, which also ends a paused one.
    // On Windows only this program, until the group is a job of the system.
    public void killGroup(read this) {
        this.grouped("killGroup")
        if OperatingSystem.isWindows() && this.ended {
            return
        }
        System.signalGroup(this.handle, this.group, 9)
    }

    // The next change of the program: paused, gone on, or ended, waited for as a shell waits for
    // its jobs. One that ended has been waited for, as `tryWait` says, and gives the same at every
    // later call; one that was paused or went on stays to be waited for. Windows pauses no program:
    // there the only change is its end. A program paused for good is waited for forever by `wait`,
    // and not by this.
    public Result<ProcessChange, IoError> waitChange(ref this) {
        if this.ended {
            return Ok(ProcessChange.Ended(this.how))
        }
        var ended = long[2]
        _ = try System.waitChange(this.handle, true, ref ended)
        return Ok(this.changed(read ended))
    }

    // `waitChange` without waiting: `null` when nothing changed since the last change seen.
    public Result<ProcessChange?, IoError> tryWaitChange(ref this) {
        if this.ended {
            return Ok(ProcessChange.Ended(this.how))
        }
        var ended = long[2]
        if !try System.waitChange(this.handle, false, ref ended) {
            return Ok(null)
        }
        return Ok(this.changed(read ended))
    }

    // `waitChange` without holding the thread, for an async function. It listens for
    // `Signal.Child` while it waits, which the system sends this program at each change of one it
    // started. A cancel ends the wait, and leaves the program as it is.
    public async Result<ProcessChange, IoError> waitChangeAsync(ref this, read CancellationToken token = CancellationToken.None) {
        if this.ended {
            return Ok(ProcessChange.Ended(this.how))
        }
        if OperatingSystem.isWindows() {
            var ended = long[2]
            try await System.waitAsync(this.handle, read token, ref ended)
            this.ended = true
            this.how = Process.status(read ended)
            return Ok(ProcessChange.Ended(this.how))
        }
        // Listened for before the look, so that a change after it is not missed.
        var listener = Signals.listen(read List<Signal> { Signal.Child })
        while true {
            match try this.tryWaitChange() {
                null => {}
                var change => return Ok(change)
            }
            _ = try await listener.nextAsync(read token)
        }
    }

    // The change `System.waitChange` saw: a pause, a going on, or the end, after which the
    // program has been waited for.
    ProcessChange changed(ref this, read long[] ended) {
        if ended[0] == 2 {
            return ProcessChange.Stopped((int)ended[1])
        }
        if ended[0] == 3 {
            return ProcessChange.Continued
        }
        this.ended = true
        this.how = Process.status(read ended)
        return ProcessChange.Ended(this.how)
    }

    // A program not in a group of its own has none to send a signal to.
    void grouped(read this, read string call) {
        if this.group == 0 {
            panic($"`{call}` on a program that was not started in a group of its own (`Command.newGroup`)")
        }
    }

    // Whether the program has ended, without waiting: `null` while it runs, and how it ended once it
    // has, which every later call and `wait` give again. A program seen ended here has been waited
    // for, and is not stopped where its `Process` ends; one still running has not, and is waited
    // for as before.
    public Result<ExitStatus?, IoError> tryWait(ref this) {
        if this.ended {
            return Ok(this.how)
        }
        var ended = long[2]
        if !try System.tryWait(this.handle, ref ended) {
            return Ok(null)
        }
        this.ended = true
        this.how = Process.status(read ended)
        return Ok(this.how)
    }

    // Waits for the program to end and gives how it ended. The input it still holds is closed
    // first, and the readers it still holds are let go of, so that a program that reads to the
    // end of its input, or writes more than a pipe holds, does not wait for this one forever.
    public Result<ExitStatus, IoError> wait(this) {
        this.leave()
        if this.ended {
            return Ok(this.how)
        }
        var ended = long[2]
        System.wait(this.handle, ref ended)
        this.ended = true
        return Ok(Process.status(read ended))
    }

    // `wait` without holding the thread, for an async function. A cancel stops the program.
    public async Result<ExitStatus, IoError> waitAsync(this, read CancellationToken token = CancellationToken.None) {
        this.leave()
        if this.ended {
            return Ok(this.how)
        }
        var ended = long[2]
        try await System.waitAsync(this.handle, read token, ref ended)
        this.ended = true
        return Ok(Process.status(read ended))
    }

    // Lets the program go on after this one, and after its `Process`: it is not stopped, and not
    // waited for here. This program's runtime takes it away once it has ended, so that it does not
    // stay as a program that has ended and was never asked how. The pipes it still holds are
    // closed; those taken out stay open. It stays in the group and the session of this program:
    // a terminal that closes still sends it `Hangup`.
    public void detach(this) {
        this.leave()
        if !this.ended {
            System.detach(this.handle)
            this.ended = true
        }
    }

    // The pipes it still holds end: the input is written out and closed, the readers let go of.
    void leave(ref this) {
        this.input = null
        this.output = null
        this.error = null
    }

    // How it ended, from what the system said: 0 and the code, or 1 and the signal.
    ExitStatus status(read long[] ended) {
        if ended[0] == 0 {
            return ExitStatus.Code(ended[1].wrappingToInt())
        }
        return ExitStatus.Signal((int)ended[1])
    }

    // A program that was not waited for is stopped, and waited for so that it does not stay as a
    // process that has ended and was never asked how. One in a group of its own is stopped with
    // the whole group.
    void dispose(ref this) {
        if !this.ended {
            if this.group != 0 {
                System.signalGroup(this.handle, this.group, 9)
            }
            System.signal(this.handle, 9)
            var ended = long[2]
            System.wait(this.handle, ref ended)
        }
    }
}

// Programs joined by pipes, as `a | b | c` at a shell: what each writes to its output is what the
// next one reads as its input, through a pipe of the system from one to the other, never through
// this program. The input of the first and the output of the last are what their `Command` says;
// the standard error of each is its own (`errorToOutput` sends it down the pipe too).
public struct Pipeline {
    List<Command> commands
    // Its programs start in one new group, the job of a shell (`newGroup`).
    bool grouped
    // That group is put in front at the terminal of this program as it starts (`foreground`).
    bool front

    // A pipeline with no program in it yet.
    public Pipeline create() {
        return Pipeline { commands = List<Command>(), grouped = false, front = false }
    }

    // Every program of the pipeline starts in one new group, made by the first, as a shell starts a
    // job: `Process.signalGroup` and `killGroup` of any of them reach them all, and the end of the
    // `Process` of one without a wait stops them all. A `Command` added with `newSession` is then a
    // panic where the pipeline starts. On Windows, where a program cannot join the group of
    // another, each starts in a group of its own.
    public void newGroup(ref this) {
        this.grouped = true
    }

    // `newGroup`, with the group put in front at the terminal of this program before the first
    // program runs a single step, as `Command.foreground` does; the others join it before they
    // run. `run`, `output` and `status` put this program in front again once all have ended; after
    // `start` that is the caller's work (`Terminal.takeBack`). On Windows only the groups.
    public void foreground(ref this) {
        this.grouped = true
        this.front = true
    }

    // One more program, at the end: it reads what the one before writes. The `Command` is taken,
    // not copied. A program before the last whose output was sent elsewhere (`pipeOutput`,
    // `outputTo`, `discardOutput`), or one after the first that was given an input of its own, is
    // a panic where the pipeline starts, since the pipe takes that place.
    public void add(ref this, Command command) {
        this.commands.add(command)
    }

    // Starts every program and goes on: the `Process` of each, in order. The input of the first is
    // a `StreamWriter` of its own when its `Command` asked for `pipeInput`, and the output of the
    // last a `StreamReader` when it asked for `pipeOutput`. A program that cannot start stops
    // those started before it, which are waited for, and is the error.
    public Result<List<Process>, IoError> start(read this) {
        return this.begin(false, false)
    }

    // Runs every program and waits for them all. The pipeline failed when a program ended with
    // anything but 0 (as `set -o pipefail` says at a shell), and the last one that did is the
    // error. A program before the last stopped by the signal `SIGPIPE` failed not: that is how a
    // program ends whose reader, the next one, has read all it wanted and gone (`yes | head -1`).
    // Windows has no such signal; a program there that could not write ends with a code.
    public Result<void, ProcessError> run(read this) {
        var statuses = List<ExitStatus>()
        match this.status() {
            Ok(all) => statuses = all
            Error(cause) => return Error(ProcessError.Io(cause))
        }
        return Pipeline.verdict(read statuses)
    }

    // Runs every program and gives what the last one wrote to its output, which must be UTF-8; the
    // pipeline failed as `run` says, whatever it wrote. The first reads nothing unless its
    // `Command` gave it an input.
    public Result<string, ProcessError> output(read this) {
        var got = this.outputWaited()
        this.giveBack()
        return got
    }

    // `output`, but for the terminal given back.
    Result<string, ProcessError> outputWaited(read this) {
        var processes = List<Process>()
        match this.begin(true, true) {
            Ok(all) => processes = all
            Error(cause) => return Error(ProcessError.Io(cause))
        }
        Result<string, IoError> written = Ok("")
        match processes[^1].takeOutput() {
            null => {}
            var reader => written = reader.readText()
        }
        var statuses = List<ExitStatus>()
        for process in processes {
            match process.wait() {
                Ok(status) => statuses.add(status)
                Error(cause) => return Error(ProcessError.Io(cause))
            }
        }
        try Pipeline.verdict(read statuses)
        match written {
            Ok(text) => return Ok(text)
            Error(cause) => return Error(ProcessError.Io(cause))
        }
    }

    // Runs every program as `run` does and gives how each ended, in order, without taking any end
    // for an error (bash calls them `PIPESTATUS`).
    public Result<List<ExitStatus>, IoError> status(read this) {
        var processes = try this.begin(true, false)
        var statuses = List<ExitStatus>()
        for process in processes {
            match process.wait() {
                Ok(status) => statuses.add(status)
                Error(cause) => {
                    this.giveBack()
                    return Error(cause)
                }
            }
        }
        this.giveBack()
        return Ok(statuses)
    }

    // `run` without holding the thread, for an async function. A cancel stops every program.
    public async Result<void, ProcessError> runAsync(read this, read CancellationToken token = CancellationToken.None) {
        match await this.statusAsync(read token) {
            Ok(statuses) => return Pipeline.verdict(read statuses)
            Error(cause) => return Error(ProcessError.Io(cause))
        }
    }

    // `output` without holding the thread, for an async function. A cancel stops every program.
    public async Result<string, ProcessError> outputAsync(read this, read CancellationToken token = CancellationToken.None) {
        var got = await this.outputWaitedAsync(read token)
        this.giveBack()
        return got
    }

    // `outputAsync`, but for the terminal given back.
    async Result<string, ProcessError> outputWaitedAsync(read this, read CancellationToken token) {
        try Command.unless(read token)
        var processes = List<Process>()
        match this.begin(true, true) {
            Ok(all) => processes = all
            Error(cause) => return Error(ProcessError.Io(cause))
        }
        var text = ""
        IoError? unread = null
        var reader = processes[^1].takeOutput()
        if reader is not null {
            var written = await reader.readTextAsync(read token)
            match written {
                Ok(got) => text = got
                Error(cause) => unread = cause
            }
        }
        var statuses = List<ExitStatus>()
        var waited = await Pipeline.waitAll(ref processes, ref statuses, read token)
        if waited is Error(cause) {
            return Error(ProcessError.Io(cause))
        }
        try Pipeline.verdict(read statuses)
        if unread is not null {
            return Error(ProcessError.Io(unread))
        }
        return Ok(text)
    }

    // Waits for every program, in order, and puts how each ended into `statuses`.
    async Result<void, IoError> waitAll(ref List<Process> processes, ref List<ExitStatus> statuses, read CancellationToken token) {
        while processes.length() > 0 {
            var process = processes.removeLast() ?? panic("not empty")
            statuses.add(try await process.waitAsync(read token))
        }
        statuses.reverse()
        return Ok()
    }

    // `status` without holding the thread, for an async function. A cancel stops every program.
    public async Result<List<ExitStatus>, IoError> statusAsync(read this, read CancellationToken token = CancellationToken.None) {
        try token.check()
        var processes = try this.begin(true, false)
        var statuses = List<ExitStatus>()
        for process in processes {
            match await process.waitAsync(read token) {
                Ok(status) => statuses.add(status)
                Error(cause) => {
                    this.giveBack()
                    return Error(cause)
                }
            }
        }
        this.giveBack()
        return Ok(statuses)
    }

    // The group put in front (`foreground`) has ended: this program is put in front again.
    void giveBack(read this) {
        if this.front {
            _ = System.terminalFront(0)
        }
    }

    // Starts the programs, each joined to the next by a pipe of the system, from the first to the
    // last. Programs `waiting` here have their streams as `Command.run` gives them: a pipe asked
    // for is the stream of this program, and when `capture` the output of the last is a pipe read
    // here and the first reads nothing unless it was given an input.
    Result<List<Process>, IoError> begin(read this, bool waiting, bool capture) {
        var count = this.commands.length()
        if count == 0 {
            panic("a pipeline with no program in it")
        }
        for i in 0..count {
            var command = read this.commands[i]
            if i + 1 < count && command.outWay != 0 {
                panic($"program {i + 1} of the pipeline sends its output elsewhere, where the pipe to the next one goes")
            }
            if i > 0 && command.inWay != 0 {
                panic($"program {i + 1} of the pipeline has an input of its own, where the pipe from the one before comes")
            }
            if this.grouped && command.session {
                panic($"program {i + 1} of the pipeline starts a session of its own (`newSession`), out of the group of the pipeline (`newGroup`)")
            }
        }
        var processes = List<Process>()
        // The end of the pipe the next program reads from, kept here until it has started.
        long reading = -1
        for i in 0..count {
            var command = read this.commands[i]
            var ways = command.plainWays()
            if waiting {
                ways = command.waysOf(capture)
            }
            // One group for them all: the first makes it, and is put in front when asked; the
            // others join it (on Windows each makes one of its own).
            if this.grouped {
                ways[5] = -1
                ways[7] = this.front ? 1 : 0
                if i > 0 {
                    ways[7] = 0
                    if !OperatingSystem.isWindows() {
                        ways[5] = processes[0].pid
                    }
                }
            }
            if i > 0 {
                ways[0] = 5
                ways[3] = reading
            }
            var writing = (long)-1
            if i + 1 < count {
                var ends = long[2]
                match System.pipeEnds(ref ends) {
                    Ok => {}
                    Error(cause) => {
                        System.closeEnd(reading)
                        return Error(cause)
                    }
                }
                ways[1] = 5
                ways[4] = ends[1]
                writing = ends[1]
                var next = ends[0]
                match command.begin(read ways) {
                    Ok(process) => processes.add(process)
                    Error(cause) => {
                        System.closeEnd(reading)
                        System.closeEnd(writing)
                        System.closeEnd(next)
                        return Error(cause)
                    }
                }
                System.closeEnd(reading)
                System.closeEnd(writing)
                reading = next
            } else {
                match command.begin(read ways) {
                    Ok(process) => processes.add(process)
                    Error(cause) => {
                        System.closeEnd(reading)
                        return Error(cause)
                    }
                }
                System.closeEnd(reading)
            }
        }
        return Ok(processes)
    }

    // Whether the pipeline did its work: the last program that ended with anything but 0 is the
    // error, leaving out one before the last that `SIGPIPE` stopped.
    Result<void, ProcessError> verdict(read List<ExitStatus> statuses) {
        nint i = statuses.length()
        while i > 0 {
            i -= 1
            var status = statuses[i]
            if status.success() {
                continue
            }
            if i + 1 < statuses.length() && !OperatingSystem.isWindows() && status == ExitStatus.Signal(13) {
                continue
            }
            return Error(ProcessError.Failed(status))
        }
        return Ok()
    }
}
