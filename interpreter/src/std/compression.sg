Inflater inflaterNew(int format, long limit) {
    return Inflater {
        format = format,
        input = List<byte>(),
        inPos = 0,
        inEnd = 0,
        inEof = false,
        inBase = 0,
        hold = 0,
        bits = 0,
        out = List<byte>(),
        outLen = 0,
        outBase = 0,
        counted = 0,
        memberStart = 0,
        limit = limit,
        mode = InflateHeader,
        last = false,
        storedLeft = 0,
        lenTable = List<uint>.repeat(0, 1024),
        lenBits = 0,
        distTable = List<uint>.repeat(0, 1024),
        distBits = 0,
        fixedTables = false,
        lens = int[320],
        work = int[320],
        crc = Crc32(),
        adler = Adler32(),
        step = 0,
        stepLeft = 0,
        flags = 0,
        headerCrc = Crc32(),
        another = false
    }
}


// 1 for `true`, 0 for `false`.
int bitOf(bool value) {
    if value {
        return 1
    }
    return 0
}

// The bytes added at the end of `out`.
void appendBytes(ref List<byte> out, read byte[] bytes) {
    out.addAll(bytes)
}

