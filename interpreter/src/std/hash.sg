// SHA-256 (FIPS 180-4), HMAC-SHA-256 (RFC 2104) and a comparison of bytes whose time does not tell
// where they differ. Written in SG and brought along by the language (choice 1409), with no
// instructions of the processor made for SHA: slower than OpenSSL, measured in the README's
// "Slower than C". No other hash and no cipher comes with the language: those stay with vetted C
// libraries behind safe wrappers (choice 1406).

const uint[64] Sha256Rounds = {
    0x428a_2f98, 0x7137_4491, 0xb5c0_fbcf, 0xe9b5_dba5, 0x3956_c25b, 0x59f1_11f1, 0x923f_82a4, 0xab1c_5ed5,
    0xd807_aa98, 0x1283_5b01, 0x2431_85be, 0x550c_7dc3, 0x72be_5d74, 0x80de_b1fe, 0x9bdc_06a7, 0xc19b_f174,
    0xe49b_69c1, 0xefbe_4786, 0x0fc1_9dc6, 0x240c_a1cc, 0x2de9_2c6f, 0x4a74_84aa, 0x5cb0_a9dc, 0x76f9_88da,
    0x983e_5152, 0xa831_c66d, 0xb003_27c8, 0xbf59_7fc7, 0xc6e0_0bf3, 0xd5a7_9147, 0x06ca_6351, 0x1429_2967,
    0x27b7_0a85, 0x2e1b_2138, 0x4d2c_6dfc, 0x5338_0d13, 0x650a_7354, 0x766a_0abb, 0x81c2_c92e, 0x9272_2c85,
    0xa2bf_e8a1, 0xa81a_664b, 0xc24b_8b70, 0xc76c_51a3, 0xd192_e819, 0xd699_0624, 0xf40e_3585, 0x106a_a070,
    0x19a4_c116, 0x1e37_6c08, 0x2748_774c, 0x34b0_bcb5, 0x391c_0cb3, 0x4ed8_aa4a, 0x5b9c_ca4f, 0x682e_6ff3,
    0x748f_82ee, 0x78a5_636f, 0x84c8_7814, 0x8cc7_0208, 0x90be_fffa, 0xa450_6ceb, 0xbef9_a3f7, 0xc671_78f2
}

const uint[8] Sha256Start = {
    0x6a09_e667, 0xbb67_ae85, 0x3c6e_f372, 0xa54f_f53a, 0x510e_527f, 0x9b05_688c, 0x1f83_d9ab, 0x5be0_cd19
}

// The SHA-256 of bytes given piece by piece: `var h = Sha256()`, `h.update(read piece)` for each
// piece, `h.finish()` at the end, the same 32 bytes `Sha256.of` gives for all the bytes at once.
public struct Sha256 {
    // The eight words of the hash so far.
    uint[8] state
    // The bytes of a block not yet full, the first `filled` of them.
    byte[64] block
    nint filled
    // How many bytes were taken in.
    ulong length

    // A hash of no bytes yet.
    public Sha256 create() {
        return Sha256 { state = Sha256Start, block = byte[64], filled = 0, length = 0 }
    }

    // The SHA-256 of `data`: `Hex.encode(Sha256.of("abc".asBytes()))` is
    // `"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"`.
    public byte[32] of(read byte[] data) {
        var h = Sha256()
        h.update(data)
        return h.finish()
    }

    // Takes in more bytes.
    public void update(ref this, read byte[] data) {
        nint n = data.length()
        nint i = 0
        this.length += (ulong)n
        if this.filled > 0 {
            i = (64 - this.filled).min(n)
            this.block[this.filled..this.filled + i].copyFrom(data[0..i])
            this.filled += i
            if this.filled < 64 {
                return
            }
            sha256Blocks(ref this.state, read this.block)
            this.filled = 0
        }
        nint whole = (n - i) / 64 * 64
        sha256Blocks(ref this.state, data[i..i + whole])
        i += whole
        this.block[0..n - i].copyFrom(data[i..n])
        this.filled = n - i
    }

    // The hash of the bytes taken in so far. The hash itself does not change: more bytes may be
    // taken in after it, and `finish` then gives the hash of all of them.
    public byte[32] finish(read this) {
        var state = this.state
        var block = this.block
        nint filled = this.filled
        block[filled] = 0x80
        filled += 1
        if filled > 56 {
            while filled < 64 {
                block[filled] = 0
                filled += 1
            }
            sha256Blocks(ref state, read block)
            filled = 0
        }
        while filled < 56 {
            block[filled] = 0
            filled += 1
        }
        var bits = this.length.wrappingMultiply(8).toBigEndian()
        block[56..64].copyFrom(read bits)
        sha256Blocks(ref state, read block)
        var hash = byte[32]
        for k in 0..8 {
            var word = state[k].toBigEndian()
            hash[k * 4..k * 4 + 4].copyFrom(read word)
        }
        return hash
    }
}

// Each block of 64 bytes of `data` (a whole number of them) taken into the eight words.
void sha256Blocks(ref uint[] state, read byte[] data) {
    var w = uint[64]
    nint start = 0
    while start < data.length() {
        // The block as sixteen words, the highest byte of each first.
        for t in 0..16 {
            nint at = start + t * 4
            w[t] = uint.fromBigEndian(data[at..at + 4])
        }
        for t in 16..64 {
            uint x = w[t - 15]
            uint y = w[t - 2]
            uint s0 = x.rotateRight(7) ^ x.rotateRight(18) ^ (x >> 3)
            uint s1 = y.rotateRight(17) ^ y.rotateRight(19) ^ (y >> 10)
            w[t] = w[t - 16].wrappingAdd(s0).wrappingAdd(w[t - 7]).wrappingAdd(s1)
        }
        uint a = state[0]
        uint b = state[1]
        uint c = state[2]
        uint d = state[3]
        uint e = state[4]
        uint f = state[5]
        uint g = state[6]
        uint h = state[7]
        for t in 0..64 {
            uint s1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25)
            uint choose = (e & f) ^ (~e & g)
            uint t1 = h.wrappingAdd(s1).wrappingAdd(choose).wrappingAdd(Sha256Rounds[t]).wrappingAdd(w[t])
            uint s0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22)
            uint major = (a & b) ^ (a & c) ^ (b & c)
            uint t2 = s0.wrappingAdd(major)
            h = g
            g = f
            f = e
            e = d.wrappingAdd(t1)
            d = c
            c = b
            b = a
            a = t1.wrappingAdd(t2)
        }
        state[0] = state[0].wrappingAdd(a)
        state[1] = state[1].wrappingAdd(b)
        state[2] = state[2].wrappingAdd(c)
        state[3] = state[3].wrappingAdd(d)
        state[4] = state[4].wrappingAdd(e)
        state[5] = state[5].wrappingAdd(f)
        state[6] = state[6].wrappingAdd(g)
        state[7] = state[7].wrappingAdd(h)
        start += 64
    }
}

public struct Hmac {
    // The HMAC-SHA-256 of `data` under `key` (RFC 2104): a key longer than a block of 64 bytes is
    // hashed first, as the RFC says. A tag is checked with `Bytes.equalInConstantTime`, never `==`.
    public byte[32] sha256(read byte[] key, read byte[] data) {
        var padded = byte[64]
        if key.length() > 64 {
            var hashed = Sha256.of(key)
            padded[0..32].copyFrom(read hashed)
        } else {
            padded[0..key.length()].copyFrom(key)
        }
        var inner = byte[64]
        var outer = byte[64]
        for i in 0..64 {
            inner[i] = padded[i] ^ 0x36
            outer[i] = padded[i] ^ 0x5c
        }
        var h = Sha256()
        h.update(read inner)
        h.update(data)
        var innerHash = h.finish()
        var o = Sha256()
        o.update(read outer)
        o.update(read innerHash)
        return o.finish()
    }
}

public struct Bytes {
    // Whether `a` and `b` hold the same bytes, in a time that depends on their length only, never
    // on where they first differ: what a tag or a token sent by someone else is compared with, so
    // that the time of a wrong guess does not tell how much of it was right. Two lengths that
    // differ give `false` at once: a length is not the secret.
    public bool equalInConstantTime(read byte[] a, read byte[] b) {
        if a.length() != b.length() {
            return false
        }
        byte difference = 0
        for i in 0..a.length() {
            difference |= a[i] ^ b[i]
        }
        return difference == 0
    }
}
