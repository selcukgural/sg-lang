// Signals of the system: a program listens for some of them and waits for the next one, as in Go
// and Tokio, instead of a handler of its own that would run between any two steps of any thread.
// While a listener of a signal lives, that signal does not end the program; once the last ends,
// the signal does what it did before. Written in SG and brought along by the language; only the
// calls of the system under it (`System.signalListen`, `signalNext`, `signalNextAsync`,
// `signalStop`, `signalRaise`, `signalNumber`) are the compiler's own, and only this module can
// call them.

// A signal a program can listen for. Their numbers are not given: `User1` is 30 on macOS and 10 on
// Linux. A program that listens for one takes the place of what it does by default: a listener of
// `TerminalStop` is not paused by Ctrl-Z, as a shell is not. Windows sends a program only
// `Interrupt` and `Terminate`; the others come there only from `Signals.raise`.
public enum Signal : Copyable, Equatable, Hashable, Formattable {
    // Ctrl-C at a terminal: SIGINT.
    Interrupt
    // The polite stop, `kill` without a number: SIGTERM.
    Terminate
    // The terminal went away; daemons take it as "read your settings again": SIGHUP.
    Hangup
    // Ctrl-\ at a terminal: SIGQUIT.
    Quit
    // Left to programs: SIGUSR1.
    User1
    // Left to programs: SIGUSR2.
    User2
    // The terminal changed its size: SIGWINCH.
    WindowChange
    // Ctrl-Z at a terminal, which pauses a program by default: SIGTSTP.
    TerminalStop
    // A paused program goes on: SIGCONT. It goes on whether it listens or not.
    Continue
    // A program not in front at its terminal read from it, and is paused by default: SIGTTIN.
    TerminalInput
    // A program not in front at its terminal wrote to it or changed its settings, and is paused
    // by default when the terminal says so: SIGTTOU.
    TerminalOutput
    // A program this one started ended, was paused or went on: SIGCHLD. Nothing by default.
    Child
    // A time set with the system ran out, which ends a program by default: SIGALRM. The language
    // sets none; a library of C may.
    Alarm
}

// The place of a signal among the kinds, as the system calls take it.
int signalKind(Signal signal) {
    match signal {
        Interrupt => return 0
        Terminate => return 1
        Hangup => return 2
        Quit => return 3
        User1 => return 4
        User2 => return 5
        WindowChange => return 6
        TerminalStop => return 7
        Continue => return 8
        TerminalInput => return 9
        TerminalOutput => return 10
        Child => return 11
        Alarm => return 12
    }
}

// The signal at a place among the kinds.
Signal signalOf(long kind) {
    match kind {
        0 => return Signal.Interrupt
        1 => return Signal.Terminate
        2 => return Signal.Hangup
        3 => return Signal.Quit
        4 => return Signal.User1
        5 => return Signal.User2
        6 => return Signal.WindowChange
        7 => return Signal.TerminalStop
        8 => return Signal.Continue
        9 => return Signal.TerminalInput
        10 => return Signal.TerminalOutput
        11 => return Signal.Child
        _ => return Signal.Alarm
    }
}

// The number of a signal on this system, for a program started with `Command`.
int signalNumber(Signal signal) {
    return System.signalNumber(signalKind(signal))
}

public struct Signals {
    // Starts listening for the signals: from now on they do not end the program, and each one that
    // comes is kept for `next` or `nextAsync`. No signal at all is a panic.
    public SignalListener listen(read Signal[] signals) {
        if signals.length() == 0 {
            panic("`Signals.listen` is given no signal to listen for")
        }
        var mask = 0
        for signal in signals {
            mask = mask | (1 << signalKind(signal))
        }
        return SignalListener { id = System.signalListen(mask) }
    }

    // Sends the signal to this program, as `raise` does in C: a listener of it gets it, and without
    // one it does what it does by default, ending the program at once for most of them.
    public void raise(Signal signal) {
        System.signalRaise(signalKind(signal))
    }

    // Pauses this program, as Ctrl-Z pauses it but with the signal `SIGSTOP`, which no program
    // can listen for: what a shell does to itself when it is not to be in front. It goes on, and
    // the call returns, when another program sends it `Signal.Continue` (`fg` at the shell that
    // started it). What was printed goes out first. Windows pauses no program: there nothing.
    public void stopSelf() {
        System.signalRaise(13)
    }
}

// What `Signals.listen` gives: the signals it listens for that came and were not taken yet, in the
// order they came. Several of one kind before a `next` are one, as the system does not count them
// either. Every listener of a signal gets it. When the listener ends, it no longer keeps the
// signals from ending the program, unless another listener of them lives.
public struct SignalListener : Disposable {
    // The listener of the system.
    long id

    // Waits for the next signal and gives it; one that came before is given at once.
    public Signal next(ref this) {
        return signalOf(System.signalNext(this.id))
    }

    // `next` without holding the thread, for an async function. A cancel ends the wait; a signal
    // that comes later stays for the next call.
    public async Result<Signal, Cancelled> nextAsync(ref this, read CancellationToken token = CancellationToken.None) {
        var kind = long[1]
        try await System.signalNextAsync(this.id, read token, ref kind)
        return Ok(signalOf(kind[0]))
    }

    void dispose(ref this) {
        System.signalStop(this.id)
    }
}
