// Paths as text: joining two, and the parts of one. A path is a `string`, as `File` takes it; these
// functions only look at the separators in it and never ask the system: `/` on Linux and macOS, `/`
// and `\` on Windows, where a path may also start with a drive (`C:\`, `C:`) or a share
// (`\\server\share\`, `\\?\C:\`). A part they give is a view of the path, not a copy. Written in SG
// and brought along by the language.
public struct Path {
    // The two with one separator between them: `Path.join("logs", "today.txt")` is `logs/today.txt`
    // on Linux and macOS and `logs\today.txt` on Windows; a separator at the end of the first is
    // kept (`Path.join("logs/", "today.txt")` is `logs/today.txt` everywhere). A root at the start of the second path is left out (`Path.join("logs", "/etc")`
    // is `logs/etc`, and on Windows `Path.join("logs", "C:\etc")` is `logs\etc`); a drive alone as
    // the first is joined without one (`C:today.txt`). An empty part gives the other one. The parts
    // are joined as they are written, `..` with them: `Path.join("logs", "../etc")` is
    // `logs/../etc`, outside `logs`. A name that comes from outside the program goes through
    // `joinInside`.
    public string join(read string first, read string second) {
        if first.length() == 0 {
            return second.clone()
        }
        if second.length() == 0 {
            return first.clone()
        }
        var tail = second[Path.rootLength(second)..]
        if Path.isSeparator(first[first.length() - 1]) {
            return $"{first}{tail}".toString()
        }
        if OperatingSystem.isWindows() {
            if Path.rootLength(first) == 2 && first.length() == 2 {
                return $"{first}{tail}".toString()
            }
            return $"{first}\\{tail}".toString()
        }
        return $"{first}/{tail}".toString()
    }

    // `folder` and `name` joined as `join` joins them, for a name that comes from outside the
    // program (a request, a file, an archive): the path stays inside `folder` on every system.
    // `name` may name a folder inside it too (`2026/report.txt`). It is an `InvalidInput`, the
    // same on Linux, macOS and Windows, when it is empty or has an empty part (`a//b`), starts at
    // a root (`/etc`), holds a `\` or a `:` (`C:`, `\\server`), has a part that ends with `.` or a
    // space (`..` among them, which Windows would take away), holds a control character, or has
    // a part that is the name of a device on Windows (`CON`, `PRN`, `AUX`, `NUL`, `COM0` to
    // `COM9`, `LPT0` to `LPT9`, also with an extension: `nul.txt`). A link inside `folder` that
    // points out of it is still followed when the path is opened.
    public Result<string, IoError> joinInside(read string folder, read string name) {
        if name.length() == 0 || name.contains('\\') || name.contains(':') {
            return Error(IoError.InvalidInput)
        }
        for part in name.split('/') {
            if !Path.staysInside(part) {
                return Error(IoError.InvalidInput)
            }
        }
        return Ok(Path.join(folder, name))
    }

    // Whether one part of a name taken by `joinInside` names a file or a folder inside the one
    // it is joined to, on every system.
    bool staysInside(read string part) {
        if part.length() == 0 || part.endsWith('.') || part.endsWith(' ') {
            return false
        }
        for c in part.chars() {
            if (int)c < 32 || (int)c == 127 {
                return false
            }
        }
        return !Path.isDevice(part)
    }

    // Whether Windows takes the part for a device: the name before the first `.`, without the
    // spaces after it and in any case, is one of the devices' names.
    bool isDevice(read string part) {
        var dot = part.indexOf('.') ?? part.length()
        var base = part[..dot].trimEnd()
        if base.equalsIgnoreAsciiCase("CON") || base.equalsIgnoreAsciiCase("PRN") || base.equalsIgnoreAsciiCase("AUX") || base.equalsIgnoreAsciiCase("NUL") {
            return true
        }
        if base.equalsIgnoreAsciiCase("CONIN$") || base.equalsIgnoreAsciiCase("CONOUT$") {
            return true
        }
        if base.length() != 4 {
            return Path.isNumberedDevice(base)
        }
        var head = base[..3]
        var last = base[3]
        if !(head.equalsIgnoreAsciiCase("COM") || head.equalsIgnoreAsciiCase("LPT")) {
            return false
        }
        return last >= '0' && last <= '9'
    }

    // `COM¹`, `LPT³`: Windows takes the small raised digits for devices too.
    bool isNumberedDevice(read string base) {
        if base.length() != 5 {
            return false
        }
        var head = base[..3]
        if !(head.equalsIgnoreAsciiCase("COM") || head.equalsIgnoreAsciiCase("LPT")) {
            return false
        }
        var tail = base[3..]
        return tail == "¹" || tail == "²" || tail == "³"
    }

    // Whether the byte separates the parts of a path: `/`, and on Windows `\` too.
    bool isSeparator(byte b) {
        if OperatingSystem.isWindows() {
            return b == '/' || b == '\\'
        }
        return b == '/'
    }

    // How many bytes the root at the start of the path takes, with the separator after it: 1 for
    // `/`, 0 for a path without one. On Windows also `\`, a drive (`C:` 2, `C:\` 3), a share
    // (`\\server\share\`), and a path Windows takes as it is (`\\?\C:\`, `\\?\UNC\server\share\`,
    // `\\.\COM1\`).
    nint rootLength(read string path) {
        var n = path.length()
        if n == 0 {
            return 0
        }
        if !OperatingSystem.isWindows() {
            if path[0] == '/' {
                return 1
            }
            return 0
        }
        if n >= 2 && Path.isSeparator(path[0]) && Path.isSeparator(path[1]) {
            if n >= 4 && (path[2] == '?' || path[2] == '.') && Path.isSeparator(path[3]) {
                if n >= 8 && path[4..7].equalsIgnoreAsciiCase("UNC") && Path.isSeparator(path[7]) {
                    return Path.pastSeparator(path, Path.pastPart(path, Path.pastSeparator(path, Path.pastPart(path, 8))))
                }
                return Path.pastSeparator(path, Path.pastPart(path, 4))
            }
            return Path.pastSeparator(path, Path.pastPart(path, Path.pastSeparator(path, Path.pastPart(path, 2))))
        }
        if Path.isSeparator(path[0]) {
            return 1
        }
        var letter = path[0] | 0x20
        if n >= 2 && path[1] == ':' && letter >= 'a' && letter <= 'z' {
            if n >= 3 && Path.isSeparator(path[2]) {
                return 3
            }
            return 2
        }
        return 0
    }

    // Where the part that starts at `at` ends: at the next separator, or at the end.
    nint pastPart(read string path, nint at) {
        var i = at
        while i < path.length() && !Path.isSeparator(path[i]) {
            i += 1
        }
        return i
    }

    // After the separator at `at`, if there is one there.
    nint pastSeparator(read string path, nint at) {
        if at < path.length() && Path.isSeparator(path[at]) {
            return at + 1
        }
        return at
    }

    // Where the last separator is, after the root; -1 for none.
    nint lastSeparator(read string path) {
        var at = path.length() - 1
        while at >= 0 && !Path.isSeparator(path[at]) {
            at -= 1
        }
        return at
    }

    // What comes after the last separator: `report.txt` in `logs/report.txt`, and the empty text in
    // `logs/` and in a root (`/`, and on Windows `C:\`). On Windows the drive is not part of the name:
    // `report.txt` in `C:report.txt`.
    public read string fileName(read string path) from path {
        var start = Path.lastSeparator(path) + 1
        var root = Path.rootLength(path)
        if start < root {
            start = root
        }
        return path[start..]
    }

    // The end of the name from its last `.` on, the `.` with it: `.txt` in `logs/report.txt`. A name
    // without a `.`, with one only at its start (`.profile`) or only at its end (`file.`), has none:
    // the empty text.
    public read string extension(read string path) from path {
        var name = Path.fileName(path)
        var dot = name.lastIndexOf('.') ?? 0
        if dot == 0 || dot == name.length() - 1 {
            return name[name.length()..]
        }
        return name[dot..]
    }

    // What comes before the last separator: `logs` in `logs/report.txt`, `/` in `/report.txt`, and the
    // empty text in `report.txt`, which names no folder. A root stays whole: on Windows `C:\` in
    // `C:\report.txt`, `C:` in `C:report.txt`, `\\server\share\` in `\\server\share\report.txt`.
    public read string parent(read string path) from path {
        var at = Path.lastSeparator(path)
        var root = Path.rootLength(path)
        if at < root {
            return path[..root]
        }
        return path[..at]
    }
}
