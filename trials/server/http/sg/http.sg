// The HTTP server of the server lane in SG, on `HttpConnection` of the language's own module
// (choice 1771): GET /ping answered with "pong" over HTTP/1.1 with connections kept open, as
// `../c/http.c` describes it. The module reads and checks the request line and every header,
// lets go of a body nobody read, answers what is malformed or too large, and sends the answers
// of pipelined requests together.
//
//     http PORT [--idle-limit MS] [--grace MS]
//
// Every connection is a task of a `TaskGroup`, which lets go of each as it ends, as in
// `../../resp/sg/resp.sg`. `--idle-limit` is the module's `idleTimeout` and `headTimeout`: a
// connection that goes that many milliseconds without a whole request, or with its answers not
// taken in, is closed (the module's own limits, 60 and 10 seconds, without it); the first SIGTERM
// or Ctrl-C stops the server taking connections and gives those open that many milliseconds to
// end (choice 1751).

async Result<void, IoError> serve(TcpStream stream, HttpOptions options) {
    var conn = HttpConnection(stream, options)
    while try await conn.receiveHeadAsync() {
        var req = conn.request()
        var get = req.method() == "GET"
        var head = req.method() == "HEAD"
        if !get && !head {
            try conn.addHeader("allow", "GET, HEAD")
            try await conn.respondAsync(405, "text/plain", "method not allowed".asBytes())
        } else if req.target() == "/ping" {
            try await conn.respondAsync(200, "text/plain", "pong".asBytes())
        } else {
            try await conn.respondAsync(404, "text/plain", "not found".asBytes())
        }
    }
    return Ok()
}

// A connection that fails, or is too slow, ends alone.
async void connection(TcpStream stream, HttpOptions options) {
    _ = await serve(stream, options)
}

// Waits for SIGTERM or Ctrl-C and cancels `stop`; the listener goes with it, so a second ends the
// program.
async void watch(SignalListener signals, CancellationSource stop) {
    if await signals.nextAsync() is Ok(_) {
        stop.cancel()
    }
}

// Takes connections until a signal comes with `grace` given, for ever without; one the listener
// fails to take (too many open files, say) is tried again after 10 ms.
async Result<void, IoError> listen(int port, HttpOptions options, int grace) {
    var address = $":{port}".toString()
    var listener = try TcpListener.bind(read address)
    var connections = TaskGroup()
    var accepting = CancellationToken.None
    if grace > 0 {
        var stop = CancellationSource()
        accepting = stop.token()
        connections.add(watch(Signals.listen(read List<Signal> { Signal.Interrupt, Signal.Terminate }), stop))
    }
    while true {
        match await listener.acceptAsync(read accepting) {
            Ok(conn) => connections.add(connection(conn, options))
            Error(Cancelled(_)) => break
            Error(_) => await Task.delay(10)
        }
    }
    var late = CancellationSource.after(grace)
    _ = await connections.whenAll(read late.token())
    return Ok()
}

const string Usage = "usage: http PORT [--idle-limit MS] [--grace MS]"

void main(List<string> args) {
    if args.length() % 2 != 1 || int.parse(args[0]) is not Ok(port) {
        printError(Usage)
        exit(2)
    }
    var options = HttpOptions {}
    int grace = 0
    for i in 0..args.length() / 2 {
        var name = args[1 + 2 * i]
        if int.parse(args[2 + 2 * i]) is not Ok(ms) || ms <= 0 {
            printError(Usage)
            exit(2)
        }
        if name == "--idle-limit" {
            options.idleTimeout = ms
            options.headTimeout = ms
        } else if name == "--grace" {
            grace = ms
        } else {
            printError(Usage)
            exit(2)
        }
    }
    if listen(port, options, grace).wait() is Error(e) {
        printError($"http: {e}".toString())
        exit(1)
    }
}
