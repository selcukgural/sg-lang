// The store of the server lane in SG (choices 1701, 1702), as `../c/resp.c` describes it: a part of
// RESP2 (PING, GET, SET, DEL) over 64 maps, each behind a lock of its own; each connection reads
// through a `StreamReader`, whose block starts at 4 KB and grows when one command does not fit,
// answers every whole command the block holds, where it lies, and sends the answers together; a
// command of more than 1,024 parts, a part of more than 1 MB, or a command that does not fit in
// 4 MB closes the connection. The answers of one block are sent 64 KB at a time (the last answer
// whole), and the commands after them are run once they are sent, so that a client that asks for
// much and reads nothing holds 64 KB of the server and the answer it stopped at, not what it asked
// for (the stand of choice 1751 found 20 such clients holding 3 GB of the C version, and of this
// one before).
//
//     resp PORT [--idle-limit MS] [--grace MS]
//
// Every connection is a task of a `TaskGroup`, which lets go of each as it ends. With
// `--idle-limit`, a connection that goes that many milliseconds without a whole request, or with
// its answers not taken in, is closed: the C, Rust and Zig versions have no such limit, so the
// tables measure SG without it, and the cost and the gain of it on their own (choice 1724). With
// `--grace`, the first SIGTERM or Ctrl-C stops the server taking connections, those open have that
// many milliseconds to end, the rest are cut, and the server ends with 0 (choice 1751; a second
// signal ends it at once). A key is text: a key that is not UTF-8 is answered
// with an error, where the C, Rust and Zig versions take any bytes (a map of SG is keyed by text,
// a number or a type of its own).

struct Shard {
    HashMap<string, List<byte>> map
}

struct Store {
    List<shared locked Shard> shards
}

// ---- writing the answers

void putNumber(ref List<byte> out, byte kind, long n) {
    out.add(kind)
    if n < 0 {
        out.add('-')
        n = -n
    }
    var digits = byte[20](0)
    var i = 20
    while true {
        i -= 1
        digits[i] = (byte)('0' + n % 10)
        n /= 10
        if n == 0 {
            break
        }
    }
    out.addAll(digits[i..20])
    out.add('\r')
    out.add('\n')
}

void putText(ref List<byte> out, read string text) {
    out.addAll(text.asBytes())
}

// ---- reading a command

// A number written in decimal and ended by CRLF at `at`: the number and where the line ends, or
// `Incomplete` when the line is not whole yet, or `Wrong`.
enum Line {
    Whole(long value, nint next)
    Incomplete
    Wrong
}

Line readNumber(read byte[] bytes, nint at) {
    var i = at
    var minus = false
    if i < bytes.length() && bytes[i] == '-' {
        minus = true
        i += 1
    }
    var digits = i
    long value = 0
    while i < bytes.length() && bytes[i] >= '0' && bytes[i] <= '9' {
        if value > 1000000000 {
            return Line.Wrong
        }
        value = value * 10 + (bytes[i] - '0')
        i += 1
    }
    if i + 1 >= bytes.length() {
        if bytes.length() - at > 24 {
            return Line.Wrong
        }
        return Line.Incomplete
    }
    if i == digits || bytes[i] != '\r' || bytes[i + 1] != '\n' {
        return Line.Wrong
    }
    if minus {
        value = -value
    }
    return Line.Whole(value, i + 2)
}

bool isWord(read byte[] part, read string word) {
    var w = word.asBytes()
    if part.length() != w.length() {
        return false
    }
    for i in 0..part.length() {
        if (part[i] | 0x20) != w[i] {
            return false
        }
    }
    return true
}

// The map of a key: the low bits of its FNV-1a, in every version of the store (the map hashes the
// key again with its own SipHash).
nint shardOf(read string key) {
    ulong h = 14695981039346656037
    for b in key.asBytes() {
        h = (h ^ b) * 1099511628211
    }
    return (nint)(h & 63)
}

// Runs one command, its parts the ranges `starts[i]..ends[i]` of `bytes`.
void run(read Store store, read byte[] bytes, read List<nint> starts, read List<nint> ends, ref List<byte> out) {
    var parts = starts.length()
    var name = bytes[starts[0]..ends[0]]
    if isWord(name, "ping") && parts == 1 {
        putText(ref out, "+PONG\r\n")
    } else if isWord(name, "get") && parts == 2 {
        match string.fromUtf8(bytes[starts[1]..ends[1]]) {
            Ok(key) => {
                lock store.shards[shardOf(key)] as shard {
                    var value = shard.map.get(key)
                    if value is not null {
                        putNumber(ref out, '$', value.length())
                        out.addAll(value)
                        putText(ref out, "\r\n")
                    } else {
                        putText(ref out, "$-1\r\n")
                    }
                }
            }
            Error(_) => putText(ref out, "-ERR the key is not UTF-8\r\n")
        }
    } else if isWord(name, "set") && parts == 3 {
        match string.fromUtf8(bytes[starts[1]..ends[1]]) {
            Ok(key) => {
                lock store.shards[shardOf(key)] as shard {
                    var value = shard.map.getOrAdd(key, List<byte>())
                    value.clear()
                    value.addAll(bytes[starts[2]..ends[2]])
                }
                putText(ref out, "+OK\r\n")
            }
            Error(_) => putText(ref out, "-ERR the key is not UTF-8\r\n")
        }
    } else if isWord(name, "del") && parts >= 2 {
        long gone = 0
        for i in 1..parts {
            if string.fromUtf8(bytes[starts[i]..ends[i]]) is Ok(key) {
                lock store.shards[shardOf(key)] as shard {
                    if shard.map.remove(key) is not null {
                        gone += 1
                    }
                }
            }
        }
        putNumber(ref out, ':', gone)
    } else {
        putText(ref out, "-ERR unknown command or wrong number of arguments\r\n")
    }
}

// The answers one round of a connection holds before it sends them.
const nint MostAnswers = 65536

// Answers the whole commands in `bytes` until `MostAnswers` bytes of answers are written; how many
// bytes it used, or -1 when the client broke the protocol.
nint serveAll(read Store store, read byte[] bytes, ref List<nint> starts, ref List<nint> ends, ref List<byte> out) {
    nint used = 0
    while used < bytes.length() && out.length() < MostAnswers {
        if bytes[used] != '*' {
            return -1
        }
        long parts = 0
        nint at = 0
        match readNumber(bytes, used + 1) {
            Whole(value, next) => {
                if value < 1 || value > 1024 {
                    return -1
                }
                parts = value
                at = next
            }
            Incomplete => return used
            Wrong => return -1
        }
        starts.clear()
        ends.clear()
        for _ in 0..parts {
            if at >= bytes.length() {
                return used
            }
            if bytes[at] != '$' {
                return -1
            }
            match readNumber(bytes, at + 1) {
                Whole(n, next) => {
                    if n < 0 || n > 1048576 {
                        return -1
                    }
                    if bytes.length() - next < n + 2 {
                        return used
                    }
                    var end = next + (nint)n
                    if bytes[end] != '\r' || bytes[end + 1] != '\n' {
                        return -1
                    }
                    starts.add(next)
                    ends.add(end)
                    at = end + 2
                }
                Incomplete => return used
                Wrong => return -1
            }
        }
        run(store, bytes, starts, ends, ref out)
        used = at
    }
    return used
}

// ---- a connection

async Result<void, IoError> serve(TcpStream conn, shared Store store, int idleLimit) {
    var reader = conn.reader(4194304)
    var out = List<byte>()
    var starts = List<nint>()
    var ends = List<nint>()
    // The time a connection may go without a whole request, or with its answers not taken in: set
    // again each time a whole request has been answered, so it closes a client that stays silent,
    // one that sends a byte now and then and never a whole request, and one that does not read.
    // Without a limit there is no source and no token, and a connection costs nothing more.
    CancellationSource? idle = null
    var token = CancellationToken.None
    if idleLimit > 0 {
        var made = CancellationSource()
        token = made.token()
        made.cancelAfter(idleLimit)
        idle = made
    }
    while true {
        if !try await reader.fillAsync(read token) {
            return Ok()
        }
        while true {
            out.clear()
            var used = serveAll(read store, reader.buffered(), ref starts, ref ends, ref out)
            if used < 0 {
                putText(ref out, "-ERR Protocol error\r\n")
                try await conn.sendAsync(read out, read token)
                return Ok()
            }
            reader.consume(used)
            if out.length() > 0 {
                try await conn.sendAsync(read out, read token)
            }
            if idle is not null && used > 0 {
                idle.cancelAfter(idleLimit)
            }
            if out.length() < MostAnswers {
                break
            }
        }
    }
}

// A connection that fails, or is too slow, ends alone.
async void connection(TcpStream conn, shared Store store, int idleLimit) {
    _ = await serve(conn, store, idleLimit)
}

// Waits for SIGTERM or Ctrl-C and cancels `stop`; the listener goes with it, so a second ends the
// program.
async void watch(SignalListener signals, CancellationSource stop) {
    if await signals.nextAsync() is Ok(_) {
        stop.cancel()
    }
}

// Takes connections until a signal comes with `grace` given, for ever without; one the listener
// fails to take (too many open files, say) is tried again after 10 ms.
async Result<void, IoError> listen(int port, int idleLimit, int grace) {
    var shards = List<shared locked Shard>()
    for _ in 0..64 {
        shards.add(new shared locked Shard { map = HashMap<string, List<byte>>() })
    }
    var store = new shared Store { shards = shards }
    var address = $":{port}".toString()
    var listener = try TcpListener.bind(read address)
    var connections = TaskGroup()
    var accepting = CancellationToken.None
    if grace > 0 {
        var stop = CancellationSource()
        accepting = stop.token()
        connections.add(watch(Signals.listen(read List<Signal> { Signal.Interrupt, Signal.Terminate }), stop))
    }
    while true {
        match await listener.acceptAsync(read accepting) {
            Ok(conn) => connections.add(connection(conn, share store, idleLimit))
            Error(Cancelled(_)) => break
            Error(_) => await Task.delay(10)
        }
    }
    var late = CancellationSource.after(grace)
    _ = await connections.whenAll(read late.token())
    return Ok()
}

const string Usage = "usage: resp PORT [--idle-limit MS] [--grace MS]"

void main(List<string> args) {
    if args.length() % 2 != 1 || int.parse(args[0]) is not Ok(port) {
        printError(Usage)
        exit(2)
    }
    int idleLimit = 0
    int grace = 0
    for i in 0..args.length() / 2 {
        var name = args[1 + 2 * i]
        if int.parse(args[2 + 2 * i]) is not Ok(ms) || ms <= 0 {
            printError(Usage)
            exit(2)
        }
        if name == "--idle-limit" {
            idleLimit = ms
        } else if name == "--grace" {
            grace = ms
        } else {
            printError(Usage)
            exit(2)
        }
    }
    if listen(port, idleLimit, grace).wait() is Error(e) {
        printError($"resp: {e}".toString())
        exit(1)
    }
}
