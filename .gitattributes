# Text is checked out with `\n` at the end of each line on every system, Windows too: the expected
# outputs of the tests are compared byte for byte.
* text=auto eol=lf
# The input files of the tests are kept byte for byte: some lines end in \r\n on purpose.
*.in -text
# The cases of JSONTestSuite are kept byte for byte: some hold \r, a byte order mark or bytes that are not UTF-8.
interpreter/tests/json-suite/test_parsing/** -text
# RE2's search tests are kept byte for byte: two texts hold a raw control byte.
interpreter/tests/regex-suite/re2-search.txt -text
# The archives of the zip suite are kept byte for byte.
interpreter/tests/zip-suite/go/** -text
interpreter/tests/zip-suite/made/** -text
interpreter/tests/zip-suite/others/** -text
# Unicode's normalization tests are kept byte for byte, as their SHA-256 says.
interpreter/tests/normalization-suite/NormalizationTest.txt -text
