{
  "name": "sg-lang-site",
  "private": true,
  "description": "The web site of the SG language, sg-lang.org: plain pages made from Markdown, with no framework.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "build": "node ../scripts/sync-docs.mjs && node build.mjs",
    "check": "node check.mjs",
    "serve": "python3 -m http.server 8044 --bind 127.0.0.1 --directory build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "marked": "18.3.0"
  }
}
